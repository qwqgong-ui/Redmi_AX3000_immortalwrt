From: Redmi AX3000 NSS integration
Subject: [PATCH] clients: bound wireless qdisc teardown lifetimes

Drain control/stats callbacks and timers before freeing a qdisc; release
Linux children even when firmware teardown fails. Reset ingress before the
wireless VAP registration disappears.

--- a/nss_qdisc/nss_qdisc.c
+++ b/nss_qdisc/nss_qdisc.c
@@ -29,6 +29,29 @@
 
 void *nss_qdisc_ctx;			/* Shaping context for nss_qdisc */
 
+/* Cancel/drain every callback before its qdisc context can be freed. A callback
+ * already executing may enqueue the next cleanup step, so first close that
+ * client submission gate, drain, then retire any token published during drain.
+ */
+nss_tx_status_t nss_qdisc_command_tx(struct nss_qdisc *nq, struct nss_if_msg *msg)
+{
+	if (READ_ONCE(nq->command_stopping))
+		return NSS_TX_FAILURE_NOT_READY;
+	return nss_if_tx_msg_tracked(nq->nss_shaping_ctx, msg, &nq->command_cookie);
+}
+
+static void nss_qdisc_command_cancel(struct nss_qdisc *nq)
+{
+	uint32_t cookie;
+
+	WRITE_ONCE(nq->command_stopping, true);
+	do {
+		cookie = xchg(&nq->command_cookie, 0);
+		nss_if_cancel_msg(cookie);
+	} while (READ_ONCE(nq->command_cookie));
+	WRITE_ONCE(nq->command_stopping, false);
+}
