+static ssize_t ath11k_debugfs_reo_queue_targets(struct file *file,
+					      char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_peer *peer;
+	struct ath11k *ar;
+	struct dp_rx_tid *tid;
+	char *buf;
+	const size_t size = 8192;
+	unsigned int i, radio;
+	int len = 0;
+	ssize_t ret;
+	bool truncated = false;
+
+	buf = kzalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	len += scnprintf(buf, size,
+		"vdev_id tid mac peer_id queue_generation paddr requested_window\n");
+	spin_lock_bh(&ab->base_lock);
+	for (radio = 0; radio < ab->num_radios; radio++) {
+		ar = ab->pdevs[radio].ar;
+		if (!ar)
+			continue;
+		list_for_each_entry(peer, &ar->peers, list) {
+		if (!peer->dp_setup_done)
+			continue;
+		for (i = 0; i <= IEEE80211_NUM_TIDS; i++) {
+			tid = &peer->rx_tid[i];
+			if (!tid->active || !tid->reo_queue ||
+			    READ_ONCE(tid->reo_queue->retiring) ||
+			    READ_ONCE(tid->reo_queue->phase) != ATH11K_REO_QUEUE_PUBLISHED)
+				continue;
+			if (size - len < 160) {
+				truncated = true;
+				goto unlock;
+			}
+			len += scnprintf(buf + len, size - len,
+				"%d %u %pM %d %llu 0x%llx %u\n",
+				peer->vdev_id, i, peer->addr, peer->peer_id,
+				tid->reo_queue->generation, (u64)tid->reo_queue->paddr,
+				tid->ba_win_sz);
+		}
+		}
+	}
+unlock:
+	spin_unlock_bh(&ab->base_lock);
+	len += scnprintf(buf + len, size - len, "truncated: %u\n", truncated);
+	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+	return ret;
+}
+
+static const struct file_operations fops_reo_queue_targets = {
+	.read = ath11k_debugfs_reo_queue_targets,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
+static ssize_t ath11k_debugfs_reo_queue_query_write(struct file *file,
+						  const char __user *user_buf,
+						  size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_reo_query_result result;
+	u32 vdev, tid;
+	u8 mac[ETH_ALEN];
+	char buf[96], vdev_text[12], tid_text[12], mac_text[18], trailing;
+	int ret;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (sscanf(buf, "%11s %11s %17s %c", vdev_text, tid_text, mac_text, &trailing) != 3 ||
+	    kstrtou32(vdev_text, 10, &vdev) || kstrtou32(tid_text, 10, &tid) ||
+	    vdev > U16_MAX || tid > IEEE80211_NUM_TIDS || !mac_pton(mac_text, mac))
+		return -EINVAL;
+	mutex_lock(&ab->dp.reo_query_mutex);
+	ret = ath11k_dp_reo_queue_query(ab, vdev, mac, tid, &result);
+	ab->dp.reo_query_result = result;
+	mutex_unlock(&ab->dp.reo_query_mutex);
+	return ret ? ret : count;
+}
+
+static ssize_t ath11k_debugfs_reo_queue_query_read(struct file *file,
+						 char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_reo_query_result result;
+	struct hal_reo_status_queue_stats *stats = &result.status.u.queue_stats;
+	const size_t size = 4096;
+	char *buf;
+	int len = 0;
+	ssize_t ret;
+
+	buf = kzalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	mutex_lock(&ab->dp.reo_query_mutex);
+	result = ab->dp.reo_query_result;
+	mutex_unlock(&ab->dp.reo_query_mutex);
+	len += scnprintf(buf + len, size - len,
+		"error: %d\nheader_valid: %u\npayload_valid: %u\ncurrent_instance_at_query_return: %u\n"
+		"vdev_id: %u\npeer_id_at_submit: %u\nmac: %pM\ntid: %u\n"
+		"queue_generation: %llu\nsubmit_epoch: %llu\npaddr: 0x%llx\n"
+		"software_requested_window: %u\ncmd_num: %u\nhw_status: %u\n"
+		"hw_exec_time_us: %u\nhw_timestamp_raw: %u\ntlv_payload_bytes: %u\n",
+		result.error, result.header_valid, result.payload_valid, result.current_instance,
+		result.vdev_id, result.peer_id, result.mac, result.tid,
+		result.queue_generation, result.submit_epoch, result.paddr,
+		result.requested_window, result.status.uniform_hdr.cmd_num,
+		result.status.uniform_hdr.cmd_status, result.status.uniform_hdr.cmd_exe_time,
+		result.status.uniform_hdr.timestamp, result.status.tlv_payload_len);
+	if (result.payload_valid) {
+		len += scnprintf(buf + len, size - len,
+			"ssn_12bit: %u\ncurrent_index_8bit: %u\n"
+			"pn_words_raw: %08x %08x %08x %08x\n"
+			"last_enqueue_timestamp_raw: %u\nlast_dequeue_timestamp_raw: %u\n"
+			"bitmap_words_raw: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			stats->ssn, stats->curr_idx, stats->pn[0], stats->pn[1],
+			stats->pn[2], stats->pn[3], stats->last_rx_queue_ts,
+			stats->last_rx_dequeue_ts, stats->rx_bitmap[0], stats->rx_bitmap[1],
+			stats->rx_bitmap[2], stats->rx_bitmap[3], stats->rx_bitmap[4],
+			stats->rx_bitmap[5], stats->rx_bitmap[6], stats->rx_bitmap[7]);
+		len += scnprintf(buf + len, size - len,
+			"current_mpdu_7bit: %u\ncurrent_msdu_25bit: %u\n"
+			"fwd_timeout_events_6bit: %u\nfwd_bar_events_6bit: %u\nduplicate_16bit: %u\n"
+			"in_order_24bit: %u\nbar_received_8bit: %u\nprocessed_mpdu_32bit: %u\n"
+			"processed_msdu_32bit: %u\nprocessed_bytes_approx_32bit: %u\n"
+			"late_12bit: %u\njump_2k_4bit: %u\nhole_events_16bit: %u\n"
+			"status_ring_loop_4bit: %u\n",
+			stats->curr_mpdu_cnt, stats->curr_msdu_cnt, stats->timeout_cnt,
+			stats->fwd_due_to_bar_cnt, stats->dup_cnt, stats->frames_in_order_cnt,
+			stats->bar_rx_cnt, stats->num_mpdu_processed_cnt,
+			stats->num_msdu_processed_cnt, stats->total_num_processed_byte_cnt,
+			stats->late_rx_mpdu_cnt, stats->num_window_2k_jump_cnt,
+			stats->reorder_hole_cnt, result.status.loop_cnt);
+	}
+	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+	return ret;
+}
+
+static const struct file_operations fops_reo_queue_query = {
+	.write = ath11k_debugfs_reo_queue_query_write,
+	.read = ath11k_debugfs_reo_queue_query_read,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
