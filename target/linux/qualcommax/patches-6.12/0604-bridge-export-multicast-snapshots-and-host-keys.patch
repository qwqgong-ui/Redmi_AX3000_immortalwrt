+int br_mcast_offload_set_mcu(struct net_device *dev, int bridge_ifindex,
+			   u64 seq, bool enabled)
+{
+	struct net_bridge_port *p;
+	struct net_bridge *br;
+	int ret = -ENODEV;
+
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (!p)
+		goto out;
+	br = p->br;
+	spin_lock_bh(&br->multicast_lock);
+	if (!enabled) {
+		WRITE_ONCE(p->mcast_hw_to_unicast, false);
+		ret = 0;
+	} else if (br->dev->ifindex != bridge_ifindex ||
+		   atomic64_read(&br->mcast_offload_seq) != seq) {
+		ret = -ESTALE;
+	} else if (!br_opt_get(br, BROPT_MULTICAST_ENABLED) ||
+		   p->state != BR_STATE_FORWARDING ||
+		   !(p->flags & BR_MULTICAST_TO_UNICAST)) {
+		ret = -EOPNOTSUPP;
+	} else {
+		WRITE_ONCE(p->mcast_hw_to_unicast, true);
+		ret = 0;
+	}
+	spin_unlock_bh(&br->multicast_lock);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_set_mcu);
