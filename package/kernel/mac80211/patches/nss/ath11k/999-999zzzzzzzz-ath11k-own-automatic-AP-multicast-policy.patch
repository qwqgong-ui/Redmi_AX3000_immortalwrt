+/* mac80211's Ethernet TX entry has data at the Ethernet header. Extensions
+ * survive NAT/TC rewriting, so ownership alone is not packet identity.
+ */
+static bool ath11k_nss_me_packet_same(const struct sk_buff *skb,
+				     const struct br_mcast_packet *packet)
+{
+	struct ethhdr eth;
+	struct iphdr ip4;
+	struct ipv6hdr ip6;
+
+	if (skb_copy_bits(skb, 0, &eth, sizeof(eth)) ||
+	    eth.h_proto != packet->proto ||
+	    !ether_addr_equal(eth.h_dest, packet->group_da) ||
+	    !ether_addr_equal(eth.h_source, packet->source_mac))
+		return false;
+	if (eth.h_proto == htons(ETH_P_IP)) {
+		if (skb_copy_bits(skb, ETH_HLEN, &ip4, sizeof(ip4)) ||
+		    ip4.version != 4 || ip4.ihl < 5)
+			return false;
+		return !memcmp(packet->source_ip, &ip4.saddr, 4) &&
+		       !memcmp(packet->group_ip, &ip4.daddr, 4);
+	}
+	if (eth.h_proto == htons(ETH_P_IPV6)) {
+		if (skb_copy_bits(skb, ETH_HLEN, &ip6, sizeof(ip6)) || ip6.version != 6)
+			return false;
+		return !memcmp(packet->source_ip, &ip6.saddr, 16) &&
+		       !memcmp(packet->group_ip, &ip6.daddr, 16);
+	}
+	return true;
+}
+
+static bool ath11k_nss_me_member_accept(const struct ath11k_nss_me_member *member,
+				      const struct br_mcast_packet *packet)
+{
+	u32 i, len = packet->proto == htons(ETH_P_IP) ? 4 : 16;
+	bool listed = false;
+
+	if (member->group.proto != packet->proto ||
+	    memcmp(&member->group.dst, packet->group_ip, len))
+		return false;
+	for (i = 0; i < member->source_count; i++)
+		listed |= !memcmp(member->source[i], packet->source_ip, len);
+	return member->mode == 1 ? listed : member->mode == 2 && !listed;
+}
+
+/* Compare both directions. Hardware must not add a recipient, omit one, or
+ * apply its source-MAC suppression to a native recipient.
+ */
+static bool ath11k_nss_me_targets_same(const struct ath11k_nss_me_policy *policy,
+				      const struct br_mcast_packet *packet)
+{
+	u32 i, j, selected = 0;
+
+	if (packet->action != BR_MCAST_PACKET_HOSTS ||
+	    packet->mcu_cookie != policy->cookie || packet->seq != policy->snapshot.seq ||
+	    (packet->proto != htons(ETH_P_IP) && packet->proto != htons(ETH_P_IPV6)))
+		return false;
+	for (i = 0; i < policy->count; i++) {
+		if (!ath11k_nss_me_member_accept(&policy->members[i], packet))
+			continue;
+		if (ether_addr_equal(policy->members[i].mac, packet->source_mac))
+			return false;
+		for (j = 0; j < packet->count; j++)
+			if (ether_addr_equal(policy->members[i].mac, packet->mac[j]))
+				break;
+		if (j == packet->count)
+			return false;
+		selected++;
+	}
+	if (selected != packet->count)
+		return false;
+	for (i = 0; i < packet->count; i++) {
+		for (j = 0; j < policy->count; j++)
+			if (ath11k_nss_me_member_accept(&policy->members[j], packet) &&
+			    ether_addr_equal(policy->members[j].mac, packet->mac[i]))
+				break;
+		if (j == policy->count)
+			return false;
+	}
+	return true;
+}
