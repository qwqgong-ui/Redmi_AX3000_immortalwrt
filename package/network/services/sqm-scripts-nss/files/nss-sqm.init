#!/bin/sh /etc/rc.common
START=51
STOP=49
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/lib/sqm/nss-sqm-watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sqm wireless
}
