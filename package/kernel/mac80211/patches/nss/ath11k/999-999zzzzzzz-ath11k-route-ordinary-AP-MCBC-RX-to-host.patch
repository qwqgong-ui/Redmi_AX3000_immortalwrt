+/* Ordinary AP multicast RX must reach the bridge before firmware AP_BRIDGE
+ * forwarding. This production command is independent of debugfs/test mode;
+ * it does not enable ME or change unicast AP_BRIDGE forwarding.
+ */
+int ath11k_nss_me_host_rx(struct ath11k_vif *arvif)
+{
+	struct ath11k_nss_me_state *me = &arvif->nss.me;
+	struct ath11k_base *ab = arvif->ar->ab;
+	struct nss_wifi_vdev_msg *msg;
+	int ret;
+
+	lockdep_assert_held(&arvif->ar->conf_mutex);
+	if (arvif->vif->type != NL80211_IFTYPE_AP)
+		return 0;
+	if (arvif->nss.encap != HAL_TCL_ENCAP_TYPE_ETHERNET ||
+	    arvif->nss.decap != ATH11K_HW_TXRX_ETHERNET)
+		return 0;
+	spin_lock_bh(&ab->base_lock);
+	ret = ath11k_nss_me_admit(arvif);
+	spin_unlock_bh(&ab->base_lock);
+	if (ret)
+		return ret;
+	if (me->rx_mcbc_known && me->rx_mcbc == 1)
+		return 0;
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+	msg->msg.vdev_cmd.cmd = NSS_WIFI_VDEV_CFG_MCBC_EXC_TO_HOST_CMD;
+	msg->msg.vdev_cmd.value = 1;
+	me->rx_mcbc_known = false;
+	ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_INTERFACE_CMD_MSG,
+				    sizeof(msg->msg.vdev_cmd), NULL, NULL);
+	if (!ret) {
+		me->rx_mcbc = 1;
+		me->rx_mcbc_known = true;
+	}
+	kfree(msg);
+	return ret;
+}
