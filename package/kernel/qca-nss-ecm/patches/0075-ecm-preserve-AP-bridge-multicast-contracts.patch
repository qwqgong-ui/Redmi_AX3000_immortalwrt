--- /dev/null
+++ b/frontends/cmn/ecm_bridge_mcast_contract.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef ECM_BRIDGE_MCAST_CONTRACT_H
+#define ECM_BRIDGE_MCAST_CONTRACT_H
+
+#include <linux/skbuff.h>
+#include <linux/netdevice.h>
+#include <net/cfg80211.h>
+
+/* Only the NSS/Linux-snooper profile has the matching AP output-fanout
+ * exclusion. Preserve native M2U and collapsed HOSTS packets identically:
+ * neither may create a per-copy ECM flow or acquire classifier side effects.
+ * A lost/stale extension also stays untouched for ath11k's fail-closed check.
+ * This hook owns no packet/peer references and never clears the contract.
+ */
+#if defined(ECM_FRONT_END_NSS_ENABLE) && \
+    defined(ECM_MCAST_LINUX_SNOOPER_SUPPORT) && \
+    IS_ENABLED(CONFIG_BRIDGE_IGMP_SNOOPING) && \
+    IS_ENABLED(CONFIG_CFG80211_HEADERS)
+#define ECM_BRIDGE_AP_MCAST_CONTRACT 1
+static inline bool ecm_bridge_mcast_contract(const struct net_device *out,
+					    const struct sk_buff *skb)
+{
+	const struct wireless_dev *wdev = out ? out->ieee80211_ptr : NULL;
+
+	return wdev && skb->br_mcast_contract &&
+		(wdev->iftype == NL80211_IFTYPE_AP ||
+		 wdev->iftype == NL80211_IFTYPE_AP_VLAN);
+}
+#else
+static inline bool ecm_bridge_mcast_contract(const struct net_device *out,
+					    const struct sk_buff *skb)
+{
+	return false;
+}
+#endif
+
+#endif
