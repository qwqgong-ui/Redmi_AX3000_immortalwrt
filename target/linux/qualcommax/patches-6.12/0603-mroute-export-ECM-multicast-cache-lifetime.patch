+static void ip6mr_offload_mfc_notify(struct net *net, u32 table,
+				   struct mfc6_cache *c, enum fib_event_type event)
+{
+	ip6mr_mfc_event_offload_callback_t cb;
+	struct mr_table *mrt;
+	u32 indices[MAXMIFS];
+	struct in6_addr group = c->mf6c_mcastgrp, origin = c->mf6c_origin;
+	int count = -ENOENT;
+
+	if (!net_eq(net, &init_net) || table != RT6_TABLE_DFLT)
+		return;
+	rcu_read_lock();
+	cb = rcu_dereference(ip6mr_offload_cb);
+	if (!cb)
+		goto out;
+	if (event != FIB_EVENT_ENTRY_DEL) {
+		spin_lock_bh(&mrt_lock);
+		mrt = __ip6mr_get_table(net, table);
+		if (mrt) {
+			c = ip6mr_offload_cache_find(mrt, &origin, &group);
+			if (!IS_ERR(c))
+				count = ip6mr_offload_ifindexes(mrt, c, indices, NULL);
+		}
+		spin_unlock_bh(&mrt_lock);
+	}
+	if (event == FIB_EVENT_ENTRY_REPLACE || count <= 0)
+		cb(&group, &origin, 0, NULL, IP6MR_MFC_EVENT_DELETE);
+	if (count > 0)
+		cb(&group, &origin, count, indices, IP6MR_MFC_EVENT_UPDATE);
+out:
+	rcu_read_unlock();
+}
