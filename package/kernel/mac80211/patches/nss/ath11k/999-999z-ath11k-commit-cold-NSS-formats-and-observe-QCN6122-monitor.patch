+static void ath11k_nss_vdev_format_cb(void *app_data, struct nss_cmn_msg *cm)
+{
+	struct ath11k_nss_vdev_format_request *format = app_data;
+	struct ath11k_nss_vdev_request *request;
+	struct nss_wifi_vdev_msg *msg;
+
+	if (!format)
+		return;
+	request = &format->request;
+	if (cm->type != request->type || cm->interface != request->if_num ||
+	    cm->response == NSS_CMN_RESPONSE_NOTIFY)
+		return;
+
+	request->result = -EIO;
+	if (cm->response == NSS_CMN_RESPONSE_ACK && !cm->error) {
+		/* cm.len is payload-only; nss_cmn_get_msg_len() adds the header. */
+		if (cm->len != sizeof(msg->msg.vdev_cmd)) {
+			request->result = -EMSGSIZE;
+		} else {
+			msg = container_of(cm, struct nss_wifi_vdev_msg, cm);
+			request->result = msg->msg.vdev_cmd.cmd == format->command &&
+				msg->msg.vdev_cmd.value == format->value ? 0 : -EPROTO;
+		}
+	}
+	request->response = cm->response;
+	request->error = cm->error;
+	request->len = cm->len;
+	complete(&request->complete);
+}
