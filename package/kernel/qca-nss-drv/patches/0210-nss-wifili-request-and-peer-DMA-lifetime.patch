Subject: [PATCH] nss-drv: bind WIFILI responses to registered requests

Use driver-owned callback dispatch and non-reused request IDs. Serialize
registration-to-enqueue with interface shutdown. Revoke pending requests and
drain callbacks on unregistration; give synchronous waits private state.
Retain unresolved peer lookup DMA until core halt and IRQ/NAPI cleanup and
refuse interface reuse while quarantined. Hardware ring DMA is not covered.

--- a/nss_wifili.c
+++ b/nss_wifili.c
@@ -19,6 +19,227 @@
 #include "nss_wifili_log.h"
 #include "nss_wifili_strings.h"
 
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+
+struct nss_wifili_peer_memory {
+	struct list_head list;
+	struct device *dev;
+	void *vaddr;
+	dma_addr_t paddr;
+	uint32_t size;
+	uint32_t core_id;
+	uint32_t if_num;
+	bool quarantined;
+};
+
+static LIST_HEAD(nss_wifili_peer_quarantine);
+static DEFINE_SPINLOCK(nss_wifili_peer_memory_lock);
+static unsigned long nss_wifili_blocked_interfaces[NSS_MAX_NET_INTERFACES];
+static bool nss_wifili_registered_interfaces[NSS_MAX_NET_INTERFACES];
+
+struct nss_wifili_request {
+	struct list_head list;
+	uint32_t cookie;
+	uint32_t if_num;
+	uint32_t type;
+	nss_ptr_t callback;
+	nss_ptr_t app_data;
+};
+static LIST_HEAD(nss_wifili_requests);
+static atomic64_t nss_wifili_request_sequence = ATOMIC64_INIT(0);
+
+static void nss_wifili_request_receive(void *ctx, struct nss_wifili_msg *msg)
+{
+	struct nss_wifili_request *request, *found = NULL;
+	nss_wifili_msg_callback_t callback;
+	uint64_t cookie = msg->cm.app_data;
+
+	if (!cookie || cookie > U32_MAX || msg->cm.response == NSS_CMN_RESPONSE_NOTIFY)
+		return;
+	rcu_read_lock_bh();
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	list_for_each_entry(request, &nss_wifili_requests, list) {
+		if (request->cookie != cookie)
+			continue;
+		if (request->if_num != msg->cm.interface || request->type != msg->cm.type ||
+		    !nss_wifili_registered_interfaces[request->if_num])
+			break;
+		found = request;
+		list_del(&request->list);
+		break;
+	}
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+	if (found) {
+		callback = (nss_wifili_msg_callback_t)(uintptr_t)found->callback;
+		msg->cm.cb = found->callback;
+		msg->cm.app_data = found->app_data;
+		if (callback)
+			callback(ctx, msg);
+		kfree(found);
+	}
+	rcu_read_unlock_bh();
+}
+
+void nss_wifili_forget_msg(uint32_t cookie)
+{
+	struct nss_wifili_request *request, *next;
+
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	list_for_each_entry_safe(request, next, &nss_wifili_requests, list) {
+		if (request->cookie != cookie)
+			continue;
+		list_del(&request->list);
+		kfree(request);
+		break;
+	}
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+}
+EXPORT_SYMBOL(nss_wifili_forget_msg);
+
+void nss_wifili_cancel_msg(uint32_t cookie)
+{
+	nss_wifili_forget_msg(cookie);
+	/* Also wait when the callback has already consumed its registry entry. */
+	synchronize_net();
+}
+EXPORT_SYMBOL(nss_wifili_cancel_msg);
+
+static void nss_wifili_requests_unregister(uint32_t if_num)
+{
+	struct nss_wifili_request *request, *next;
+
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	nss_wifili_registered_interfaces[if_num] = false;
+	list_for_each_entry_safe(request, next, &nss_wifili_requests, list) {
+		if (request->if_num != if_num)
+			continue;
+		list_del(&request->list);
+		kfree(request);
+	}
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+}
+
+void nss_wifili_interface_quarantine(struct nss_ctx_instance *ctx, uint32_t if_num)
+{
+	if (!ctx || if_num >= NSS_MAX_NET_INTERFACES || ctx->id >= BITS_PER_LONG)
+		return;
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	__set_bit(ctx->id, &nss_wifili_blocked_interfaces[if_num]);
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+}
+EXPORT_SYMBOL(nss_wifili_interface_quarantine);
+
+struct nss_wifili_peer_memory *
+nss_wifili_peer_memory_alloc(struct nss_ctx_instance *ctx, uint32_t if_num,
+			    struct device *dev, uint32_t size)
+{
+	struct nss_wifili_peer_memory *memory;
+
+	if (!ctx || !dev || !size || if_num >= NSS_MAX_NET_INTERFACES ||
+	    ctx->id >= BITS_PER_LONG)
+		return ERR_PTR(-EINVAL);
+	if (READ_ONCE(nss_wifili_blocked_interfaces[if_num]) & BIT(ctx->id))
+		return ERR_PTR(-EBUSY);
+
+	memory = kzalloc(sizeof(*memory), GFP_ATOMIC);
+	if (!memory)
+		return ERR_PTR(-ENOMEM);
+	memory->dev = get_device(dev);
+	memory->vaddr = kzalloc(size, GFP_ATOMIC);
+	if (!memory->vaddr)
+		goto free_memory;
+	memory->paddr = dma_map_single(dev, memory->vaddr, size, DMA_TO_DEVICE);
+	if (dma_mapping_error(dev, memory->paddr))
+		goto free_buffer;
+	/* WIFILI PEER_CREATE carries a 32-bit NSS peer-memory address. */
+	if (upper_32_bits(memory->paddr)) {
+		dma_unmap_single(dev, memory->paddr, size, DMA_TO_DEVICE);
+		kfree(memory->vaddr);
+		put_device(memory->dev);
+		kfree(memory);
+		return ERR_PTR(-ERANGE);
+	}
+	memory->size = size;
+	memory->core_id = ctx->id;
+	memory->if_num = if_num;
+	INIT_LIST_HEAD(&memory->list);
+	return memory;
+
+free_buffer:
+	kfree(memory->vaddr);
+free_memory:
+	put_device(memory->dev);
+	kfree(memory);
+	return ERR_PTR(-ENOMEM);
+}
+EXPORT_SYMBOL(nss_wifili_peer_memory_alloc);
+
+void *nss_wifili_peer_memory_address(struct nss_wifili_peer_memory *memory)
+{
+	return memory->vaddr;
+}
+EXPORT_SYMBOL(nss_wifili_peer_memory_address);
+
+uint64_t nss_wifili_peer_memory_dma(struct nss_wifili_peer_memory *memory)
+{
+	return memory->paddr;
+}
+EXPORT_SYMBOL(nss_wifili_peer_memory_dma);
+
+void nss_wifili_peer_memory_free(struct nss_wifili_peer_memory *memory)
+{
+	if (!memory)
+		return;
+	if (WARN_ON_ONCE(memory->quarantined))
+		return;
+	dma_unmap_single(memory->dev, memory->paddr, memory->size, DMA_TO_DEVICE);
+	kfree(memory->vaddr);
+	put_device(memory->dev);
+	kfree(memory);
+}
+EXPORT_SYMBOL(nss_wifili_peer_memory_free);
+
+void nss_wifili_peer_memory_quarantine(struct nss_wifili_peer_memory *memory)
+{
+	if (!memory)
+		return;
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	if (!memory->quarantined) {
+		memory->quarantined = true;
+		__set_bit(memory->core_id,
+			  &nss_wifili_blocked_interfaces[memory->if_num]);
+		list_add_tail(&memory->list, &nss_wifili_peer_quarantine);
+	}
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+}
+EXPORT_SYMBOL(nss_wifili_peer_memory_quarantine);
+
+void nss_wifili_peer_memory_reclaim(struct nss_ctx_instance *ctx)
+{
+	struct nss_wifili_peer_memory *memory, *next;
+	LIST_HEAD(reclaim);
+	unsigned int if_num;
+
+	/* Called by HAL only after this core has halted and its IRQ/NAPI drained.
+	 * Peer lookup memory is consumed by the NSS CPU, not autonomous WLAN DMA.
+	 */
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	list_for_each_entry_safe(memory, next, &nss_wifili_peer_quarantine, list) {
+		if (memory->core_id != ctx->id)
+			continue;
+		memory->quarantined = false;
+		list_move_tail(&memory->list, &reclaim);
+	}
+	for (if_num = 0; if_num < NSS_MAX_NET_INTERFACES; if_num++)
+		__clear_bit(ctx->id, &nss_wifili_blocked_interfaces[if_num]);
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+	list_for_each_entry_safe(memory, next, &reclaim, list) {
+		list_del(&memory->list);
+		nss_wifili_peer_memory_free(memory);
+	}
+}
+
 #define NSS_WIFILI_TX_TIMEOUT 1000 /* Millisecond to jiffies*/
 #define NSS_WIFILI_INVALID_SCHEME_ID  -1
 #define NSS_WIFILI_THREAD_SCHEME_ENTRY_MAX  4 /* Maximum number of thread scheme entries. */
