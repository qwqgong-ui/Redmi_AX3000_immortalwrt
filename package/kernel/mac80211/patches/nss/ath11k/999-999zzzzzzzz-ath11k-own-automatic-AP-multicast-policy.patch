+/* This shape excludes firmware's segmentation, virtual-buffer and odd-data
+ * replacement paths before ME. Active extensions also prohibit NSS reuse.
+ * This is a table-reader barrier, not an over-the-air completion barrier.
+ */
+static bool ath11k_nss_me_raw_shape(struct ath11k_vif *arvif,
+				  const struct sk_buff *skb)
+{
+	struct iphdr ip4;
+	struct ipv6hdr ip6;
+	struct ethhdr eth;
+
+	if (arvif->ar->ab->nss.debug_mode || ieee80211_vif_to_wdev(arvif->vif)->use_4addr ||
+	    arvif->nss.encap != HAL_TCL_ENCAP_TYPE_ETHERNET ||
+	    arvif->nss.decap != ATH11K_HW_TXRX_ETHERNET ||
+	    skb_is_nonlinear(skb) || skb_is_gso(skb) || skb_vlan_tag_present(skb) ||
+	    skb->ip_summed != CHECKSUM_NONE || ((unsigned long)skb->data & 1) ||
+	    skb->len > ETH_HLEN + 1500 || skb_copy_bits(skb, 0, &eth, sizeof(eth)))
+		return false;
+	if (eth.h_proto == htons(ETH_P_IP))
+		return !skb_copy_bits(skb, ETH_HLEN, &ip4, sizeof(ip4)) &&
+		       ip4.version == 4 && ip4.ihl == 5 &&
+		       !(ntohs(ip4.frag_off) & (IP_MF | IP_OFFSET)) &&
+		       skb->len >= ETH_HLEN + ntohs(ip4.tot_len);
+	/* Exclude extension/fragment preprocessing in the firmware's RX parser. */
+	if (eth.h_proto == htons(ETH_P_IPV6))
+		return !skb_copy_bits(skb, ETH_HLEN, &ip6, sizeof(ip6)) &&
+		       ip6.version == 6 && (ip6.nexthdr == IPPROTO_UDP || ip6.nexthdr == IPPROTO_TCP) &&
+		       skb->len >= ETH_HLEN + sizeof(ip6) + ntohs(ip6.payload_len);
+	return false;
+}
