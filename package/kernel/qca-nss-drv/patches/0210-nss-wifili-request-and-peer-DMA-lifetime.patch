+	(void)app_data;
+	request->result = nvm->cm.response == NSS_CMN_RESPONSE_ACK ?
+		NSS_TX_SUCCESS : NSS_TX_FAILURE;
+	nvm->cm.cb = request->callback;
+	nvm->cm.app_data = request->app_data;
+	if (callback)
+		callback((void *)(uintptr_t)request->app_data, nvm);
+	complete(&request->complete);
 }
 
