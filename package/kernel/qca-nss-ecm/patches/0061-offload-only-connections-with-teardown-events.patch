+	if (!ct || !nf_ct_ecache_find(ct)) {
+		DEBUG_TRACE("Conntrack event cache absent; keep host forwarding\n");
+		return;
+	}
+
 	/*
 	 * Test if acceleration is permitted
 	 */
 	if (!ecm_nss_ipv6_accel_pending_set(feci)) {
