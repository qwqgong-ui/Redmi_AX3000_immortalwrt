#!/bin/sh /etc/rc.common

START=94
STOP=94

start() {
	local enabled wired attempt status
	. /lib/functions.sh
	config_load nss-wifi
	config_get_bool enabled main enabled 1
	config_get_bool wired main wired_enabled 1
	[ "$enabled" = 1 ] && [ "$wired" = 1 ] || return 0
	[ "$(cat /sys/module/qca_nss_drv/parameters/core0_ready 2>/dev/null)" = 1 ] || return 0
	[ "$(cat /sys/module/ath11k/parameters/nss_offload 2>/dev/null)" = 1 ] || return 0
	modprobe qca-dsa-nss || return 1
	for attempt in 1 2 3 4 5; do
		if [ "$(cat /sys/module/qca_dsa_nss/parameters/enabled 2>/dev/null)" = Y ]; then
			if [ "$(cat /sys/module/qca_dsa_nss/parameters/ready 2>/dev/null)" = Y ]; then
				logger -t nss-lan 'QCA DSA physical and VLAN interfaces ready for NSS'
				return 0
			fi
			# An enabled owner reconciles topology changes itself. Wait for it
			# without repeating allocations or disturbing its live resources.
			status="$(cat /sys/kernel/debug/qca-dsa-nss/status 2>/dev/null)"
			case "$status" in
				'enabled=1 '*' allocation_uncertain=0 '*)
					[ "$attempt" -lt 5 ] && { sleep 2; continue; }
					;;
			esac
			break
		fi
		if printf '%s' 1 > /sys/module/qca_dsa_nss/parameters/enabled 2>/dev/null &&
		   [ "$(cat /sys/module/qca_dsa_nss/parameters/ready 2>/dev/null)" = Y ]; then
			logger -t nss-lan 'QCA DSA physical and VLAN interfaces ready for NSS'
			return 0
		fi
		# Link/bridge setup can finish after S94. Retry only a fully released
		# owner; an uncertain allocation or retained resource needs inspection.
		status="$(cat /sys/kernel/debug/qca-dsa-nss/status 2>/dev/null)"
		case "$status" in
			'enabled=0 ready=0 pinned=0 paused=0 provider_held=0 allocation_uncertain=0 '*)
				[ "$attempt" -lt 5 ] && { sleep 2; continue; }
				;;
		esac
		break
	done
	logger -t nss-lan 'Wired offload activation not confirmed; inspect qca-dsa-nss status before retrying'
	return 1
}

stop() {
	[ -w /sys/module/qca_dsa_nss/parameters/enabled ] || return 0
	printf '%s' 0 > /sys/module/qca_dsa_nss/parameters/enabled || {
		logger -t nss-lan 'Wired ownership not released; retaining module until reboot'
		return 1
	}
}
