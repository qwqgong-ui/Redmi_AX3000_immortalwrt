@@ -256,6 +256,14 @@
  * @return
  * None.
  */
+/* Prepare the control handler only. The netdev stays invisible to
+ * ECM/bridge lookup until MAC, MTU and tag configuration is ACKed.
+ */
+struct nss_ctx_instance *nss_vlan_prepare_if(uint32_t if_num, void *app_ctx);
+void nss_vlan_publish_if(uint32_t if_num, nss_vlan_callback_t callback,
+                        struct net_device *dev, uint32_t features, void *app_ctx);
