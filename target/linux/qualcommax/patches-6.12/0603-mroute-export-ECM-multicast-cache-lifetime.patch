+bool ipmr_register_mfc_event_offload_callback(ipmr_mfc_event_offload_callback_t cb)
+{
+	bool registered = false;
+
+	if (!cb)
+		return false;
+	mutex_lock(&ipmr_offload_mutex);
+	if (!rcu_access_pointer(ipmr_offload_cb)) {
+		rcu_assign_pointer(ipmr_offload_cb, cb);
+		registered = true;
+	}
+	mutex_unlock(&ipmr_offload_mutex);
+	return registered;
+}
+EXPORT_SYMBOL(ipmr_register_mfc_event_offload_callback);
+
+void ipmr_unregister_mfc_event_offload_callback(void)
+{
+	mutex_lock(&ipmr_offload_mutex);
+	RCU_INIT_POINTER(ipmr_offload_cb, NULL);
+	synchronize_rcu();
+	mutex_unlock(&ipmr_offload_mutex);
+}
+EXPORT_SYMBOL(ipmr_unregister_mfc_event_offload_callback);
