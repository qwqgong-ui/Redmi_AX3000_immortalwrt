#!/bin/sh

echo 'NSS Wi-Fi bring-up status'
for param in /sys/module/qca_nss_drv/parameters/core0_ready \
	/sys/module/qca_nss_drv/parameters/wifi_only \
	/sys/module/ath11k/parameters/nss_offload \
	/sys/module/ath11k/parameters/frame_mode \
	/proc/sys/dev/nss/rps/enable \
	/proc/sys/dev/nss/rps/hash_bitmap \
	/proc/sys/dev/nss/rps/pri_map; do
	[ -r "$param" ] && printf '%s: %s\n' "$param" "$(cat "$param")"
done
echo 'NSS host RX queue interrupts (check which host CPU handles each queue):'
awk '/CPU0/ || /nss_queue[01]$/ { print }' /proc/interrupts
echo 'Radio interfaces:'
iw dev
echo 'Connection acceleration components (loaded is not proof of offloaded traffic):'
for module in qca_nss_bridge_mgr ecm; do
	if [ -d "/sys/module/$module" ]; then
		printf '%s: loaded\n' "$module"
	else
		printf '%s: not loaded\n' "$module"
	fi
done
for state in /sys/kernel/debug/ecm/front_end_ipv4_stop \
             /sys/kernel/debug/ecm/front_end_ipv6_stop \
             /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count \
             /sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count; do
	[ ! -r "$state" ] || printf '%s: %s\n' "$state" "$(cat "$state")"
done
echo 'NSS wireless counters (compare two samples while transferring traffic):'
for stats in /sys/kernel/debug/qca-nss-drv/stats/wifili*; do
	[ -f "$stats" ] && cat "$stats"
done
echo 'Recent NSS / ath11k logs:'
logread | grep -E 'nss-wifi|qca-nss|NSS|ath11k' | tail -n 80
