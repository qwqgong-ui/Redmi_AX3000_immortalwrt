+static int ath11k_nss_me_fallback(struct ath11k_vif *arvif, struct sk_buff *skb,
+				 const struct br_mcast_packet *packet)
+{
+	struct ath11k_base *ab = arvif->ar->ab;
+	struct ath11k_nss_me_target *targets;
+	struct ath11k_peer *peer;
+	u32 count = 0, capacity = 0, i;
+	int ret;
+
+	spin_lock_bh(&ab->base_lock);
+	ret = ath11k_nss_me_admit(arvif);
+	if (!ret && (!arvif->nss.me_auto.running || !arvif->is_up))
+		ret = -ESHUTDOWN;
+	if (ret)
+		goto unlock;
+	if (packet && packet->action == BR_MCAST_PACKET_HOSTS)
+		capacity = packet->count;
+	else
+		list_for_each_entry(peer, &arvif->ar->peers, list)
+			if (peer->vif == arvif->vif && peer->sta && peer->is_authorized)
+				capacity++;
+	targets = kcalloc(max_t(u32, capacity, 1), sizeof(*targets), GFP_ATOMIC);
+	if (!targets) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	list_for_each_entry(peer, &arvif->ar->peers, list) {
+		struct ath11k_nss_peer_state *state;
+
+		if (peer->vif != arvif->vif || !peer->sta || !peer->is_authorized)
+			continue;
+		if (packet && packet->action == BR_MCAST_PACKET_HOSTS) {
+			for (i = 0; i < packet->count; i++)
+				if (ether_addr_equal(peer->addr, packet->mac[i]))
+					break;
+			if (i == packet->count)
+				continue;
+		}
+		state = ath11k_nss_key_get(arvif->ar, peer);
+		if (IS_ERR_OR_NULL(state))
+			continue;
+		if (WARN_ON_ONCE(count == capacity)) {
+			ath11k_nss_key_put(state);
+			break;
+		}
+		ath11k_peer_get(peer);
+		targets[count].peer = peer;
+		targets[count].state = state;
+		ether_addr_copy(targets[count++].mac, peer->addr);
+	}
+	spin_unlock_bh(&ab->base_lock);
+	for (i = 0; i < count; i++) {
+		struct sk_buff *copy = skb_copy(skb, GFP_ATOMIC);
+		nss_tx_status_t status = NSS_TX_FAILURE;
+
+		if (copy) {
+			br_mcast_offload_packet_clear(copy);
+			ether_addr_copy(copy->data, targets[i].mac);
+			IEEE80211_SKB_CB(copy)->flags &= ~IEEE80211_TX_CTL_REQ_TX_STATUS;
+			ATH11K_SKB_CB(copy)->flags &= ~ATH11K_SKB_TX_STATUS;
+			spin_lock_bh(&ab->base_lock);
+			ret = ath11k_nss_me_admit(arvif);
+			if (!ret)
+				ret = ath11k_nss_key_check(arvif->ar, targets[i].peer, targets[i].state);
+			if (!ret && targets[i].peer->is_authorized && targets[i].peer->vif == arvif->vif)
+				status = nss_wifi_vdev_tx_buf(arvif->ar->nss.ctx, copy, arvif->nss.if_num);
+			spin_unlock_bh(&ab->base_lock);
+			if (status != NSS_TX_SUCCESS)
+				ieee80211_free_txskb(arvif->ar->hw, copy);
+		}
+		if (status == NSS_TX_SUCCESS)
+			atomic64_inc(&arvif->nss.me.tx_copies);
+		else
+			atomic64_inc(&arvif->nss.me.tx_copy_drop);
+		ath11k_peer_put(arvif->ar, targets[i].peer);
+		ath11k_nss_key_put(targets[i].state);
+	}
+	kfree(targets);
+	ieee80211_free_txskb(arvif->ar->hw, skb);
+	return 0;
+unlock:
+	spin_unlock_bh(&ab->base_lock);
+	return ret;
+}
+
+int ath11k_nss_me_tx(struct ath11k_vif *arvif, struct sk_buff *skb)
+{
+	struct ath11k_nss_me_auto *auto_me = &arvif->nss.me_auto;
+	struct ath11k_base *ab = arvif->ar->ab;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(arvif->vif);
+	const struct br_mcast_packet *packet;
+	struct br_mcast_packet_ext *slot;
+	struct ethhdr eth;
+	bool raw = false;
+	u32 i;
+	int ret;
+
+	if (arvif->vif->type != NL80211_IFTYPE_AP)
+		return -EOPNOTSUPP;
+	ret = br_mcast_offload_packet_get(wdev->netdev, skb, &packet);
+	if (ret < 0 || (packet && !ath11k_nss_me_packet_same(skb, packet))) {
+		atomic64_inc(&arvif->nss.me.tx_contract_drop);
+		return ret < 0 ? ret : -ESTALE;
+	}
+	if (skb_copy_bits(skb, 0, &eth, sizeof(eth)))
+		return -EINVAL;
+	if (!is_multicast_ether_addr(eth.h_dest) ||
+	    (!READ_ONCE(auto_me->redirect) && (!packet || packet->action != BR_MCAST_PACKET_HOSTS))) {
+		br_mcast_offload_packet_clear(skb);
+		return -EOPNOTSUPP;
+	}
+	if (!skb_is_gso(skb)) {
+		if (skb->ip_summed == CHECKSUM_PARTIAL) {
+			if (skb_checksum_help(skb))
+				return ath11k_nss_me_fallback(arvif, skb, packet);
+		} else {
+			skb->ip_summed = CHECKSUM_NONE;
+		}
+	}
+	spin_lock_bh(&ab->base_lock);
+	if (packet && arvif->is_up && auto_me->active && auto_me->policy && auto_me->flight &&
+	    !arvif->nss.me.uncertain &&
+	    !ath11k_nss_me_admit(arvif) && ath11k_nss_me_raw_shape(arvif, skb) &&
+	    ath11k_nss_me_targets_same(auto_me->policy, packet)) {
+		raw = true;
+		for (i = 0; i < auto_me->policy->count; i++)
+			if (ath11k_nss_key_check(arvif->ar, auto_me->policy->pins[i].peer,
+						auto_me->policy->pins[i].state) ||
+			    !auto_me->policy->pins[i].peer->is_authorized) {
+				raw = false;
+				break;
+			}
+	}
+	if (raw) {
+		slot = skb_ext_add(skb, SKB_EXT_BR_MCAST_PACKET);
+		if (!slot) {
+			raw = false;
+		} else {
+			/* Increment and final enqueue are serialized with withdrawal. */
+			br_mcast_flight_drop(slot->flight);
+			br_mcast_flight_hold(auto_me->flight);
+			slot->flight = auto_me->flight;
+			ret = nss_wifi_vdev_tx_buf(arvif->ar->nss.ctx, skb, arvif->nss.if_num);
+			if (ret == NSS_TX_SUCCESS)
+				atomic64_inc(&arvif->nss.me.tx_raw);
+		}
+	}
+	spin_unlock_bh(&ab->base_lock);
+	if (raw)
+		return ret;
+	return ath11k_nss_me_fallback(arvif, skb, packet);
+}
 
