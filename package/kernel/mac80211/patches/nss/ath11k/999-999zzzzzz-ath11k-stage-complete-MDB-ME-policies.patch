+bool ath11k_nss_me_same_group(const struct br_ip *a, const struct br_ip *b)
+{
+	if (a->proto != b->proto || a->vid != b->vid)
+		return false;
+	if (a->proto == htons(ETH_P_IP))
+		return a->dst.ip4 == b->dst.ip4;
+#if IS_ENABLED(CONFIG_IPV6)
+	if (a->proto == htons(ETH_P_IPV6))
+		return ipv6_addr_equal(&a->dst.ip6, &b->dst.ip6);
+#endif
+	return false;
+}
+
+static bool ath11k_nss_me_star_g(const struct br_ip *addr)
+{
+	if (addr->proto == htons(ETH_P_IP))
+		return ipv4_is_zeronet(addr->src.ip4);
+#if IS_ENABLED(CONFIG_IPV6)
+	if (addr->proto == htons(ETH_P_IPV6))
+		return ipv6_addr_any(&addr->src.ip6);
+#endif
+	return false;
+}
+
+static bool ath11k_nss_me_same_key(const struct br_ip *a, const struct br_ip *b)
+{
+	if (!ath11k_nss_me_same_group(a, b))
+		return false;
+	if (a->proto == htons(ETH_P_IP))
+		return a->src.ip4 == b->src.ip4;
+#if IS_ENABLED(CONFIG_IPV6)
+	return ipv6_addr_equal(&a->src.ip6, &b->src.ip6);
+#else
+	return false;
+#endif
+}
+
+static int ath11k_nss_me_group_valid(const struct br_ip *group)
+{
+	if (group->vid)
+		return -EOPNOTSUPP;
+	if (group->proto == htons(ETH_P_IP)) {
+		u32 addr = ntohl(group->dst.ip4);
+
+		return (addr & 0xf0000000) == 0xe0000000 &&
+		       (addr & 0xffffff00) != 0xe0000000 ? 0 : -EOPNOTSUPP;
+	}
+#if IS_ENABLED(CONFIG_IPV6)
+	if (group->proto == htons(ETH_P_IPV6))
+		return ipv6_addr_is_multicast(&group->dst.ip6) &&
+		       !ipv6_addr_is_ll_all_nodes(&group->dst.ip6) ? 0 : -EOPNOTSUPP;
+#endif
+	return -EOPNOTSUPP;
+}
+
+static int ath11k_nss_me_source_add(struct ath11k_nss_me_member *member,
+				  const struct br_ip *key)
+{
+	const void *source = &key->src;
+	size_t len = key->proto == htons(ETH_P_IP) ? 4 : 16;
+	u32 i, j;
+
+	for (i = 0; i < member->source_count; i++) {
+		int order = memcmp(source, member->source[i], len);
+
+		if (!order)
+			return 0;
+		if (order < 0)
+			break;
+	}
+	if (member->source_count == ATH11K_NSS_ME_SOURCE_MAX)
+		return -E2BIG;
+	for (j = member->source_count; j > i; j--)
+		memcpy(member->source[j], member->source[j - 1], 16);
+	memset(member->source[i], 0, 16);
+	memcpy(member->source[i], source, len);
+	member->source_count++;
+	return 0;
+}
+
+static int ath11k_nss_me_find_host(const struct br_mcast_offload_host hosts[],
+				 u32 count, const struct br_ip *key, const u8 *mac,
+				 const struct br_mcast_offload_host **found)
+{
+	u32 i;
+
+	*found = NULL;
+	for (i = 0; i < count; i++) {
+		if (!ath11k_nss_me_same_key(&hosts[i].addr, key) ||
+		    !ether_addr_equal(hosts[i].host_mac, mac))
+			continue;
+		if (*found && ((*found)->flags != hosts[i].flags ||
+			       (*found)->filter_mode != hosts[i].filter_mode))
+			return -EUCLEAN;
+		*found = &hosts[i];
+	}
+	return 0;
+}
+
+int ath11k_nss_me_plan_build(const struct br_mcast_offload_host hosts[],
+		const struct br_ip keys[],
+		const struct br_mcast_offload_lookup_snapshot *snapshot,
+		struct ath11k_nss_me_member members[], u32 capacity, u32 *count)
+{
+	u32 i, j, total = 0;
+	int ret;
+
+	if (!snapshot || !count || (!hosts && snapshot->host_count) ||
+	    (!keys && snapshot->key_count) || (!members && capacity))
+		return -EINVAL;
+	*count = 0;
+	if (!snapshot->snooping || snapshot->vlan_snooping ||
+	    !snapshot->forwarding || !snapshot->multicast_to_unicast ||
+	    snapshot->router_ipv4 || snapshot->router_ipv6)
+		return -EOPNOTSUPP;
+	/* Validate the entire port before generating any candidate. */
+	for (i = 0; i < snapshot->host_count; i++) {
+		if (!(hosts[i].flags & BR_MCAST_OFFLOAD_HOST_SPECIFIC) ||
+		    (hosts[i].flags & ~(BR_MCAST_OFFLOAD_HOST_SPECIFIC |
+			BR_MCAST_OFFLOAD_PERMANENT | BR_MCAST_OFFLOAD_STAR_EXCL |
+			BR_MCAST_OFFLOAD_BLOCKED)) ||
+		    !is_valid_ether_addr(hosts[i].host_mac) ||
+		    (hosts[i].filter_mode != MCAST_INCLUDE &&
+		     hosts[i].filter_mode != MCAST_EXCLUDE))
+			return -EOPNOTSUPP;
+		ret = ath11k_nss_me_group_valid(&hosts[i].addr);
+		if (ret)
+			return ret;
+		if (hosts[i].addr.proto == htons(ETH_P_IP) ?
+		    !snapshot->querier_ipv4 : !snapshot->querier_ipv6)
+			return -EAGAIN;
+		for (j = 0; j < snapshot->key_count; j++)
+			if (ath11k_nss_me_same_key(&hosts[i].addr, &keys[j]))
+				break;
+		if (j == snapshot->key_count)
+			return -EUCLEAN;
+	}
+	for (i = 0; i < snapshot->host_count; i++) {
+		const struct br_mcast_offload_host *base, *specific;
+		struct ath11k_nss_me_member candidate = {};
+		struct br_ip star = hosts[i].addr;
+		bool handle_mode, default_allow;
+
+		for (j = 0; j < i; j++)
+			if (ath11k_nss_me_same_group(&hosts[i].addr, &hosts[j].addr) &&
+			    ether_addr_equal(hosts[i].host_mac, hosts[j].host_mac))
+				break;
+		if (j < i)
+			continue;
+		memset(&star.src, 0, sizeof(star.src));
+		for (j = 0; j < snapshot->key_count; j++)
+			if (ath11k_nss_me_same_key(&star, &keys[j]))
+				break;
+		/* Without global *,G, unmatched sources take the flooding path. */
+		if (j == snapshot->key_count)
+			return -EOPNOTSUPP;
+		ret = ath11k_nss_me_find_host(hosts, snapshot->host_count, &star,
+					    hosts[i].host_mac, &base);
+		if (ret)
+			return ret;
+		handle_mode = star.proto == htons(ETH_P_IP) ?
+			snapshot->source_filter_ipv4 : snapshot->source_filter_ipv6;
+		default_allow = base && !(base->flags & BR_MCAST_OFFLOAD_BLOCKED) &&
+			(!handle_mode || base->filter_mode == MCAST_EXCLUDE);
+		candidate.group = star;
+		ether_addr_copy(candidate.mac, hosts[i].host_mac);
+		candidate.mode = default_allow ? 2 : 1;
+		if (handle_mode) {
+			for (j = 0; j < snapshot->key_count; j++) {
+				bool allowed;
+
+				if (!ath11k_nss_me_same_group(&star, &keys[j]) ||
+				    ath11k_nss_me_star_g(&keys[j]))
+					continue;
+				ret = ath11k_nss_me_find_host(hosts, snapshot->host_count,
+							    &keys[j], candidate.mac, &specific);
+				if (ret)
+					return ret;
+				/* S,G wins globally; absent local rows do not inherit *,G. */
+				allowed = specific && !(specific->flags & BR_MCAST_OFFLOAD_BLOCKED);
+				if (allowed == default_allow)
+					continue;
+				ret = ath11k_nss_me_source_add(&candidate, &keys[j]);
+				if (ret)
+					return ret;
+			}
+		}
+		if (candidate.mode == 1 && !candidate.source_count)
+			continue;
+		if (total == capacity)
+			return -E2BIG;
+		members[total++] = candidate;
+	}
+	/* Caller only consumes the output after a complete success. */
+	*count = total;
+	return 0;
+}
