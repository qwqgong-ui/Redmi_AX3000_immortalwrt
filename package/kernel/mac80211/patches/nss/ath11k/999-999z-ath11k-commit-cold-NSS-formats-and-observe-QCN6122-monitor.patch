+	request->if_num = arvif->nss.if_num;
+	request->result = -ETIMEDOUT;
+	format->command = cmd;
+	format->value = value;
+	msg->msg.vdev_cmd.cmd = cmd;
+	msg->msg.vdev_cmd.value = value;
+	nss_wifi_vdev_msg_init(msg, request->if_num, request->type,
+			       sizeof(msg->msg.vdev_cmd),
+			       (nss_wifi_vdev_msg_callback_t *)ath11k_nss_vdev_format_cb,
+			       format);
