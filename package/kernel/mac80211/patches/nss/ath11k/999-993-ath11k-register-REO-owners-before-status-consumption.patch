+static struct dp_reo_cmd *
+ath11k_dp_reo_cmd_take(struct ath11k_dp *dp, u16 cmd_num, u16 tag, bool *accepted)
+{
+	struct dp_reo_cmd *cmd, *found = NULL;
+
+	lockdep_assert_held(&dp->reo_cmd_lock);
+	*accepted = false;
+	if (!cmd_num || cmd_num >= ARRAY_SIZE(dp->reo_cmd_status_tag) ||
+	    !dp->reo_cmd_status_tag[cmd_num]) {
+		dp->reo_cmd_stats.unexpected_status++;
+		goto out;
+	}
+	if (dp->reo_cmd_status_tag[cmd_num] != tag) {
+		/* Preserve the ID and owner until a matching status or a stopped epoch. */
+		dp->reo_cmd_stats.tag_mismatch++;
+		goto out;
+	}
+	list_for_each_entry(cmd, &dp->reo_cmd_list, list) {
+		if (cmd->cmd_num != cmd_num)
+			continue;
+		if (cmd->status_tag != tag) {
+			dp->reo_cmd_stats.tag_mismatch++;
+			goto out;
+		}
+		found = cmd;
+		list_del(&cmd->list);
+		dp->reo_cmd_stats.callbacks_claimed++;
+		break;
+	}
+	dp->reo_cmd_status_tag[cmd_num] = 0;
+	dp->reo_cmd_stats.pending--;
+	dp->reo_cmd_stats.completed++;
+	*accepted = true;
+out:
+	return found;
+}
