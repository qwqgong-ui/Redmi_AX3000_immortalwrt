+int br_mcast_offload_packet_get(struct net_device *dev, const struct sk_buff *skb,
+			       const struct br_mcast_packet **result)
+{
+	const struct br_mcast_packet_ext *slot;
+	const struct br_mcast_packet *packet;
+	struct net_bridge_port *p;
+	int ret = -ESTALE;
+
+	if (!result)
+		return -EINVAL;
+	*result = NULL;
+	slot = skb_ext_find(skb, SKB_EXT_BR_MCAST_PACKET);
+	if (!skb->br_mcast_contract)
+		return slot ? -EPROTO : 0;
+	if (!slot || !slot->packet)
+		return -ENODATA;
+	packet = slot->packet;
+	if (packet->version != BR_MCAST_PACKET_VERSION ||
+	    !packet->port_cookie || packet->count > BR_MCAST_PACKET_MAC_MAX ||
+	    (packet->flags & ~(BR_MCAST_PACKET_INGRESS_PORT | BR_MCAST_PACKET_LOCAL_ORIG)) ||
+	    (packet->action != BR_MCAST_PACKET_HOSTS &&
+	     packet->action != BR_MCAST_PACKET_ORDINARY) ||
+	    (packet->action == BR_MCAST_PACKET_ORDINARY && packet->count) ||
+	    (packet->action == BR_MCAST_PACKET_HOSTS && !packet->count))
+		return -EPROTO;
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (p && packet->port_ifindex == dev->ifindex &&
+	    packet->bridge_ifindex == p->br->dev->ifindex &&
+	    packet->port_cookie == READ_ONCE(p->mcast_packet_cookie)) {
+		*result = packet;
+		ret = 1;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_packet_get);
 
