+			    request->error, request->len);
+	ath11k_dbg(ab, ATH11K_DBG_NSS,
+		   "NSS VDEV format if=%u cmd=%u value=%u result=%d response=%u error=%u len=%u\n",
+		   request->if_num, cmd, value, ret, request->response,
+		   request->error, request->len);
+	kfree(msg);
+	kfree(format);
+	return ret;
+}
