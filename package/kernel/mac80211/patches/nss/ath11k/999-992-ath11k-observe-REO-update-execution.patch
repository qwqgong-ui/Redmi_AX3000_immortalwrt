+static ssize_t ath11k_debugfs_reo_update_stats(struct file *file,
+		char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_reo_update_stats stats;
+	const size_t size = 2048;
+	char *buf;
+	int len = 0;
+	ssize_t ret;
+
+	buf = kzalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	ath11k_dp_reo_update_snapshot(&ab->dp, &stats);
+	len += scnprintf(buf + len, size - len,
+		"epoch: %llu\nrequested: %llu\nqueued: %llu\nrejected: %llu\n"
+		"status_requested: %llu\nba_queued: %llu\nssn_queued: %llu\npn_queued: %llu\n",
+		stats.epoch, stats.requested, stats.queued, stats.rejected,
+		stats.status_requested, stats.ba_queued, stats.ssn_queued, stats.pn_queued);
+	len += scnprintf(buf + len, size - len,
+		"status_success: %llu\nstatus_blocked: %llu\nstatus_failed: %llu\n"
+		"status_resource_blocked: %llu\nstatus_unknown: %llu\n",
+		stats.status[0], stats.status[1], stats.status[2], stats.status[3],
+		stats.status_unknown);
+	len += scnprintf(buf + len, size - len,
+		"last_submit_cmd: %u\nlast_hal_submit_errno: %d\nlast_paddr: 0x%llx\n"
+		"last_flags: 0x%x\nlast_upd0: 0x%x\nlast_requested_window: %u\n"
+		"last_requested_ssn: %u\nlast_status_cmd: %u\nlast_status: %u\n"
+		"last_hw_timestamp: %u\n",
+		stats.last_cmd, stats.last_errno, stats.last_paddr, stats.last_flags,
+		stats.last_upd0, stats.last_window, stats.last_ssn,
+		stats.last_status_cmd, stats.last_status, stats.last_timestamp);
+	len += scnprintf(buf + len, size - len,
+		"last_ba_cmd: %u\nlast_ba_paddr: 0x%llx\n"
+		"last_ba_requested_window: %u\nlast_ba_requested_ssn: %u\n",
+		stats.last_ba_cmd, stats.last_ba_paddr, stats.last_ba_window,
+		stats.last_ba_ssn);
+	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+	return ret;
+}
+
+static const struct file_operations fops_reo_update_stats = {
+	.read = ath11k_debugfs_reo_update_stats,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
