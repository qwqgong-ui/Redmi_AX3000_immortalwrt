+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_BR_MCAST_PACKET_H
+#define _LINUX_BR_MCAST_PACKET_H
+
+#include <linux/if_ether.h>
+#include <linux/atomic.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+
+#define BR_MCAST_PACKET_VERSION 1
+#define BR_MCAST_PACKET_MAC_MAX 64
+#define BR_MCAST_PACKET_INGRESS_PORT 1
+#define BR_MCAST_PACKET_LOCAL_ORIG 2
+
+enum br_mcast_packet_action {
+	BR_MCAST_PACKET_ORDINARY = 1,
+	BR_MCAST_PACKET_HOSTS = 2,
+};
+
+/* Immutable native forwarding result, not firmware metadata. A storage
+ * object owns one reference; skb clones share that storage reference.
+ */
+struct br_mcast_packet {
+	refcount_t refs;
+	u8 version;
+	u8 action;
+	u8 flags;
+	u16 count;
+	__be16 proto;
+	u64 port_cookie;
+	u64 mcu_cookie;
+	u64 seq;
+	int bridge_ifindex;
+	int port_ifindex;
+	u8 group_da[ETH_ALEN];
+	u8 source_mac[ETH_ALEN];
+	u8 source_ip[16];
+	u8 group_ip[16];
+	u8 mac[][ETH_ALEN];
+};
+
+/* Independent of a driver's lifetime: core skb storage releases only this
+ * reference/counter, never a callback into an unloaded module or freed VIF.
+ */
+struct br_mcast_flight {
+	refcount_t refs;
+	atomic_t pending;
+	wait_queue_head_t drained;
+};
+
+struct br_mcast_packet_ext {
+	struct br_mcast_packet *packet;
+	struct br_mcast_flight *flight;
+};
+
+static inline void br_mcast_flight_put(struct br_mcast_flight *flight)
+{
+	if (flight && refcount_dec_and_test(&flight->refs))
+		kfree(flight);
+}
+
+static inline void br_mcast_flight_hold(struct br_mcast_flight *flight)
+{
+	if (flight) {
+		refcount_inc(&flight->refs);
+		atomic_inc(&flight->pending);
+	}
+}
+
+static inline void br_mcast_flight_drop(struct br_mcast_flight *flight)
+{
+	if (!flight)
+		return;
+	if (atomic_dec_and_test(&flight->pending))
+		wake_up_all(&flight->drained);
+	br_mcast_flight_put(flight);
+}
+
+static inline void br_mcast_packet_get(struct br_mcast_packet *packet)
+{
+	if (packet)
+		refcount_inc(&packet->refs);
+}
+
+static inline void br_mcast_packet_put(struct br_mcast_packet *packet)
+{
+	if (packet && refcount_dec_and_test(&packet->refs))
+		kfree(packet);
+}
+
