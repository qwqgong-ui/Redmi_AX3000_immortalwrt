+static void ath11k_mac_key_detach_failed_delete(struct ath11k_vif *arvif,
+		struct ath11k_peer *expected_peer, const u8 *addr,
+		struct ieee80211_key_conf *key, struct ath11k_sta *arsta)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_peer *peer;
+	struct ieee80211_key_conf *remaining;
+	u16 free_idx = 0;
+	bool keep_group = false;
+	bool clear_pn;
+	int i;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	spin_lock_bh(&ar->ab->base_lock);
+	peer = ath11k_peer_find(ar, arvif->vdev_id, addr);
+	if (peer != expected_peer) {
+		/* Unmap may retire this pinned peer into the DMA quarantine. Drop
+		 * only its exact borrowed key, without examining other old keys or
+		 * changing replacement/STA/VLAN state.
+		 */
+		if (expected_peer && expected_peer->keys[key->keyidx] == key)
+			expected_peer->keys[key->keyidx] = NULL;
+		goto unlock;
+	}
+	if (!peer || peer->keys[key->keyidx] != key)
+		goto unlock;
+
+	clear_pn = (key->flags & IEEE80211_KEY_FLAG_PAIRWISE) &&
+		peer->ucast_keyidx == key->keyidx;
+	if (key->vlan_id && !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE) &&
+	    arvif->vlan_keyid_map &&
+	    arvif->vlan_keyid_map[key->vlan_id] == key->hw_key_idx) {
+		for (i = 0; i < ARRAY_SIZE(peer->keys); i++) {
+			remaining = peer->keys[i];
+			if (remaining && remaining != key &&
+			    !(remaining->flags & IEEE80211_KEY_FLAG_PAIRWISE) &&
+			    remaining->vlan_id == key->vlan_id &&
+			    remaining->hw_key_idx == key->hw_key_idx)
+				keep_group = true;
+		}
+		if (!keep_group) {
+			free_idx = key->hw_key_idx;
+			arvif->vlan_keyid_map[key->vlan_id] = 0;
+		}
+	}
+	ath11k_mac_peer_key_remove(peer, key);
+	if (arsta && clear_pn)
+		arsta->pn_type = HAL_PN_TYPE_NONE;
+unlock:
+	spin_unlock_bh(&ar->ab->base_lock);
+	if (free_idx && free_idx < ARRAY_SIZE(arvif->free_groupidx_map) * BITS_PER_LONG) {
+		/* All key/map writers are serialized by conf_mutex. Do not nest
+		 * data_lock under base_lock merely to return the bitmap slot.
+		 */
+		spin_lock_bh(&ar->data_lock);
+		set_bit(free_idx, arvif->free_groupidx_map);
+		spin_unlock_bh(&ar->data_lock);
 	}
 }
 
