+u64 br_mcast_offload_port_cookie(struct net_device *dev)
+{
+	struct net_bridge_port *p;
+	u64 cookie = 0;
+
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (p) {
+		spin_lock_bh(&p->br->multicast_lock);
+		if (!p->mcast_packet_cookie)
+			WRITE_ONCE(p->mcast_packet_cookie,
+				   atomic64_inc_return(&br_mcast_packet_cookie_sequence));
+		cookie = p->mcast_packet_cookie;
+		spin_unlock_bh(&p->br->multicast_lock);
+	}
+	rcu_read_unlock();
+	return cookie;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_port_cookie);
