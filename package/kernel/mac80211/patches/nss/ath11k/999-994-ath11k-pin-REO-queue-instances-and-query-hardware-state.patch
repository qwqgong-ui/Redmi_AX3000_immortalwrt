+void ath11k_dp_reo_queue_get(struct ath11k_reo_queue *queue)
+{
+	if (queue)
+		refcount_inc(&queue->refs);
+}
+
+void ath11k_dp_reo_queue_put(struct ath11k_reo_queue *queue)
+{
+	if (!queue || !refcount_dec_and_test(&queue->refs))
+		return;
+	/* An unretired HW owner is not made freeable by a software reference count. */
+	if (WARN_ON_ONCE(READ_ONCE(queue->dma_live))) {
+		refcount_set(&queue->refs, 1);
+		return;
+	}
+	if (queue->vaddr_unaligned)
+		dma_free_noncoherent(queue->dev, queue->unaligned_size,
+				     queue->vaddr_unaligned, queue->paddr_unaligned,
+				     DMA_BIDIRECTIONAL);
