 			return NULL;
@@ -78,52 +96,43 @@
  */
 static void nss_project_wt_stats_enable_callback(void *app_data, struct nss_project_msg *msg)
 {
-	struct nss_ctx_instance *nss_ctx = (struct nss_ctx_instance *)app_data;
+	struct nss_project_wt_request *request = app_data;
 	struct nss_project_msg_wt_stats_enable *stats_enable = &msg->msg.wt_stats_enable;
-	struct nss_worker_thread_stats *stats_temp;
-
-	NSS_VERIFY_CTX_MAGIC(nss_ctx);
-	if (msg->cm.response != NSS_CMN_RESPONSE_ACK) {
-		return;
-	}
-
-	nss_info("%px: Received response ACK for worker thread stats enable msg.\n", nss_ctx);
 
-	/*
-	 * If statistics have already been allocated, nothing else to do.
-	 */
-	if (nss_ctx->wt_stats) {
-		return;
-	}
-
-	stats_temp = nss_project_alloc_wt_stats(stats_enable->worker_thread_count,
-						stats_enable->irq_count);
-	if (unlikely(!stats_temp)) {
-		nss_warning("%px: Unable to allocate worker thread statistics.\n", nss_ctx);
-		return;
+	request->result = -EIO;
+	if (msg->cm.response == NSS_CMN_RESPONSE_ACK && !msg->cm.error) {
+		request->result = -EPROTO;
+		if (msg->cm.len == sizeof(*stats_enable) &&
+		    stats_enable->enable == request->enable &&
+		    nss_project_wt_counts_valid(stats_enable->worker_thread_count,
+					       stats_enable->irq_count)) {
+			request->threads = stats_enable->worker_thread_count;
+			request->irqs = stats_enable->irq_count;
+			request->result = 0;
+		}
 	}
-
-	spin_lock_bh(&nss_ctx->nss_top->stats_lock);
-	nss_ctx->wt_stats = stats_temp;
-	nss_ctx->worker_thread_count = stats_enable->worker_thread_count;
-	nss_ctx->irq_count = stats_enable->irq_count;
-	spin_unlock_bh(&nss_ctx->nss_top->stats_lock);
+	complete(&request->complete);
 }
 
 /*
  * nss_project_wt_stats_send_enable()
  *	Sends message to firmware to enable or disable worker_thread statistics collection.
  */
-static nss_tx_status_t nss_project_wt_stats_send_enable(struct nss_ctx_instance *nss_ctx, bool enable)
+static int nss_project_wt_stats_send_enable(struct nss_ctx_instance *nss_ctx, bool enable)
 {
 	struct nss_project_msg *npm;
 	struct nss_cmn_msg *ncm;
-	nss_tx_status_t ret;
+	struct nss_project_wt_request request = { .enable = enable, .result = -ETIMEDOUT };
+	struct nss_worker_thread_stats *stats = NULL, *old;
+	uint32_t cookie, old_threads;
+	nss_tx_status_t status;
+	unsigned long waited;
+	int ret;
 
 	npm = kzalloc(sizeof(*npm), GFP_KERNEL);
 	if (!npm) {
 		nss_warning("%px: Failed to allocate buffer for message\n", nss_ctx);
-		return NSS_TX_FAILURE;
+		return -ENOMEM;
 	}
 
 	/*
@@ -134,12 +143,47 @@
 		NSS_PROJECT_MSG_WT_STATS_ENABLE,
 		sizeof(struct nss_project_msg_wt_stats_enable),
 		(void *)nss_project_wt_stats_enable_callback,
-		(void *)nss_ctx);
+		(void *)&request);
 	npm->msg.wt_stats_enable.enable = enable;
 
-	ret = nss_core_send_cmd(nss_ctx, npm, sizeof(*npm), NSS_NBUF_PAYLOAD_SIZE);
+	init_completion(&request.complete);
+	status = nss_control_send(nss_ctx, npm, sizeof(*npm), NSS_NBUF_PAYLOAD_SIZE,
+				  NSS_CONTROL_PROJECT, &cookie);
 	kfree(npm);
-	return ret;
+	if (status != NSS_TX_SUCCESS)
+		return -EIO;
+
+	waited = wait_for_completion_timeout(&request.complete,
+					     msecs_to_jiffies(NSS_PROJECT_WT_TIMEOUT));
+	/* A callback already claimed by RX owns request until cancel drains it.
+	 * Accept an ACK at the timeout boundary, never a late reply to a new request.
+	 */
+	nss_control_cancel(cookie);
+	ret = !waited && !completion_done(&request.complete) ? -ETIMEDOUT : request.result;
+	if (ret)
+		return ret;
+
+	if (enable) {
+		stats = nss_project_alloc_wt_stats(request.threads, request.irqs);
+		if (!stats)
+			return -ENOMEM;
+	}
+
+	spin_lock_bh(&nss_top_main.stats_lock);
+	nss_project_wt_state[nss_ctx->id] = enable;
+	if (enable) {
+		old = nss_ctx->wt_stats;
+		old_threads = nss_ctx->worker_thread_count;
+		nss_ctx->wt_stats = stats;
+		nss_ctx->worker_thread_count = request.threads;
+		nss_ctx->irq_count = request.irqs;
+	} else {
+		old = NULL;
+		old_threads = 0;
+	}
+	spin_unlock_bh(&nss_top_main.stats_lock);
+	nss_project_free_wt_stats(old, old_threads);
+	return 0;
 }
 
