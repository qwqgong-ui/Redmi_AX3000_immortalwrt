Subject: [PATCH] nss-drv: publish VLAN nodes after configuration ACK

Split control registration from dataplane publication. Serialise VLAN/bridge
responses so an abandoned transaction cannot complete a later request.

--- a/nss_vlan.c
+++ b/nss_vlan.c
@@ -29,7 +29,10 @@
 	void *cb;
 	void *app_data;
 	bool registered;
+	nss_ptr_t serial;
+	bool waiting;
 } vlan_pvt;
+static DEFINE_SPINLOCK(vlan_sync_lock);
 
 /*
  * nss_vlan_get_context()
@@ -118,24 +121,32 @@
  * nss_vlan_callback()
  *	Callback to handle the completion of NSS->HLOS messages.
  */
-static void nss_vlan_callback(void *app_data, struct nss_vlan_msg *nvm)
-{
-	nss_vlan_msg_callback_t callback = (nss_vlan_msg_callback_t)vlan_pvt.cb;
-	void *data = vlan_pvt.app_data;
-
-	vlan_pvt.response = NSS_TX_SUCCESS;
-	vlan_pvt.cb = NULL;
-	vlan_pvt.app_data = NULL;
-
-	if (nvm->cm.response != NSS_CMN_RESPONSE_ACK) {
-		nss_warning("vlan error response %d\n", nvm->cm.response);
-		vlan_pvt.response = nvm->cm.response;
-	}
-
-	if (callback) {
-		callback(data, nvm);
-	}
-	complete(&vlan_pvt.complete);
+static void nss_vlan_callback(void *app_data, struct nss_vlan_msg *msg)
+{
+    nss_vlan_msg_callback_t callback;
+    void *data;
+    nss_ptr_t serial = (nss_ptr_t)app_data;
+
+    spin_lock_bh(&vlan_sync_lock);
+    if (!vlan_pvt.waiting || serial != vlan_pvt.serial) {
+        spin_unlock_bh(&vlan_sync_lock);
+        return;
+    }
+    callback = (nss_vlan_msg_callback_t)vlan_pvt.cb;
+    data = vlan_pvt.app_data;
+    spin_unlock_bh(&vlan_sync_lock);
+    if (callback)
+        callback(data, msg);
+    spin_lock_bh(&vlan_sync_lock);
+    if (vlan_pvt.waiting && serial == vlan_pvt.serial) {
+        vlan_pvt.response = msg->cm.response == NSS_CMN_RESPONSE_ACK ?
+                             NSS_TX_SUCCESS : NSS_TX_FAILURE;
+        vlan_pvt.cb = NULL;
+        vlan_pvt.app_data = NULL;
+        vlan_pvt.waiting = false;
+        complete(&vlan_pvt.complete);
+    }
+    spin_unlock_bh(&vlan_sync_lock);
 }
 
 /*
@@ -172,45 +183,37 @@
  * nss_vlan_tx_msg_sync()
  *	Transmit a vlan message to NSS firmware synchronously.
  */
-nss_tx_status_t nss_vlan_tx_msg_sync(struct nss_ctx_instance *nss_ctx, struct nss_vlan_msg *nvm)
-{
-	nss_tx_status_t status;
-	int ret = 0;
-
-	/*
-	 * Until nss_vlan_register_handler() has run, the semaphore below is
-	 * still zeroed: down() would take the slow path and walk a NULL
-	 * wait_list head. Fail the message instead of panicking.
-	 */
-	if (!READ_ONCE(vlan_pvt.registered)) {
-		nss_warning("%px: vlan handler not registered (no qcom,vlan-enabled in DT?)\n",
-			    nss_ctx);
-		return NSS_TX_FAILURE_NOT_READY;
-	}
-
-	down(&vlan_pvt.sem);
-	vlan_pvt.cb = (void *)nvm->cm.cb;
-	vlan_pvt.app_data = (void *)nvm->cm.app_data;
-
-	nvm->cm.cb = (nss_ptr_t)nss_vlan_callback;
-	nvm->cm.app_data = (nss_ptr_t)NULL;
-
-	status = nss_vlan_tx_msg(nss_ctx, nvm);
-	if (status != NSS_TX_SUCCESS) {
-		nss_warning("%px: vlan_tx_msg failed\n", nss_ctx);
-		up(&vlan_pvt.sem);
-		return status;
-	}
-
-	ret = wait_for_completion_timeout(&vlan_pvt.complete, msecs_to_jiffies(NSS_VLAN_TX_TIMEOUT));
-	if (!ret) {
-		nss_warning("%px: vlan msg tx failed due to timeout\n", nss_ctx);
-		vlan_pvt.response = NSS_TX_FAILURE;
-	}
-
-	status = vlan_pvt.response;
-	up(&vlan_pvt.sem);
-	return status;
+nss_tx_status_t nss_vlan_tx_msg_sync(struct nss_ctx_instance *nss_ctx, struct nss_vlan_msg *msg)
+{
+    nss_tx_status_t status;
+
+    if (!READ_ONCE(vlan_pvt.registered))
+        return NSS_TX_FAILURE_NOT_READY;
+    down(&vlan_pvt.sem);
+    reinit_completion(&vlan_pvt.complete);
+    spin_lock_bh(&vlan_sync_lock);
+    if (!++vlan_pvt.serial)
+        ++vlan_pvt.serial;
+    vlan_pvt.waiting = true;
+    vlan_pvt.response = NSS_TX_FAILURE;
+    vlan_pvt.cb = (void *)msg->cm.cb;
+    vlan_pvt.app_data = (void *)msg->cm.app_data;
+    msg->cm.cb = (nss_ptr_t)nss_vlan_callback;
+    msg->cm.app_data = vlan_pvt.serial;
+    spin_unlock_bh(&vlan_sync_lock);
+    status = nss_vlan_tx_msg(nss_ctx, msg);
+    if (status == NSS_TX_SUCCESS)
+        wait_for_completion_timeout(&vlan_pvt.complete,
+            msecs_to_jiffies(NSS_VLAN_TX_TIMEOUT));
+    spin_lock_bh(&vlan_sync_lock);
+    if (status == NSS_TX_SUCCESS)
+        status = vlan_pvt.response;
+    vlan_pvt.waiting = false;
+    vlan_pvt.cb = NULL;
+    vlan_pvt.app_data = NULL;
+    spin_unlock_bh(&vlan_sync_lock);
+    up(&vlan_pvt.sem);
+    return status;
 }
 EXPORT_SYMBOL(nss_vlan_tx_msg_sync);
 
@@ -376,18 +379,47 @@
  *
  * @return nss_ctx_instance* NSS context
  */
-struct nss_ctx_instance *nss_register_vlan_if(uint32_t if_num, nss_vlan_callback_t vlan_data_callback,
-					      struct net_device *netdev, uint32_t features, void *app_ctx)
-{
-	struct nss_ctx_instance *nss_ctx = nss_vlan_get_context();
-
-	nss_assert(nss_vlan_verify_if_num(if_num));
-
-	nss_core_register_subsys_dp(nss_ctx, if_num, vlan_data_callback, NULL, app_ctx, netdev, features);
-
-	nss_core_register_handler(nss_ctx, if_num, nss_vlan_handler, app_ctx);
-
-	return nss_ctx;
+struct nss_ctx_instance *nss_vlan_prepare_if(uint32_t if_num, void *app_ctx)
+{
+    struct nss_ctx_instance *ctx = nss_vlan_get_context();
+
+    if (!READ_ONCE(vlan_pvt.registered) || !nss_vlan_verify_if_num(if_num))
+        return NULL;
+    if (nss_core_register_handler(ctx, if_num, nss_vlan_handler, app_ctx) !=
+        NSS_CORE_STATUS_SUCCESS)
+        return NULL;
+    return ctx;
+}
+EXPORT_SYMBOL_GPL(nss_vlan_prepare_if);
+
+void nss_vlan_publish_if(uint32_t if_num, nss_vlan_callback_t callback,
+                         struct net_device *dev, uint32_t features, void *app_ctx)
+{
+    struct nss_ctx_instance *ctx = nss_vlan_get_context();
+
+    nss_assert(nss_vlan_verify_if_num(if_num));
+    nss_core_register_subsys_dp(ctx, if_num, callback, NULL, app_ctx, dev, features);
+}
+EXPORT_SYMBOL_GPL(nss_vlan_publish_if);
+
+void nss_vlan_withdraw_if(uint32_t if_num)
+{
+    struct nss_ctx_instance *ctx = nss_vlan_get_context();
+
+    nss_assert(nss_vlan_verify_if_num(if_num));
+    nss_core_unregister_subsys_dp(ctx, if_num);
+}
+EXPORT_SYMBOL_GPL(nss_vlan_withdraw_if);
+
+struct nss_ctx_instance *nss_register_vlan_if(uint32_t if_num, nss_vlan_callback_t callback,
+                                             struct net_device *dev, uint32_t features, void *app_ctx)
+{
+    struct nss_ctx_instance *ctx = nss_vlan_prepare_if(if_num, app_ctx);
+
+    if (!ctx)
+        return NULL;
+    nss_vlan_publish_if(if_num, callback, dev, features, app_ctx);
+    return ctx;
 }
 EXPORT_SYMBOL(nss_register_vlan_if);
 
--- a/nss_bridge.c
+++ b/nss_bridge.c
@@ -28,7 +28,11 @@
 	int response;
 	void *cb;
 	void *app_data;
+	bool registered;
+	nss_ptr_t serial;
+	bool waiting;
 } bridge_pvt;
+static DEFINE_SPINLOCK(bridge_sync_lock);
 
 /*
  * nss_bridge_handler()
@@ -100,24 +104,32 @@
  * nss_bridge_callback()
  *	Callback to handle the completion of NSS->HLOS messages.
  */
-static void nss_bridge_callback(void *app_data, struct nss_bridge_msg *nbm)
-{
-	nss_bridge_msg_callback_t callback = (nss_bridge_msg_callback_t)bridge_pvt.cb;
-	void *data = bridge_pvt.app_data;
-
-	bridge_pvt.response = NSS_TX_SUCCESS;
-	bridge_pvt.cb = NULL;
-	bridge_pvt.app_data = NULL;
-
-	if (nbm->cm.response != NSS_CMN_RESPONSE_ACK) {
-		nss_warning("bridge error response %d\n", nbm->cm.response);
-		bridge_pvt.response = nbm->cm.response;
-	}
-
-	if (callback) {
-		callback(data, nbm);
-	}
-	complete(&bridge_pvt.complete);
+static void nss_bridge_callback(void *app_data, struct nss_bridge_msg *msg)
+{
+    nss_bridge_msg_callback_t callback;
+    void *data;
+    nss_ptr_t serial = (nss_ptr_t)app_data;
+
+    spin_lock_bh(&bridge_sync_lock);
+    if (!bridge_pvt.waiting || serial != bridge_pvt.serial) {
+        spin_unlock_bh(&bridge_sync_lock);
+        return;
+    }
+    callback = (nss_bridge_msg_callback_t)bridge_pvt.cb;
+    data = bridge_pvt.app_data;
+    spin_unlock_bh(&bridge_sync_lock);
+    if (callback)
+        callback(data, msg);
+    spin_lock_bh(&bridge_sync_lock);
+    if (bridge_pvt.waiting && serial == bridge_pvt.serial) {
+        bridge_pvt.response = msg->cm.response == NSS_CMN_RESPONSE_ACK ?
+                             NSS_TX_SUCCESS : NSS_TX_FAILURE;
+        bridge_pvt.cb = NULL;
+        bridge_pvt.app_data = NULL;
+        bridge_pvt.waiting = false;
+        complete(&bridge_pvt.complete);
+    }
+    spin_unlock_bh(&bridge_sync_lock);
 }
 
 /*
@@ -172,35 +184,37 @@
  * nss_bridge_tx_msg_sync()
  *	Transmit a bridge message to NSS firmware synchronously.
  */
-nss_tx_status_t nss_bridge_tx_msg_sync(struct nss_ctx_instance *nss_ctx, struct nss_bridge_msg *nbm)
