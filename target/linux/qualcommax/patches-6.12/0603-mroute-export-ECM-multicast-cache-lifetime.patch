+static void ip6mr_offload_vif_notify(struct mr_table *mrt, int vifi)
+{
+	struct mr_mfc *c;
+
+	ASSERT_RTNL();
+	list_for_each_entry(c, &mrt->mfc_cache_list, list) {
+		if (c->mfc_parent == vifi ||
+		    (c->mfc_un.res.ttls[vifi] && c->mfc_un.res.ttls[vifi] != 255))
+			ip6mr_offload_mfc_notify(read_pnet(&mrt->net), mrt->id,
+						(struct mfc6_cache *)c,
+						FIB_EVENT_ENTRY_REPLACE);
+	}
 }
 
