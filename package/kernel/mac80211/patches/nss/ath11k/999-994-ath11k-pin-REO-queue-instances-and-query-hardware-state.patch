+void ath11k_dp_reo_tid_clone(struct dp_rx_tid *dst, const struct dp_rx_tid *src)
+{
+	/* Only DMA retirement metadata: never alias a peer's timer or skb queue. */
+	dst->tid = src->tid;
+	dst->reo_queue = src->reo_queue;
+	dst->paddr = src->paddr;
+	dst->size = src->size;
+	dst->pending_desc_size = src->pending_desc_size;
+	dst->ba_win_sz = src->ba_win_sz;
+	dst->active = src->active;
+	dst->vaddr_unaligned = src->vaddr_unaligned;
+	dst->paddr_unaligned = src->paddr_unaligned;
+	dst->unaligned_size = src->unaligned_size;
+	ath11k_dp_reo_queue_get(dst->reo_queue);
+}
+
+void ath11k_dp_reo_tid_drop(struct dp_rx_tid *tid)
+{
+	struct ath11k_reo_queue *queue = tid->reo_queue;
+
+	tid->reo_queue = NULL;
+	tid->active = false;
+	tid->vaddr_unaligned = NULL;
+	tid->paddr_unaligned = 0;
+	tid->paddr = 0;
+	tid->size = 0;
+	tid->pending_desc_size = 0;
+	tid->unaligned_size = 0;
+	ath11k_dp_reo_queue_put(queue);
+}
+
+static void ath11k_dp_reo_queue_retired(struct ath11k_reo_queue *queue)
+{
+	if (!queue)
+		return;
+	WRITE_ONCE(queue->phase, ATH11K_REO_QUEUE_RETIRED);
+	WRITE_ONCE(queue->dma_live, false);
+}
+
+static void ath11k_dp_reo_queue_retain(struct ath11k_dp *dp,
+					 struct ath11k_reo_queue *queue)
+{
+	if (!queue)
+		return;
+	spin_lock_bh(&dp->reo_cmd_lock);
+	if (!queue->retained) {
+		ath11k_dp_reo_queue_get(queue);
+		queue->retained = true;
+		WRITE_ONCE(queue->phase, ATH11K_REO_QUEUE_UNRESOLVED);
+		list_add_tail(&queue->retained_list, &dp->reo_retained_queues);
+		dp->reo_retained_count++;
+	}
+	spin_unlock_bh(&dp->reo_cmd_lock);
+}
