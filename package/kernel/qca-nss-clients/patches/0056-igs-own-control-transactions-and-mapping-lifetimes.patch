+/* Only before a SET was submitted, or after a confirmed RESET/CLEAR pair. */
+void nss_ifb_abort_bind(struct nss_ifb_info *ifb_info)
+{
+	struct net_device *dev = ifb_info->map_dev;
+
+	ifb_info->map_dev = NULL;
+	ifb_info->is_mapped = false;
+	if (dev)
+		dev_put(dev);
+}
+
+/* A failed firmware rollback must not stall Linux netdevice unregister. */
+void nss_ifb_forget_dev(struct nss_ifb_info *ifb_info, struct net_device *dev)
+{
+	ifb_info->quarantined = true;
+	if (ifb_info->map_dev == dev) {
+		ifb_info->map_dev = NULL;
+		dev_put(dev);
+	}
+	if (ifb_info->ifb_dev == dev) {
+		if (ifb_info->ifb_ifnum >= 0) {
+			nss_igs_unregister_if(ifb_info->ifb_ifnum);
+			synchronize_net();
+		}
+		ifb_info->ifb_dev = NULL;
+		dev_put(dev);
+	}
+	/* Keep the module/firmware identity until reset; no raw device remains. */
+}
