Subject: [PATCH] ath11k: serialize REO publication and callback ownership

--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -66,6 +66,7 @@
 	struct list_head list;
 	struct dp_rx_tid data;
 	int cmd_num;
+	u16 status_tag;
 	void (*handler)(struct ath11k_dp *, void *,
 			enum hal_reo_cmd_status status);
 };
@@ -328,6 +329,20 @@
 	u16 ssn;
 };
 
+struct ath11k_reo_cmd_stats {
+	u64 submitted;
+	u64 status_requested;
+	u64 completed;
+	u64 callbacks_registered;
+	u64 callbacks_claimed;
+	u64 submit_failed;
+	u64 allocation_failed;
+	u64 slot_busy;
+	u64 unexpected_status;
+	u64 tag_mismatch;
+	u32 pending;
+};
+
 struct ath11k_dp {
 	struct ath11k_base *ab;
 	enum ath11k_htc_ep_id eid;
@@ -356,8 +371,14 @@
 	 * - reo_cmd_list
 	 * - reo_cmd_cache_flush_list
 	 * - reo_cmd_cache_flush_count
+	 * - reo_cmd_accepting, reo_cmd_epoch, reo_cmd_status_tag, reo_cmd_stats
 	 */
 	spinlock_t reo_cmd_lock;
+	bool reo_cmd_accepting;
+	u64 reo_cmd_epoch;
+	/* Fixed ring IDs may be reused only after their requested status is consumed. */
+	u16 reo_cmd_status_tag[DP_REO_CMD_RING_SIZE + 1];
+	struct ath11k_reo_cmd_stats reo_cmd_stats;
 	spinlock_t reo_stats_lock;
 	struct ath11k_reo_update_stats reo_update_stats;
 	struct list_head reo_cmd_update_rx_queue_list;
@@ -370,6 +391,33 @@
 	struct ath11k_hp_update_timer tx_ring_timer[DP_TCL_NUM_RING_MAX];
 };
 
+static inline void ath11k_dp_reo_cmd_close(struct ath11k_dp *dp)
+{
+	/* A publication gate, not a hardware halt or a DMA completion fence. */
+	spin_lock_bh(&dp->reo_cmd_lock);
+	dp->reo_cmd_accepting = false;
+	dp->reo_cmd_epoch++;
+	spin_unlock_bh(&dp->reo_cmd_lock);
+}
+
+static inline int ath11k_dp_reo_cmd_status_tag(enum hal_reo_cmd_type type)
+{
+	switch (type) {
+	case HAL_REO_CMD_GET_QUEUE_STATS:
+		return HAL_REO_GET_QUEUE_STATS_STATUS;
+	case HAL_REO_CMD_FLUSH_CACHE:
+		return HAL_REO_FLUSH_CACHE_STATUS;
+	case HAL_REO_CMD_UPDATE_RX_QUEUE:
+		return HAL_REO_UPDATE_RX_REO_QUEUE_STATUS;
+	case HAL_REO_CMD_FLUSH_QUEUE:
+	case HAL_REO_CMD_UNBLOCK_CACHE:
+	case HAL_REO_CMD_FLUSH_TIMEOUT_LIST:
+		return -EOPNOTSUPP;
+	default:
+		return -EINVAL;
+	}
+}
