+/* Replies need not echo a body. Bound every field read by the verbose logger. */
+static bool nss_if_log_has_payload(struct nss_if_msg *nim)
+{
+	uint32_t minimum;
+
+	switch (nim->cm.type) {
+	case NSS_IF_OPEN:
+		minimum = sizeof(nim->msg.open);
+		break;
+	case NSS_IF_LINK_STATE_NOTIFY:
+		minimum = sizeof(nim->msg.link_state_notify);
+		break;
+	case NSS_IF_MTU_CHANGE:
+		minimum = sizeof(nim->msg.mtu_change);
+		break;
+	case NSS_IF_MAC_ADDR_SET:
+		minimum = sizeof(nim->msg.mac_address_set);
+		break;
+	case NSS_IF_STATS:
+		minimum = sizeof(nim->msg.stats);
+		break;
+	case NSS_IF_ISHAPER_ASSIGN:
+	case NSS_IF_BSHAPER_ASSIGN:
+		minimum = sizeof(nim->msg.shaper_assign);
+		break;
+	case NSS_IF_ISHAPER_UNASSIGN:
+	case NSS_IF_BSHAPER_UNASSIGN:
+		minimum = sizeof(nim->msg.shaper_unassign);
+		break;
+	case NSS_IF_ISHAPER_CONFIG:
+	case NSS_IF_BSHAPER_CONFIG:
+		minimum = offsetof(struct nss_if_shaper_configure, config.response_type) +
+			  sizeof(nim->msg.shaper_configure.config.response_type);
+		break;
+	case NSS_IF_PAUSE_ON_OFF:
+		minimum = sizeof(nim->msg.pause_on_off);
+		break;
+	case NSS_IF_VSI_ASSIGN:
+		minimum = sizeof(nim->msg.vsi_assign);
+		break;
+	case NSS_IF_VSI_UNASSIGN:
+		minimum = sizeof(nim->msg.vsi_unassign);
+		break;
+	case NSS_IF_SET_NEXTHOP:
+		minimum = sizeof(nim->msg.set_nexthop);
+		break;
+	case NSS_IF_SET_IGS_NODE:
+	case NSS_IF_CLEAR_IGS_NODE:
+		minimum = sizeof(nim->msg.config_igs);
+		break;
+	default:
+		return true;
+	}
+	return nim->cm.len >= minimum;
+}
