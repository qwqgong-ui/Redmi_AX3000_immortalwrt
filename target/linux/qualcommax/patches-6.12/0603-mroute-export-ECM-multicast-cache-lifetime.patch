+static struct mfc6_cache *ip6mr_offload_cache_find(struct mr_table *mrt,
+						 const struct in6_addr *origin,
+						 const struct in6_addr *group)
+{
+	struct mfc6_cache *c, *found = NULL;
+	struct rhlist_head *next;
+
+	for (c = ip6mr_cache_find(mrt, origin, group); c;
+	     c = next ? container_of(next, struct mfc6_cache, _c.mnode) : NULL) {
+		next = rcu_dereference(c->_c.mnode.next);
+		if (c->_c.mfc_flags & MFC_DELETED)
+			continue;
+		if (found)
+			return ERR_PTR(-EOPNOTSUPP);
+		found = c;
+	}
+	return found ?: ERR_PTR(-ENOENT);
+}
+
+/* Caller holds mrt_lock and RCU. Keep a failed snapshot private. */
+static int ip6mr_offload_ifindexes(struct mr_table *mrt, struct mfc6_cache *c,
+				  u32 ifindexes[MAXMIFS], u32 *vif_mask)
+{
+	struct net_device *dev;
+	u32 mask = 0;
+	int count = 0, i;
+
+	if (c->_c.mfc_flags & MFC_DELETED)
+		return -ENOENT;
+	if (c->_c.mfc_parent >= MAXMIFS ||
+	    !vif_dev_read(&mrt->vif_table[c->_c.mfc_parent]))
+		return -ENODEV;
+	for (i = 0; i < MAXMIFS; i++) {
+		if (!c->_c.mfc_un.res.ttls[i] || c->_c.mfc_un.res.ttls[i] == 255)
+			continue;
+		/* NSS has no per-OIF TTL threshold in its multicast rule. */
+		if (c->_c.mfc_un.res.ttls[i] != 1)
+			return -EOPNOTSUPP;
+		dev = vif_dev_read(&mrt->vif_table[i]);
+		if (!dev)
+			return -ENODEV;
+		ifindexes[count++] = dev->ifindex;
+		mask |= BIT(i);
+	}
+	if (vif_mask)
+		*vif_mask = mask;
+	return count;
+}
+
+int ip6mr_find_mfc_entry(struct net *net, const struct in6_addr *origin,
+			const struct in6_addr *group, u32 capacity, u32 ifindexes[],
+			u64 *cookie)
+{
+	struct mr_table *mrt;
+	struct mfc6_cache *c;
+	u32 indices[MAXMIFS];
+	int count = -ENOENT;
+
+	if (!origin || !group || (!ifindexes && capacity))
+		return -EINVAL;
+	if (!net_eq(net, &init_net))
+		return -EOPNOTSUPP;
+	rcu_read_lock();
+	spin_lock_bh(&mrt_lock);
+	mrt = __ip6mr_get_table(net, RT6_TABLE_DFLT);
+	if (!mrt)
+		goto out;
+	c = ip6mr_offload_cache_find(mrt, origin, group);
+	if (IS_ERR(c)) {
+		count = PTR_ERR(c);
+		goto out;
+	}
+	count = ip6mr_offload_ifindexes(mrt, c, indices, NULL);
+	if (count >= 0 && (u32)count > capacity) {
+		count = -EINVAL;
+		goto out;
+	}
+	if (count > 0)
+		memcpy(ifindexes, indices, count * sizeof(indices[0]));
+	if (count >= 0 && cookie)
+		*cookie = c->_c.offload_cookie;
+out:
+	spin_unlock_bh(&mrt_lock);
+	rcu_read_unlock();
+	return count;
+}
+EXPORT_SYMBOL(ip6mr_find_mfc_entry);
+
+int ip6mr_mfc_stats_update(struct net *net, const struct in6_addr *origin,
+			 const struct in6_addr *group, u64 cookie, u64 packets_in,
+			 u64 bytes_in, u64 packets_out, u64 bytes_out)
+{
+	struct mr_table *mrt;
+	struct mfc6_cache *c;
+	struct vif_device *vif;
+	u32 indices[MAXMIFS], mask;
+	int ret = -ENOENT, i;
+
+	if (!origin || !group)
+		return -EINVAL;
+	if (!net_eq(net, &init_net))
+		return -EOPNOTSUPP;
+	rcu_read_lock();
+	spin_lock_bh(&mrt_lock);
+	mrt = __ip6mr_get_table(net, RT6_TABLE_DFLT);
+	if (!mrt)
+		goto out;
+	c = ip6mr_offload_cache_find(mrt, origin, group);
+	if (IS_ERR(c)) {
+		ret = PTR_ERR(c);
+		goto out;
+	}
+	if (!cookie || c->_c.offload_cookie != cookie) {
+		ret = -ESTALE;
+		goto out;
+	}
+	ret = ip6mr_offload_ifindexes(mrt, c, indices, &mask);
+	if (ret < 0)
+		goto out;
+	vif = &mrt->vif_table[c->_c.mfc_parent];
+	atomic_long_add(packets_in, &vif->pkt_in);
+	atomic_long_add(bytes_in, &vif->bytes_in);
+	atomic_long_add(packets_out, &c->_c.mfc_un.res.pkt);
+	atomic_long_add(bytes_out, &c->_c.mfc_un.res.bytes);
+	WRITE_ONCE(c->_c.mfc_un.res.lastuse, jiffies);
+	for (i = 0; i < MAXMIFS; i++) {
+		if (!(mask & BIT(i)))
+			continue;
+		vif = &mrt->vif_table[i];
+		atomic_long_add(packets_out, &vif->pkt_out);
+		atomic_long_add(bytes_out, &vif->bytes_out);
+	}
+	ret = 0;
+out:
+	spin_unlock_bh(&mrt_lock);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL(ip6mr_mfc_stats_update);
+
+bool ip6mr_register_mfc_event_offload_callback(ip6mr_mfc_event_offload_callback_t cb)
+{
+	bool registered = false;
+
+	if (!cb)
+		return false;
+	mutex_lock(&ip6mr_offload_mutex);
+	if (!rcu_access_pointer(ip6mr_offload_cb)) {
+		rcu_assign_pointer(ip6mr_offload_cb, cb);
+		registered = true;
+	}
+	mutex_unlock(&ip6mr_offload_mutex);
+	return registered;
+}
+EXPORT_SYMBOL(ip6mr_register_mfc_event_offload_callback);
+
+void ip6mr_unregister_mfc_event_offload_callback(void)
+{
+	mutex_lock(&ip6mr_offload_mutex);
+	RCU_INIT_POINTER(ip6mr_offload_cb, NULL);
+	synchronize_rcu();
+	mutex_unlock(&ip6mr_offload_mutex);
+}
+EXPORT_SYMBOL(ip6mr_unregister_mfc_event_offload_callback);
