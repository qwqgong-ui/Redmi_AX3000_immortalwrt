 			       ath11k_ahb_ext_grp_napi_poll);
+		irq_grp->napi_added = true;
 
 		for (j = 0; j < ATH11K_EXT_IRQ_NUM_MAX; j++) {
 			if (!nss_offload && ab->hw_params.ring_mask->tx[i] & BIT(j)) {
@@ -613,6 +658,10 @@
 
 			irq = platform_get_irq_byname(ab->pdev,
 						      irq_name[irq_idx]);
