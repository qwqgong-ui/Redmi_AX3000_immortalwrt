@@ -590,6 +593,36 @@
 EXPORT_SYMBOL_GPL(br_fdb_update_unregister_notify);
 /* QCA NSS ECM support - End */
 
+/* Invalidate the old remote identity before a replaced entry is advertised. */
+static void br_fdb_notify_move(struct net_bridge *br,
+			       const struct net_bridge_fdb_entry *fdb,
+			       struct net_bridge_port *orig_dst, bool orig_local)
+{
+	struct net_bridge_port *dst = READ_ONCE(fdb->dst);
+	bool is_local = test_bit(BR_FDB_LOCAL, &fdb->flags);
+	struct br_fdb_event event = {
+		.br = br,
+	};
+
+	if (!orig_dst || orig_local || (orig_dst == dst && !is_local))
+		return;
+
+	ether_addr_copy(event.addr, fdb->key.addr.addr);
+	if (!dst || is_local) {
+		/* The remote entry no longer exists; DEL describes its old port.
+		 * Keep the move chain's two non-NULL remote ports contract.
+		 */
+		event.dev = orig_dst->dev;
+		atomic_notifier_call_chain(&br_fdb_notifier_list,
+					   BR_FDB_EVENT_DEL, &event);
+		return;
+	}
+
+	event.orig_dev = orig_dst->dev;
+	event.dev = dst->dev;
+	atomic_notifier_call_chain(&br_fdb_update_notifier_list, 0, &event);
+}
