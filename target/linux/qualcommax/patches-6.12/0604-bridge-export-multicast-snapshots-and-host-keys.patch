+int br_mcast_offload_snapshot_port(struct net_device *dev,
+		struct br_mcast_offload_member members[], u32 member_capacity,
+		struct br_mcast_offload_source sources[], u32 source_capacity,
+		struct br_mcast_offload_snapshot *snapshot)
+{
+	struct net_bridge_group_src *src;
+	struct net_bridge_port_group *pg;
+	struct net_bridge_port *p;
+	struct net_bridge *br;
+	u32 member_count = 0, source_count = 0, i = 0, j = 0;
+	int ret = -ENODEV;
+
+	if (!snapshot || (!members && member_capacity) ||
+	    (!sources && source_capacity))
+		return -EINVAL;
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (!p)
+		goto out;
+	br = p->br;
+	spin_lock_bh(&br->multicast_lock);
+	hlist_for_each_entry(pg, &p->mglist, mglist) {
+		if (pg->key.addr.proto != htons(ETH_P_IP)
+#if IS_ENABLED(CONFIG_IPV6)
+		    && pg->key.addr.proto != htons(ETH_P_IPV6)
+#endif
+		   )
+			continue;
+		member_count++;
+		hlist_for_each_entry(src, &pg->src_list, node)
+			source_count++;
+	}
+	memset(snapshot, 0, sizeof(*snapshot));
+	snapshot->seq = atomic64_read(&br->mcast_offload_seq);
+	snapshot->bridge_ifindex = br->dev->ifindex;
+	snapshot->snooping = br_opt_get(br, BROPT_MULTICAST_ENABLED);
+	snapshot->vlan_snooping = br_opt_get(br, BROPT_MCAST_VLAN_SNOOPING_ENABLED);
+	snapshot->router_ipv4 = !hlist_unhashed(&p->multicast_ctx.ip4_rlist);
+#if IS_ENABLED(CONFIG_IPV6)
+	snapshot->router_ipv6 = !hlist_unhashed(&p->multicast_ctx.ip6_rlist);
+#endif
+	snapshot->member_count = member_count;
+	snapshot->source_count = source_count;
+	/* The per-port router booleans describe the global context. Do not
+	 * misrepresent distinct per-VLAN router sets as one shared context.
+	 */
+	if (snapshot->vlan_snooping) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (member_count > member_capacity || source_count > source_capacity) {
+		ret = -E2BIG;
+		goto unlock;
+	}
+	hlist_for_each_entry(pg, &p->mglist, mglist) {
+		struct br_mcast_offload_member *member;
+
+		if (pg->key.addr.proto != htons(ETH_P_IP)
+#if IS_ENABLED(CONFIG_IPV6)
+		    && pg->key.addr.proto != htons(ETH_P_IPV6)
+#endif
+		   )
+			continue;
+		member = &members[i++];
+		memset(member, 0, sizeof(*member));
+		member->addr = pg->key.addr;
+		ether_addr_copy(member->host_mac, pg->eth_addr);
+		member->filter_mode = pg->filter_mode;
+		if (pg->host_specific)
+			member->flags |= BR_MCAST_OFFLOAD_HOST_SPECIFIC;
+		if (pg->flags & MDB_PG_FLAGS_PERMANENT)
+			member->flags |= BR_MCAST_OFFLOAD_PERMANENT;
+		if (pg->flags & MDB_PG_FLAGS_STAR_EXCL)
+			member->flags |= BR_MCAST_OFFLOAD_STAR_EXCL;
+		if (pg->flags & MDB_PG_FLAGS_BLOCKED)
+			member->flags |= BR_MCAST_OFFLOAD_BLOCKED;
+		member->source_offset = j;
+		hlist_for_each_entry(src, &pg->src_list, node) {
+			struct br_mcast_offload_source *source = &sources[j++];
+
+			memset(source, 0, sizeof(*source));
+			source->addr = src->addr;
+			/* EXCLUDE's X timers allow traffic; only expired Y sources
+			 * are excluded. INCLUDE's permanent sources may lack timers.
+			 */
+			source->blocked = pg->filter_mode == MCAST_EXCLUDE &&
+					  !timer_pending(&src->timer);
+			member->source_count++;
+		}
+	}
+	ret = 0;
+unlock:
+	spin_unlock_bh(&br->multicast_lock);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_snapshot_port);
