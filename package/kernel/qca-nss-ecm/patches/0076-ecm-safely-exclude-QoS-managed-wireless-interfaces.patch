+/* At pending-set time the connection is already in the DB. A concurrent
+ * policy writer either blocks it here or finds it during targeted retirement;
+ * ECM's existing deferred deceleration covers a CREATE still awaiting ACK.
+ */
+bool ecm_interface_connection_accel_allowed(struct ecm_db_connection_instance *ci)
+{
+	if (!atomic_read(&ecm_interface_accel_denied_list_count))
+		return true;
+	return !ecm_interface_denied_connection(ci, 0);
+}
+
+static void ecm_interface_denied_defunct(struct net_device *dev)
+{
+	struct ecm_db_connection_instance *ci, *next;
+
+	ci = ecm_db_connections_get_and_ref_first();
+	while (ci) {
+		next = ecm_db_connection_get_and_ref_next(ci);
+		if (ecm_interface_denied_connection(ci, dev->ifindex))
+			ecm_db_connection_make_defunct(ci);
+		ecm_db_connection_deref(ci);
+		ci = next;
+	}
+}
