+/************************************************************************
+ *
+ * function called to get the PPPoE channel addressing
+ * NOTE: This function returns a HOLD to the netdevice
+ *
+ ***********************************************************************/
+static int pppoe_get_addressing(struct ppp_channel *chan,
+				 struct pppoe_opt *addressing)
+{
+	struct sock *sk = (struct sock *)chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+	int err = -EAGAIN;
+
+	local_bh_disable();
+	bh_lock_sock(sk);
+	/* User socket operations mutate the session while holding the user lock. */
+	if (sock_owned_by_user(sk))
+		goto out;
+	err = -ENODEV;
+	if (sock_flag(sk, SOCK_DEAD) || !(sk->sk_state & PPPOX_CONNECTED) ||
+	    !po->pppoe_dev)
+		goto out;
+	addressing->dev = po->pppoe_dev;
+	addressing->ifindex = po->pppoe_ifindex;
+	addressing->pa = po->pppoe_pa;
+	dev_hold(addressing->dev);
+	err = 0;
+out:
+	bh_unlock_sock(sk);
+	local_bh_enable();
+	return err;
+}
