+static void br_mcast_offload_notify(struct net_device *dev,
+				   const struct br_ip *addr,
+				   const struct net_bridge_port_group *pg,
+				   int port_ifindex, int type)
+{
+	struct br_mdb_event event = { .dev = dev };
+	struct net_bridge *br = netdev_priv(dev);
+	struct net_bridge_port *p;
+
+	lockdep_assert_held(&br->multicast_lock);
+	event.seq = atomic64_inc_return(&br->mcast_offload_seq);
+	event.port_ifindex = port_ifindex;
+	if (addr) {
+		event.addr = *addr;
+		event.proto = addr->proto;
+		if (addr->proto == htons(ETH_P_IP))
+			event.group.ip = addr->dst.ip4;
+#if IS_ENABLED(CONFIG_IPV6)
+		else if (addr->proto == htons(ETH_P_IPV6))
+			event.group.in6 = addr->dst.ip6;
+#endif
+	}
+	if (pg) {
+		ether_addr_copy(event.host_mac, pg->eth_addr);
+		event.host_specific = pg->host_specific;
+	}
+	/* Revert software conversion before notifying asynchronous consumers.
+	 * A new hardware table must commit against this sequence to suppress it.
+	 */
+	rcu_read_lock();
+	list_for_each_entry_rcu(p, &br->port_list, list)
+		WRITE_ONCE(p->mcast_hw_to_unicast, false);
+	atomic_notifier_call_chain(&br_mcast_offload_chain, type, &event);
+	rcu_read_unlock();
+}
