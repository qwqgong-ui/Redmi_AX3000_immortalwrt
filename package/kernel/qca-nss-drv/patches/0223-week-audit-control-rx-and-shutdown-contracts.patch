+/* RTNL remains held through halt and IRQ/NAPI drain. No host ring restore,
+ * firmware CLOSE, callback reclaim or shared-memory free belongs to shutdown.
+ */
+void nss_data_plane_shutdown_prepare(struct nss_ctx_instance *ctx)
+{
+	int i;
+
+	ASSERT_RTNL();
+	for (i = NSS_DP_START_IFNUM; i < NSS_DP_MAX_INTERFACES; i++) {
+		struct nss_data_plane_param *p = &nss_data_plane_params[i];
+
+		if (p->nss_ctx != ctx || !p->dpc.dev)
+			continue;
+		WRITE_ONCE(p->attached, false);
+		WRITE_ONCE(p->notify_open, 0);
+		netif_tx_disable(p->dpc.dev);
+	}
+	synchronize_net();
+}
+
+void nss_data_plane_shutdown_complete(struct nss_ctx_instance *ctx)
+{
+	int i;
+
+	ASSERT_RTNL();
+	for (i = NSS_DP_START_IFNUM; i < NSS_DP_MAX_INTERFACES; i++) {
+		struct nss_data_plane_param *p = &nss_data_plane_params[i];
+
+		if (p->nss_ctx != ctx || !p->dpc.dev || !p->may_own_dma)
+			continue;
+		if (nss_dp_quiesce_dma(p->dpc.dev))
+			pr_err("nss: dataplane %d shutdown DMA stop unconfirmed\n", i);
+		else
+			p->may_own_dma = false;
+	}
+}
