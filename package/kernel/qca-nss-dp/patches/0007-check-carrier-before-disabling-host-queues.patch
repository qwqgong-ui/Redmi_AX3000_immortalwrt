 /*
+ * The descriptor length contains control bits and may split one mapping
+ * between two buffers. Keep DMA ownership in the matching host pool entry.
+ */
+void syn_dp_rx_unmap_buffer(struct syn_dp_info_rx *rx_info, uint32_t index)
+{
+	struct syn_dp_rx_buf *buffer = &rx_info->rx_buf_pool[index];
+
+	if (!buffer->dma_len)
+		return;
+	if (buffer->map_page)
+		dma_unmap_page(rx_info->dev, buffer->dma_addr,
+			       buffer->dma_len, DMA_FROM_DEVICE);
+	else
+		dma_unmap_single(rx_info->dev, buffer->dma_addr,
+				 buffer->dma_len, DMA_FROM_DEVICE);
+	buffer->dma_len = 0;
+	buffer->dma_addr = 0;
+}
