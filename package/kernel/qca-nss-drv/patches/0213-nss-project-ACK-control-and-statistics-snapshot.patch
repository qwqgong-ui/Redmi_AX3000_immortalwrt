 };
 
@@ -385,9 +447,30 @@
  */
 void nss_project_unregister_sysctl(void)
 {
+	struct nss_worker_thread_stats *stats;
+	uint32_t threads;
+	int i;
+
 	if (nss_project_header) {
 		unregister_sysctl_table(nss_project_header);
+		nss_project_header = NULL;
+	}
+	mutex_lock(&nss_project_wt_mutex);
+	for (i = 0; i < nss_top_main.num_nss; i++) {
+		struct nss_ctx_instance *ctx = &nss_top_main.nss[i];
+
+		nss_control_close(ctx, NSS_CONTROL_PROJECT, NSS_PROJECT_INTERFACE);
+		spin_lock_bh(&nss_top_main.stats_lock);
+		nss_project_wt_state[i] = -1;
+		stats = ctx->wt_stats;
+		threads = ctx->worker_thread_count;
+		ctx->wt_stats = NULL;
+		ctx->worker_thread_count = ctx->irq_count = 0;
+		spin_unlock_bh(&nss_top_main.stats_lock);
+		/* NOTIFY only accesses the table while holding the same lock. */
+		nss_project_free_wt_stats(stats, threads);
 	}
+	mutex_unlock(&nss_project_wt_mutex);
 }
 
