+static void ath11k_dp_reo_aging_read_locked(struct ath11k_base *ab, u32 raw[4])
+{
+	lockdep_assert_held(&ab->base_lock);
+	lockdep_assert_held(&ab->dp.reo_cmd_lock);
+	raw[0] = ath11k_hif_read32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				 ab->hw_params.regs->hal_reo1_aging_thresh_ix_0);
+	raw[1] = ath11k_hif_read32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				 ab->hw_params.regs->hal_reo1_aging_thresh_ix_1);
+	raw[2] = ath11k_hif_read32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				 ab->hw_params.regs->hal_reo1_aging_thresh_ix_2);
+	raw[3] = ath11k_hif_read32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				 ab->hw_params.regs->hal_reo1_aging_thresh_ix_3);
+}
+
+int ath11k_dp_reo_aging_read(struct ath11k *ar, u64 *epoch, u32 raw[4])
+{
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_dp *dp = &ab->dp;
+	int ret = 0;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	/* This diagnostic has no low-power entry/exit contract. */
+	if (IS_ENABLED(CONFIG_SUSPEND) || ab->hw_params.supports_suspend)
+		return -EOPNOTSUPP;
+	if (ar->state != ATH11K_STATE_ON)
+		return -ENETDOWN;
+	spin_lock_bh(&ab->base_lock);
+	spin_lock_bh(&dp->reo_cmd_lock);
+	/* The command close path holds this lock before disabling HIF/IRQs.
+	 * This is the existing REO MMIO admission gate, not a DMA halt fence.
+	 */
+	if (!dp->reo_cmd_accepting ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_QMI_FAIL, &ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags) ||
+	    READ_ONCE(ab->nss.ownership_uncertain)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	*epoch = dp->reo_cmd_epoch;
+	ath11k_dp_reo_aging_read_locked(ab, raw);
+unlock:
+	spin_unlock_bh(&dp->reo_cmd_lock);
+	spin_unlock_bh(&ab->base_lock);
+	return ret;
+}
+
+int ath11k_dp_reo_aging_replace(struct ath11k *ar, u64 epoch,
+			      const u32 expected[4], const u32 desired[4])
+{
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_dp *dp = &ab->dp;
+	u32 offsets[4];
+	u32 observed[4];
+	int i, ret = 0;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	if (IS_ENABLED(CONFIG_SUSPEND) || ab->hw_params.supports_suspend)
+		return -EOPNOTSUPP;
+	/* A bounded experiment around the driver's 40000 default; do not
+	 * accept zero, disable aging, or persist a different boot default.
+	 */
+	for (i = 0; i < 4; i++)
+		if (desired[i] < HAL_DEFAULT_REO_TIMEOUT_USEC || desired[i] > 200000)
+			return -EINVAL;
+	if (ar->state != ATH11K_STATE_ON)
+		return -ENETDOWN;
+	spin_lock_bh(&ab->base_lock);
+	spin_lock_bh(&dp->reo_cmd_lock);
+	if (!dp->reo_cmd_accepting || epoch != dp->reo_cmd_epoch ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_QMI_FAIL, &ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags) ||
+	    READ_ONCE(ab->nss.ownership_uncertain)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	ath11k_dp_reo_aging_read_locked(ab, observed);
+	if (memcmp(observed, expected, sizeof(observed))) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
+	/* Global per-SOC AC thresholds, not a per-peer change. Four writes
+	 * would not be an atomic hardware transaction; leave unchanged ACs
+	 * untouched and report any readback mismatch instead of success.
+	 */
+	offsets[0] = ab->hw_params.regs->hal_reo1_aging_thresh_ix_0;
+	offsets[1] = ab->hw_params.regs->hal_reo1_aging_thresh_ix_1;
+	offsets[2] = ab->hw_params.regs->hal_reo1_aging_thresh_ix_2;
+	offsets[3] = ab->hw_params.regs->hal_reo1_aging_thresh_ix_3;
+	for (i = 0; i < 4; i++)
+		if (observed[i] != desired[i])
+			ath11k_hif_write32(ab, HAL_SEQ_WCSS_UMAC_REO_REG + offsets[i],
+					   desired[i]);
+	ath11k_dp_reo_aging_read_locked(ab, observed);
+	if (memcmp(observed, desired, sizeof(observed)))
+		ret = -EIO;
+unlock:
+	spin_unlock_bh(&dp->reo_cmd_lock);
+	spin_unlock_bh(&ab->base_lock);
+	return ret;
 }
 
