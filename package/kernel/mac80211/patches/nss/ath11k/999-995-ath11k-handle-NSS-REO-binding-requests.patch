+
+int ath11k_dp_reo_queue_rebind(struct ath11k *ar, struct ath11k_peer *expected_peer,
+			     struct ath11k_reo_queue *queue, u8 tid, u64 expected_epoch)
+{
+	struct ath11k_base *ab = ar->ab;
+	struct dp_rx_tid *rx_tid;
+	u64 epoch;
+	u16 window;
+	int ret;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	if (ar->state != ATH11K_STATE_ON && ar->state != ATH11K_STATE_RESTARTED)
+		return -ESHUTDOWN;
+	if (tid > IEEE80211_NUM_TIDS)
+		return -EINVAL;
+	spin_lock_bh(&ab->base_lock);
+	if (!ab->nss.reoq_admitting || ab->nss.quiescing) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	if (ath11k_peer_find(ar, expected_peer->vdev_id, expected_peer->addr) != expected_peer ||
+	    !expected_peer->dp_setup_done) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	rx_tid = &expected_peer->rx_tid[tid];
+	if (!rx_tid->active || rx_tid->reo_queue != queue ||
+	    READ_ONCE(queue->retiring) ||
+	    READ_ONCE(queue->phase) != ATH11K_REO_QUEUE_PUBLISHED) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	spin_lock_bh(&ab->dp.reo_cmd_lock);
+	ret = ab->dp.reo_cmd_epoch == expected_epoch ? 0 : -ESHUTDOWN;
+	spin_unlock_bh(&ab->dp.reo_cmd_lock);
+	if (ret)
+		goto unlock;
+	ret = ath11k_dp_reo_wmi_begin(ab, queue, false, &epoch);
+	if (ret)
+		goto unlock;
+	ath11k_peer_get(expected_peer);
+	ath11k_dp_reo_queue_get(queue);
+	window = rx_tid->ba_win_sz;
+	spin_unlock_bh(&ab->base_lock);
+
+	/* The notification carries no negotiated window or SSN. Republish the
+	 * existing immutable address only; do not issue HAL UPDATE or allocate DMA.
+	 */
+	ret = ath11k_wmi_peer_rx_reorder_queue_setup(ar, expected_peer->vdev_id,
+						  expected_peer->addr, queue->paddr,
+						  tid, 1, window);
+	return ath11k_dp_reo_wmi_finish(ar, expected_peer, queue, tid, false, epoch, ret);
+unlock:
+	spin_unlock_bh(&ab->base_lock);
 	return ret;
 }
 
