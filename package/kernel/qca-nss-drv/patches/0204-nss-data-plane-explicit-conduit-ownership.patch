 /*
--- /dev/null
+++ b/exports/nss_data_plane_api.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __NSS_DATA_PLANE_API_H
+#define __NSS_DATA_PLANE_API_H
+
+enum nss_data_plane_ownership {
+    NSS_DATA_PLANE_HOST,
+    NSS_DATA_PLANE_READY,
+    NSS_DATA_PLANE_UNCERTAIN,
+};
+
+/* Caller holds RTNL and quiesces all rules referring to this conduit.
+ * A failed detach preserves ownership and forbids freeing its callbacks.
+ */
+int nss_data_plane_attach(struct net_device *dev);
+int nss_data_plane_detach(struct net_device *dev);
+int nss_data_plane_state(struct net_device *dev);
+#endif
