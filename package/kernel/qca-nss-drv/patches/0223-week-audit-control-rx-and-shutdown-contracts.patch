+
+static void nss_control_base_advance_locked(struct nss_ctx_instance *ctx, uint32_t if_num)
+{
+	uint64_t *generation = &nss_control_base_generation[ctx->id][if_num];
+
+	/* Exhaustion closes admission permanently, without recycling an old lease. */
+	if (*generation != U64_MAX)
+		++*generation;
+}
+
+void nss_control_register_dp(struct nss_ctx_instance *ctx, uint32_t if_num,
+			    const struct nss_subsystem_dataplane_register *update)
+{
+	struct nss_subsystem_dataplane_register *reg;
+	uint64_t generation;
+
+	BUG_ON(!nss_control_valid(ctx, NSS_CONTROL_BASE_IF, if_num));
+	spin_lock_bh(&nss_control_lock);
+	reg = &ctx->subsys_dp_register[if_num];
+	BUG_ON(reg->ndev && reg->ndev != update->ndev);
+	if (!reg->ndev && update->ndev) {
+		nss_control_base_advance_locked(ctx, if_num);
+		nss_control_drop_locked(ctx, NSS_CONTROL_BASE_IF, if_num);
+	}
+	/* Preserve type and xmit_cb: several clients set them independently. */
+	reg->cb = update->cb;
+	reg->ext_cb = update->ext_cb;
+	reg->app_data = update->app_data;
+	reg->features = update->features;
+	WRITE_ONCE(reg->ndev, update->ndev);
+	generation = nss_control_base_generation[ctx->id][if_num];
+	nss_control_registered[NSS_CONTROL_BASE_IF][ctx->id][if_num] =
+		update->ndev && generation && generation != U64_MAX &&
+		!nss_control_closing[ctx->id];
+	spin_unlock_bh(&nss_control_lock);
+}
+
+void nss_control_unregister_dp(struct nss_ctx_instance *ctx, uint32_t if_num)
+{
+	struct nss_subsystem_dataplane_register *reg;
+
+	BUG_ON(!nss_control_valid(ctx, NSS_CONTROL_BASE_IF, if_num));
+	spin_lock_bh(&nss_control_lock);
+	nss_control_registered[NSS_CONTROL_BASE_IF][ctx->id][if_num] = false;
+	nss_control_base_advance_locked(ctx, if_num);
+	nss_control_drop_locked(ctx, NSS_CONTROL_BASE_IF, if_num);
+	reg = &ctx->subsys_dp_register[if_num];
+	reg->cb = NULL;
+	reg->ext_cb = NULL;
+	reg->app_data = NULL;
+	WRITE_ONCE(reg->ndev, NULL);
+	reg->features = 0;
+	reg->type = 0;
+	/* xmit_cb has its own registration/teardown API. */
+	spin_unlock_bh(&nss_control_lock);
+}
+
+uint64_t nss_control_base_lease(struct nss_ctx_instance *ctx, uint32_t if_num)
+{
+	uint64_t generation = 0;
+
+	if (!nss_control_valid(ctx, NSS_CONTROL_BASE_IF, if_num))
+		return 0;
+	spin_lock_bh(&nss_control_lock);
+	if (nss_control_registered[NSS_CONTROL_BASE_IF][ctx->id][if_num] &&
+	    !nss_control_closing[ctx->id])
+		generation = nss_control_base_generation[ctx->id][if_num];
+	spin_unlock_bh(&nss_control_lock);
+	return generation;
+}
+
+static void nss_control_revoke(struct nss_ctx_instance *ctx, int family, int if_num)
+{
+	unsigned int index;
+
+	if (!ctx || ctx->id >= NSS_CORE_MAX)
+		return;
+	spin_lock_bh(&nss_control_lock);
+	if (family < 0) {
+		nss_control_closing[ctx->id] = true;
+		for (index = 0; index < NSS_CONTROL_FAMILY_MAX; index++)
+			memset(nss_control_registered[index][ctx->id], 0,
+			       sizeof(nss_control_registered[index][ctx->id]));
+		for (index = 0; index < NSS_MAX_NET_INTERFACES; index++)
+			nss_control_base_advance_locked(ctx, index);
+	} else {
+		nss_control_registered[family][ctx->id][if_num] = false;
+		if (family == NSS_CONTROL_BASE_IF)
+			nss_control_base_advance_locked(ctx, if_num);
+	}
+	nss_control_drop_locked(ctx, family, if_num);
 	spin_unlock_bh(&nss_control_lock);
 	/* This also drains a callback which already claimed and removed its entry. */
 	synchronize_net();
@@ -119,9 +201,10 @@
 	synchronize_net();
 }
 
-nss_tx_status_t nss_control_send(struct nss_ctx_instance *ctx, void *msg,
-			       uint32_t size, uint32_t buffer_size,
-			       enum nss_control_family family, uint32_t *cookie)
+static nss_tx_status_t nss_control_send_generation(struct nss_ctx_instance *ctx, void *msg,
+				       uint32_t size, uint32_t buffer_size,
+				       enum nss_control_family family, uint64_t generation,
+				       uint32_t *cookie)
 {
