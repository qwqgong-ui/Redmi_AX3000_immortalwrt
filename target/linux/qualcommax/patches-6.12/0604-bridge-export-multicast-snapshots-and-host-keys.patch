+static int br_mcast_offload_ports(struct net_bridge_mcast *brmctx,
+		struct net_bridge_mdb_entry *mp, u32 ifindexes[], u32 capacity)
+{
+	struct net_bridge_port_group *pg = mlock_dereference(mp->ports, brmctx->br);
+	struct hlist_node *rp;
+	bool allow_include = true;
+	int count = 0;
+
+	if (br_multicast_should_handle_mode(brmctx, mp->addr.proto) &&
+	    br_multicast_is_star_g(&mp->addr))
+		allow_include = false;
+#if IS_ENABLED(CONFIG_IPV6)
+	if (mp->addr.proto == htons(ETH_P_IPV6))
+		rp = hlist_first_rcu(&brmctx->ip6_mc_router_list);
+	else
+#endif
+		rp = hlist_first_rcu(&brmctx->ip4_mc_router_list);
+	while (pg || rp) {
+		struct net_bridge_port *lport = pg ? pg->key.port : NULL;
+		struct net_bridge_port *rport = NULL, *port;
+		struct net_bridge_port_group *override;
+		struct net_bridge_mcast_port *rctx;
+		bool listener = false, router = false;
+
+		if (rp) {
+#if IS_ENABLED(CONFIG_IPV6)
+			if (mp->addr.proto == htons(ETH_P_IPV6))
+				rctx = hlist_entry(rp, struct net_bridge_mcast_port, ip6_rlist);
+			else
+#endif
+				rctx = hlist_entry(rp, struct net_bridge_mcast_port, ip4_rlist);
+			rport = rctx->port;
+		}
+		port = (unsigned long)lport > (unsigned long)rport ? lport : rport;
+		override = br_multicast_port_static_override(mp, port);
+		while (pg && pg->key.port == port) {
+			if ((!override || pg == override) &&
+			    !(!allow_include && pg->filter_mode == MCAST_INCLUDE) &&
+			    !(pg->flags & MDB_PG_FLAGS_BLOCKED))
+				listener = true;
+			pg = mlock_dereference(pg->next, brmctx->br);
+		}
+		if (rport == port) {
+			router = true;
+			rp = hlist_next_rcu(rp);
+		}
+		if ((!listener && !router) || port->state != BR_STATE_FORWARDING)
+			continue;
+		if ((port->flags & BR_MULTICAST_TO_UNICAST) &&
+		    !READ_ONCE(port->mcast_hw_to_unicast))
+			return -EAGAIN;
+		if (ifindexes) {
+			if ((u32)count >= capacity)
+				return -E2BIG;
+			ifindexes[count] = port->dev->ifindex;
+		}
+		count++;
+	}
+	return count;
+}
