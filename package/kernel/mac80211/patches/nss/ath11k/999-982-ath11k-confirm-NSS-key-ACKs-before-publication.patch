+void ath11k_nss_key_recover(struct ath11k_vif *arvif, struct ath11k_peer *peer,
+			    struct ath11k_nss_peer_state *state)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	struct wireless_dev *wdev;
+	bool stop = false;
+	bool wait_delete = false;
+	int ret = 0;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	if (!state)
+		return;
+	spin_lock_bh(&ab->base_lock);
+	if (!arvif->nss.key_failed &&
+	    !test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags)) {
+		WRITE_ONCE(arvif->nss.key_failed, true);
+		/* Only delete the instance retained by this key operation. */
+		if (state->peer == peer && peer->nss.state == state &&
+		    ath11k_peer_find(ar, state->vdev_id, state->addr) == peer)
+			ret = ath11k_nss_peer_submit_delete(ab, state);
+		wait_delete = !ret && state->delete_submitted;
+		stop = true;
+	}
+	spin_unlock_bh(&ab->base_lock);
+	if (!stop)
+		return;
+	/* Stop asynchronously outside base_lock. This disconnects STA or stops
+	 * AP, but does not recreate the VDEV: keep the gate until interface
+	 * removal and a fresh create. Never reset hardware and reinstall an old
+	 * key with unknown transmit/RX PN as an error rollback.
+	 */
+	wdev = ieee80211_vif_to_wdev_relaxed(arvif->vif);
+	if (wdev)
+		cfg80211_stop_iface(ar->hw->wiphy, wdev, GFP_KERNEL);
+	if (wait_delete) {
+		if (!wait_for_completion_timeout(&state->deleted,
+						 msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS)))
+			ret = -ETIMEDOUT;
+		else
+			ret = READ_ONCE(state->delete_result);
+	}
+	ath11k_warn(ab, "NSS partial key state stopped vdev %u; interface recreation required (peer cleanup %d)\n",
+		    arvif->vdev_id, ret);
 }
 
