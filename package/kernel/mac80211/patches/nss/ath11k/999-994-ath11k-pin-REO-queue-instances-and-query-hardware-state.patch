+static void ath11k_dp_reo_query_complete(struct ath11k_reo_query *query,
+					 const struct hal_reo_status *status)
+{
+	query->result.status = *status;
+	query->result.header_valid = true;
+	query->result.payload_valid = status->uniform_hdr.cmd_status == HAL_REO_CMD_SUCCESS &&
+				      status->payload_valid;
+	query->result.error = query->result.payload_valid ? 0 :
+		status->uniform_hdr.cmd_status == HAL_REO_CMD_SUCCESS ? -EMSGSIZE : -EIO;
+	complete(&query->done);
+}
