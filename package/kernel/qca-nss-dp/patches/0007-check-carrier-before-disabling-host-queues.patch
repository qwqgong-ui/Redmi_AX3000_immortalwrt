+	buffer->dma_addr = address;
+	buffer->dma_len = length;
+	buffer->mapped = true;
+	desc = tx_info->tx_desc + index;
+	desc->buffer1 = address;
+	if (length <= SYN_DP_MAX_DESC_BUFF_LEN) {
