@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: ISC */
+#include "nss_tx_rx_common.h"
+#include "nss_control.h"
+
+struct nss_control_request {
+	struct list_head list;
+	uint32_t cookie;
+	uint32_t core_id;
+	uint32_t if_num;
+	uint32_t type;
+	enum nss_control_family family;
+	nss_ptr_t callback;
+	nss_ptr_t app_data;
+	unsigned char original[];
+};
+
+static LIST_HEAD(nss_control_requests);
+static DEFINE_SPINLOCK(nss_control_lock);
+static atomic64_t nss_control_sequence = ATOMIC64_INIT(0);
+static bool nss_control_closing[NSS_CORE_MAX];
+static bool nss_control_registered[NSS_CONTROL_FAMILY_MAX][NSS_CORE_MAX][NSS_MAX_NET_INTERFACES];
+
+/* A reply delivered to another subsystem after interface reuse must not call
+ * a client callback or interpret its wire cookie as a host pointer.
+ */
+static void nss_control_wire_callback(void *data, struct nss_cmn_msg *cm)
+{
+	(void)data;
+	(void)cm;
+}
+
+static bool nss_control_valid(struct nss_ctx_instance *ctx,
+			      enum nss_control_family family, uint32_t if_num)
+{
+	return ctx && (uint32_t)ctx->id < NSS_CORE_MAX &&
+	       (unsigned int)family < NSS_CONTROL_FAMILY_MAX &&
+	       if_num < NSS_MAX_NET_INTERFACES;
+}
+
+void nss_control_init_core(struct nss_ctx_instance *ctx)
+{
+	if (!ctx || ctx->id >= NSS_CORE_MAX)
+		return;
+	spin_lock_bh(&nss_control_lock);
+	nss_control_closing[ctx->id] = false;
+	spin_unlock_bh(&nss_control_lock);
+}
+
+bool nss_control_open(struct nss_ctx_instance *ctx, enum nss_control_family family,
+		      uint32_t if_num)
+{
+	bool opened = false;
+
+	if (!nss_control_valid(ctx, family, if_num))
+		return false;
+	spin_lock_bh(&nss_control_lock);
+	if (!nss_control_closing[ctx->id]) {
+		nss_control_registered[family][ctx->id][if_num] = true;
+		opened = true;
+	}
+	spin_unlock_bh(&nss_control_lock);
+	return opened;
+}
+
+static void nss_control_revoke(struct nss_ctx_instance *ctx, int family, int if_num)
+{
+	struct nss_control_request *request, *next;
+	unsigned int index;
+
+	if (!ctx || ctx->id >= NSS_CORE_MAX)
+		return;
+	spin_lock_bh(&nss_control_lock);
+	if (family < 0) {
+		nss_control_closing[ctx->id] = true;
+		for (index = 0; index < NSS_CONTROL_FAMILY_MAX; index++)
+			memset(nss_control_registered[index][ctx->id], 0,
+			       sizeof(nss_control_registered[index][ctx->id]));
+	} else {
+		nss_control_registered[family][ctx->id][if_num] = false;
+	}
+	list_for_each_entry_safe(request, next, &nss_control_requests, list) {
+		if (request->core_id != ctx->id ||
+		    (family >= 0 && (request->family != (enum nss_control_family)family ||
+				    request->if_num != (uint32_t)if_num)))
+			continue;
+		list_del(&request->list);
+		kfree(request);
+	}
+	spin_unlock_bh(&nss_control_lock);
+	/* This also drains a callback which already claimed and removed its entry. */
+	synchronize_net();
+}
+
+void nss_control_close(struct nss_ctx_instance *ctx, enum nss_control_family family,
+		       uint32_t if_num)
+{
+	if (nss_control_valid(ctx, family, if_num))
+		nss_control_revoke(ctx, family, if_num);
+}
+
+void nss_control_close_core(struct nss_ctx_instance *ctx)
+{
+	nss_control_revoke(ctx, -1, -1);
+}
+
+void nss_control_cancel(uint32_t cookie)
+{
+	struct nss_control_request *request, *next;
+
+	spin_lock_bh(&nss_control_lock);
+	list_for_each_entry_safe(request, next, &nss_control_requests, list) {
+		if (request->cookie != cookie)
+			continue;
+		list_del(&request->list);
+		kfree(request);
+		break;
+	}
+	spin_unlock_bh(&nss_control_lock);
+	synchronize_net();
+}
+
+nss_tx_status_t nss_control_send(struct nss_ctx_instance *ctx, void *msg,
+			       uint32_t size, uint32_t buffer_size,
+			       enum nss_control_family family, uint32_t *cookie)
+{
+	struct nss_cmn_msg *cm = msg;
+	struct nss_control_request *request = NULL;
+	nss_ptr_t saved_cb = cm->cb, saved_data = cm->app_data;
+	nss_tx_status_t status = NSS_TX_FAILURE_NOT_READY;
+	uint64_t sequence;
+
+	if (cookie)
+		*cookie = 0;
+	if (!nss_control_valid(ctx, family, cm->interface) ||
+	    size < sizeof(*cm) || size > buffer_size)
+		return NSS_TX_FAILURE_BAD_PARAM;
+	if (cm->cb || family == NSS_CONTROL_DYNAMIC) {
+		request = kzalloc(sizeof(*request) + size, GFP_ATOMIC);
+		if (!request)
+			return NSS_TX_FAILURE;
+		request->core_id = ctx->id;
+		request->if_num = cm->interface;
+		request->type = cm->type;
+		request->family = family;
+		request->callback = saved_cb;
+		request->app_data = saved_data;
+		memcpy(request->original, msg, size);
+	}
+	spin_lock_bh(&nss_control_lock);
+	if (!nss_control_registered[family][ctx->id][cm->interface] ||
+	    nss_control_closing[ctx->id])
+		goto unlock;
+	if (request) {
+		/* Tokens are also host shadow generations: assign them in enqueue order. */
+		sequence = atomic64_inc_return(&nss_control_sequence);
+		if (!sequence || sequence > U32_MAX) {
+			status = NSS_TX_FAILURE;
+			goto unlock;
+		}
+		request->cookie = sequence;
+		list_add_tail(&request->list, &nss_control_requests);
+		cm->cb = (nss_ptr_t)(uintptr_t)nss_control_wire_callback;
+		cm->app_data = request->cookie;
+	} else {
+		cm->cb = 0;
+		cm->app_data = 0;
+	}
+	/* Enqueue is indivisible with closing the interface/core submission gate. */
+	status = nss_core_send_cmd(ctx, msg, size, buffer_size);
+	cm->cb = saved_cb;
+	cm->app_data = saved_data;
+	if (request) {
+		if (status == NSS_TX_SUCCESS) {
+			if (cookie)
+				*cookie = request->cookie;
+			request = NULL;
+		} else {
+			list_del(&request->list);
+		}
+	}
+unlock:
+	spin_unlock_bh(&nss_control_lock);
+	kfree(request);
+	return status;
+}
+
+bool nss_control_receive(struct nss_ctx_instance *ctx, struct nss_cmn_msg *cm,
+			 enum nss_control_family family,
+			 void (*prepare)(struct nss_ctx_instance *, struct nss_cmn_msg *,
+					 const void *, uint32_t))
+{
+	struct nss_control_request *request, *found = NULL;
+	void (*callback)(void *, struct nss_cmn_msg *);
+	uint64_t cookie = cm->app_data;
+	bool accepted = false;
+
+	if (!nss_control_valid(ctx, family, cm->interface) || !cookie || cookie > U32_MAX ||
+	    cm->cb != (nss_ptr_t)(uintptr_t)nss_control_wire_callback ||
+	    cm->response == NSS_CMN_RESPONSE_NOTIFY)
+		return false;
+	rcu_read_lock_bh();
+	spin_lock_bh(&nss_control_lock);
+	list_for_each_entry(request, &nss_control_requests, list) {
+		if (request->cookie != cookie)
+			continue;
+		if (request->core_id != ctx->id || request->if_num != cm->interface ||
+		    request->type != cm->type || request->family != family ||
+		    !nss_control_registered[family][ctx->id][cm->interface])
+			break;
+		list_del(&request->list);
+		found = request;
+		break;
+	}
+	spin_unlock_bh(&nss_control_lock);
+	if (found) {
+		accepted = true;
+		cm->cb = found->callback;
+		cm->app_data = found->app_data;
+		if (prepare)
+			prepare(ctx, cm, found->original, found->cookie);
+		callback = (void (*)(void *, struct nss_cmn_msg *))(uintptr_t)found->callback;
+		if (callback)
+			callback((void *)(uintptr_t)found->app_data, cm);
+		kfree(found);
+	}
+	rcu_read_unlock_bh();
+	return accepted;
+}
