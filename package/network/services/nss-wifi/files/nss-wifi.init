#!/bin/sh /etc/rc.common

START=19

prepare_wired_tagging() {
	local tagging found=0
	# Before netifd opens any conduit, both CPU links of a QCA DSA tree
	# must agree on the VLAN tagger. No DSA user-port names are rewritten.
	modprobe qca8k || return 1
	for tagging in /sys/class/net/*/dsa/tagging; do
		[ -w "$tagging" ] || continue
		case "$(cat "$tagging")" in
			qca) printf '%s' qca-8021q > "$tagging" || return 1 ;;
			qca-8021q) ;;
			*) continue ;;
		esac
		found=1
	done
	[ "$found" = 1 ]
}

setup_rx_queues() {
	local queue0 queue1
	[ -d /sys/devices/system/cpu/cpu1 ] || return 1
	if [ -r /sys/devices/system/cpu/cpu1/online ]; then
		[ "$(cat /sys/devices/system/cpu/cpu1/online)" = 1 ] || return 1
	fi
	[ -w /proc/sys/dev/nss/rps/enable ] &&
	[ -w /proc/sys/dev/nss/rps/hash_bitmap ] || return 1
	queue0="$(awk '$NF == "nss_queue0" { sub(/:$/, "", $1); print $1; exit }' /proc/interrupts)"
	queue1="$(awk '$NF == "nss_queue1" { sub(/:$/, "", $1); print $1; exit }' /proc/interrupts)"
	case "$queue0" in ''|*[!0-9]*) return 1 ;; esac
	case "$queue1" in ''|*[!0-9]*) return 1 ;; esac
	# These are host CPUs, independent of the single NSS firmware core.
	printf '%s' 0 > "/proc/irq/$queue0/smp_affinity_list" || return 1
	printf '%s' 1 > "/proc/irq/$queue1/smp_affinity_list" || return 1
	printf '%s' 3 > /proc/sys/dev/nss/rps/hash_bitmap || return 1
	printf '%s' 1 > /proc/sys/dev/nss/rps/enable || return 1
	[ "$(cat /proc/sys/dev/nss/rps/enable)" = 1 ] || return 1
	logger -t nss-wifi 'NSS host RX queues assigned to CPUs 0 and 1'
}

start() {
	local enabled monitor_test ready=0 attempts=0 failed=0
	. /lib/functions.sh
	config_load nss-wifi
	config_get_bool enabled main enabled 1
	# Explicit target validation; normal boot keeps concurrent monitor off.
	config_get_bool monitor_test main monitor_test 0

	# Parameters are sampled when ath11k probes; do not reload live radios.
	if [ -d /sys/module/ath11k ]; then
		logger -t nss-wifi 'ath11k is already loaded; configuration changes require a reboot'
		return 0
	fi

	# The NSS-enabled ath11k binary needs the driver's exported symbols even
	# when wireless offload is disabled. Disabling offload only selects the
	# host Wi-Fi path; it cannot skip this module dependency.
	modprobe qca-nss-dp || return 1
	if [ ! -d /sys/module/qca_nss_drv ]; then
		insmod qca-nss-drv wifi_only=1 || return 1
	fi
	if [ "$enabled" = 1 ]; then
		while [ "$attempts" -lt 30 ]; do
			if [ "$(cat /sys/module/qca_nss_drv/parameters/core0_ready 2>/dev/null)" = 1 ]; then
				ready=1
				break
			fi
			attempts=$((attempts + 1))
			sleep 1
		done
	fi

	# modprobe resolves dependencies, insmod preserves the module parameters
	# (OpenWrt's kmodloader modprobe does not pass parameters through).
	modprobe mac80211 || return 1
	modprobe ath || return 1
	modprobe qmi_helpers || return 1
	if [ "$ready" = 1 ]; then
		prepare_wired_tagging || logger -t nss-wifi 'QCA VLAN tagging not confirmed; wired NSS will stay inactive'
		# Set up both host queues before any ath11k VDEV can receive traffic.
		setup_rx_queues || logger -t nss-wifi 'NSS host RX steering not confirmed; continuing wireless startup'
		# Register bridge notifications before netifd creates wireless members.
		modprobe qca-nss-bridge-mgr || failed=1
		# Optional managers must see a ready core before netifd creates sessions.
		if [ -f "/lib/modules/$(uname -r)/qca-nss-pppoe.ko" ]; then
			modprobe qca-nss-pppoe || failed=1
		fi
		insmod ath11k nss_offload=1 frame_mode=2 nss_monitor_test="$monitor_test" || return 1
		logger -t nss-wifi 'NSS core ready; loading ath11k with wireless offload'
	else
		# Keep ath11k's default Ethernet decapsulation on the host path.
		insmod ath11k nss_offload=0 frame_mode=2 || return 1
		logger -t nss-wifi 'Loading ath11k on the host path (NSS disabled or firmware not ready)'
	fi
	# Try both buses and report either failure instead of letting a successful
	# PCI load hide an AHB failure (or skipping PCI after an AHB failure).
	modprobe ath11k_ahb || failed=1
	modprobe ath11k_pci || failed=1
	return "$failed"
}

stop() {
	logger -t nss-wifi 'Use uci set nss-wifi.main.enabled=0; uci commit nss-wifi; reboot to disable wireless offload'
}
