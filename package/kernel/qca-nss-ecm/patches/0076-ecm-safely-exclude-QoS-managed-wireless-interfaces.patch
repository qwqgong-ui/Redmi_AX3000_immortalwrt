+static bool ecm_interface_denied_iface(struct ecm_db_iface_instance *ii, int target)
+{
+	struct net_device *dev;
+	int ifindex;
+	bool denied;
+
+	if (!ii)
+		return true;
+	ifindex = ecm_db_iface_interface_identifier_get(ii);
