+static int ath11k_mon_metadata_show(struct seq_file *s, void *unused)
+{
+	struct ath11k *ar = s->private;
+	struct ath11k_mon_metadata *meta = ar->mon_metadata;
+	struct ath11k_mon_meta_record *records, *r;
+	u64 produced, first;
+	u32 count, i, slot;
+
+	seq_puts(s, "scope: radio_lifetime_pop_first_buffer_samples\n");
+	if (!meta) {
+		seq_puts(s, "enabled: 0\n");
+		return 0;
+	}
+	records = kvmalloc_array(ATH11K_MON_META_CAPACITY, sizeof(*records), GFP_KERNEL);
+	if (!records)
+		return -ENOMEM;
+	spin_lock_bh(&meta->lock);
+	produced = meta->produced;
+	count = min_t(u64, produced, ATH11K_MON_META_CAPACITY);
+	first = produced - count + 1;
+	for (i = 0; i < count; i++) {
+		slot = (first + i - 1) % ATH11K_MON_META_CAPACITY;
+		records[i] = meta->records[slot];
+	}
+	spin_unlock_bh(&meta->lock);
+	seq_printf(s, "enabled: 1\nproduced: %llu\nretained: %u\nfirst: %llu\ncapacity: %u\n",
+		   produced, count, first, ATH11K_MON_META_CAPACITY);
+	seq_puts(s, "ordinal time_ns session flags ppdu expected decap tid fc seq qos ra ta mpdu_tag header_tag end_tag attention_tag header_ppdu info11 info13\n");
+	for (i = 0; i < count; i++) {
+		r = &records[i];
+		seq_printf(s, "%llu %llu %u 0x%x %u %u %u %u 0x%x 0x%x 0x%x %pM %pM 0x%x 0x%x 0x%x 0x%x 0x%x 0x%x 0x%x\n",
+			   r->ordinal, r->time_ns, r->session, r->flags,
+			   r->ppdu, r->expected_ppdu, r->decap, r->tid,
+			   r->fc, r->seq_ctrl, r->qos, r->ra, r->ta,
+			   r->mpdu_tag, r->header_tag, r->end_tag, r->attention_tag,
+			   r->header_ppdu, r->info11, r->info13);
+	}
+	kvfree(records);
+	return 0;
+}
+
+static int ath11k_mon_metadata_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ath11k_mon_metadata_show, inode->i_private);
+}
+
+static const struct file_operations fops_mon_metadata = {
