From: qwqgong-ui <qwqgong-ui@users.noreply.github.com>
Date: Sat, 18 Jul 2026 12:00:00 +0800
Subject: [PATCH] wifi: ath11k: reduce RX DMA rings for 256 MiB devices

The IPQ5018 and QCN6122 radios each retain roughly 40 MiB of
unreclaimable slab with the upstream RX and monitor ring sizes.  On a
256 MiB IPQ5018 device, enabling both radios leaves no available memory
and eventually stalls userspace networking while the firmware and peer
remain alive.

Restore the RX-side reductions used by the working 24.10 build.  Keep
DP_TX_COMP_RING_SIZE and DP_TX_IDR_SIZE at 32768 because reducing those
values causes TX ID exhaustion and persistent -ENOSPC failures on these
radios.

---
 drivers/net/wireless/ath/ath11k/dp.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -217,12 +217,12 @@ struct ath11k_pdev_dp {
 #define DP_REO_EXCEPTION_RING_SIZE	128
 #define DP_REO_CMD_RING_SIZE		256
 #define DP_REO_STATUS_RING_SIZE		2048
-#define DP_RXDMA_BUF_RING_SIZE		4096
+#define DP_RXDMA_BUF_RING_SIZE		1024
 #define DP_RXDMA_REFILL_RING_SIZE	2048
 #define DP_RXDMA_ERR_DST_RING_SIZE	1024
-#define DP_RXDMA_MON_STATUS_RING_SIZE	1024
-#define DP_RXDMA_MONITOR_BUF_RING_SIZE	4096
-#define DP_RXDMA_MONITOR_DST_RING_SIZE	2048
+#define DP_RXDMA_MON_STATUS_RING_SIZE	512
+#define DP_RXDMA_MONITOR_BUF_RING_SIZE	128
+#define DP_RXDMA_MONITOR_DST_RING_SIZE	128
 #define DP_RXDMA_MONITOR_DESC_RING_SIZE	4096
 
 #define DP_RX_RELEASE_RING_NUM	3
