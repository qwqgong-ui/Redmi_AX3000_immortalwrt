+		/* Do not read a concurrently written result, cancel the ID, or drop its pin. */
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	*result = query->result;
+	ret = result->error;
+	if (result->payload_valid) {
+		spin_lock_bh(&ab->base_lock);
+		peer = ath11k_dp_reo_query_peer(ab, vdev_id, mac);
+		spin_lock_bh(&dp->reo_cmd_lock);
+		result->current_instance = peer && peer->rx_tid[tid].active &&
+			peer->rx_tid[tid].reo_queue == query->queue &&
+			!READ_ONCE(query->queue->retiring) &&
+			READ_ONCE(query->queue->phase) == ATH11K_REO_QUEUE_PUBLISHED &&
+			dp->reo_cmd_accepting && dp->reo_cmd_epoch == result->submit_epoch &&
+			!READ_ONCE(ab->nss.ownership_uncertain) &&
+			!test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
+		spin_unlock_bh(&dp->reo_cmd_lock);
+		spin_unlock_bh(&ab->base_lock);
+		if (!result->current_instance)
+			ret = -ESTALE;
+	}
+out:
+	result->error = ret;
+	ath11k_dp_reo_query_put(query);
+	return ret;
+}
