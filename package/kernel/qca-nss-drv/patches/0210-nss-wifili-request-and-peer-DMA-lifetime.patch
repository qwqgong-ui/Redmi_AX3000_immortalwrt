+ * The original app_data is restored for the client callback. cancel_msg()
+ * is process-context and drains a callback that was already dispatched;
+ * forget_msg() only retires a token and does not provide a grace period.
+ */
+nss_tx_status_t nss_wifili_tx_msg_tracked(struct nss_ctx_instance *ctx,
+				       struct nss_wifili_msg *msg, uint32_t *cookie);
+void nss_wifili_forget_msg(uint32_t cookie);
+void nss_wifili_cancel_msg(uint32_t cookie);
