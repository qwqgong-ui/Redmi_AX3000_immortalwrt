+struct ath11k_nss_command {
+	struct completion complete;
+	u32 type;
+	u32 if_num;
+	int result;
+};
+
+static int ath11k_nss_reset(struct ath11k_base *ab);
+
+static void ath11k_nss_command_response(void *context, struct nss_wifili_msg *msg)
+{
+	struct ath11k_nss_command *command = (void *)(uintptr_t)msg->cm.app_data;
+
+	(void)context;
+	if (!command || msg->cm.type != command->type ||
+	    msg->cm.interface != command->if_num ||
+	    msg->cm.response == NSS_CMN_RESPONSE_NOTIFY)
+		return;
+	command->result = msg->cm.response == NSS_CMN_RESPONSE_ACK ? 0 : -EREMOTEIO;
+	complete(&command->complete);
+}
+
+static int ath11k_nss_command_send(void *ctx, struct nss_wifili_msg *msg,
+				   bool *submitted)
+{
+	struct ath11k_nss_command *command;
+	nss_ptr_t callback = msg->cm.cb, app_data = msg->cm.app_data;
+	u32 cookie = 0;
+	nss_tx_status_t status;
+	int result;
 
-	ath11k_dbg(ab, ATH11K_DBG_NSS, "nss peer %d mem freed\n", peer_id);
+	if (submitted)
+		*submitted = false;
+	command = kzalloc(sizeof(*command), GFP_KERNEL);
+	if (!command)
+		return -ENOMEM;
+	init_completion(&command->complete);
+	command->type = msg->cm.type;
+	command->if_num = msg->cm.interface;
+	command->result = -EINPROGRESS;
+	msg->cm.cb = (nss_ptr_t)(uintptr_t)ath11k_nss_command_response;
+	msg->cm.app_data = (nss_ptr_t)(uintptr_t)command;
+	status = nss_wifili_tx_msg_tracked(ctx, msg, &cookie);
+	msg->cm.cb = callback;
+	msg->cm.app_data = app_data;
+	if (status != NSS_TX_SUCCESS) {
+		result = -EIO;
+	} else {
+		if (submitted)
+			*submitted = true;
+		if (!wait_for_completion_timeout(&command->complete,
+						msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS)))
+			result = -ETIMEDOUT;
+		else
+			result = READ_ONCE(command->result);
+	}
+	/* Cancels an unconsumed request, and drains an already dispatched callback
+	 * before its independent completion object can be released.
+	 */
+	nss_wifili_cancel_msg(cookie);
+	kfree(command);
+	return result;
 }
 
