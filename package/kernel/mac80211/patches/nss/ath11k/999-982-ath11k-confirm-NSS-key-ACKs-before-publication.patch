+struct ath11k_nss_key_request {
+	struct completion complete;
+	u32 type;
+	u32 if_num;
+	u16 peer_id;
+	u8 pkt_type;
+	u8 security_type;
+	u8 auth_flag;
+	int result;
+};
+
+static void ath11k_nss_key_response(void *context, struct nss_wifili_msg *msg)
+{
+	struct ath11k_nss_key_request *request = (void *)(uintptr_t)msg->cm.app_data;
+	int ret;
+
+	(void)context;
+	if (!request || msg->cm.type != request->type ||
+	    msg->cm.interface != request->if_num ||
+	    msg->cm.response == NSS_CMN_RESPONSE_NOTIFY)
+		return;
+	ret = msg->cm.response == NSS_CMN_RESPONSE_ACK ? 0 : -EREMOTEIO;
+	if (msg->cm.len) {
+		if (request->type == NSS_WIFILI_PEER_SECURITY_TYPE_MSG) {
+			if (msg->cm.len < sizeof(msg->msg.securitymsg) ||
+			    msg->msg.securitymsg.peer_id != request->peer_id ||
+			    msg->msg.securitymsg.pkt_type != request->pkt_type ||
+			    msg->msg.securitymsg.security_type != request->security_type)
+				ret = -EPROTO;
+		} else if (msg->cm.len < sizeof(msg->msg.peer_auth) ||
+			   msg->msg.peer_auth.peer_id != request->peer_id ||
+			   msg->msg.peer_auth.auth_flag != request->auth_flag) {
+			ret = -EPROTO;
+		}
+	}
+	request->result = ret;
+	complete(&request->complete);
+}
+
+static int ath11k_nss_key_send(struct ath11k *ar, struct ath11k_peer *peer,
+			       struct ath11k_nss_peer_state *state,
+			       struct nss_wifili_msg *msg)
+{
+	struct ath11k_nss_key_request *request;
+	nss_tx_status_t status = NSS_TX_FAILURE;
+	u32 cookie = 0;
+	unsigned long waited = 0;
+	int ret;
+
+	request = kzalloc(sizeof(*request), GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	init_completion(&request->complete);
+	request->type = msg->cm.type;
+	request->if_num = msg->cm.interface;
+	request->peer_id = state->peer_id;
+	request->pkt_type = msg->msg.securitymsg.pkt_type;
+	request->security_type = msg->msg.securitymsg.security_type;
+	request->auth_flag = msg->msg.peer_auth.auth_flag;
+	request->result = -ETIMEDOUT;
+	msg->cm.cb = (nss_ptr_t)(uintptr_t)ath11k_nss_key_response;
+	msg->cm.app_data = (nss_ptr_t)(uintptr_t)request;
+	/* Validate this peer instance and enqueue without allowing unmap between
+	 * them. Allocation, ACK waiting and callback drains stay outside the lock.
+	 */
+	spin_lock_bh(&ar->ab->base_lock);
+	ret = ath11k_nss_key_check(ar, peer, state);
+	if (!ret)
+		status = nss_wifili_tx_msg_tracked(ar->nss.ctx, msg, &cookie);
+	spin_unlock_bh(&ar->ab->base_lock);
+	if (!ret && status != NSS_TX_SUCCESS)
+		ret = -EIO;
+	if (!ret) {
+		waited = wait_for_completion_timeout(&request->complete,
+						msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS));
+	}
+	nss_wifili_cancel_msg(cookie);
+	if (!ret)
+		ret = waited || completion_done(&request->complete) ?
+			READ_ONCE(request->result) : -ETIMEDOUT;
+	msg->cm.cb = 0;
+	msg->cm.app_data = 0;
+	kfree(request);
+	return ret;
+}
+
+static int ath11k_nss_key_vdev_security(struct ath11k_vif *arvif,
+					struct ath11k_peer *peer,
+					struct ath11k_nss_peer_state *state,
+					u32 cipher)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_nss_vdev_request *request;
+	struct nss_wifi_vdev_msg *msg;
+	nss_tx_status_t status = NSS_TX_FAILURE;
+	u32 cookie = 0;
+	unsigned long waited = 0;
+	int ret;
+
+	request = kzalloc(sizeof(*request), GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg) {
+		kfree(request);
+		return -ENOMEM;
+	}
+	init_completion(&request->complete);
+	request->type = NSS_WIFI_VDEV_INTERFACE_CMD_MSG;
+	request->if_num = arvif->nss.if_num;
+	request->result = -ETIMEDOUT;
+	msg->msg.vdev_cmd.cmd = NSS_WIFI_VDEV_SECURITY_TYPE_CMD;
+	msg->msg.vdev_cmd.value = ath11k_nss_cipher_type(ar->ab, cipher);
+	nss_wifi_vdev_msg_init(msg, request->if_num, request->type,
+			       sizeof(msg->msg.vdev_cmd),
+			       (nss_wifi_vdev_msg_callback_t *)ath11k_nss_vdev_cfg_cb,
+			       request);
+	spin_lock_bh(&ar->ab->base_lock);
+	ret = ath11k_nss_key_check(ar, peer, state);
+	if (!ret && (arvif->vdev_id != state->vdev_id || !arvif->nss.created))
+		ret = -ENOENT;
+	if (!ret)
+		status = nss_wifi_vdev_tx_msg_tracked(ar->nss.ctx, msg, &cookie);
+	spin_unlock_bh(&ar->ab->base_lock);
+	if (!ret && status != NSS_TX_SUCCESS)
+		ret = -EIO;
+	if (!ret)
+		waited = wait_for_completion_timeout(&request->complete,
+						msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS));
+	nss_wifi_vdev_cancel_msg(cookie);
+	if (!ret)
+		ret = waited || completion_done(&request->complete) ?
+			READ_ONCE(request->result) : -ETIMEDOUT;
+	kfree(msg);
+	kfree(request);
+	return ret;
+}
