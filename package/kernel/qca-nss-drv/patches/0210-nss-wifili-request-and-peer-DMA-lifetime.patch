+nss_tx_status_t nss_wifili_tx_msg_tracked(struct nss_ctx_instance *nss_ctx,
+				       struct nss_wifili_msg *msg, uint32_t *cookie)
 {
 	struct nss_cmn_msg *ncm = &msg->cm;
+	struct nss_wifili_request *request;
