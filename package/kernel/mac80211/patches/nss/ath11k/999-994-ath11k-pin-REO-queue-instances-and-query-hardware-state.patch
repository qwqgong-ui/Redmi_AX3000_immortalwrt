+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	peer = ath11k_dp_reo_query_peer(ab, vdev_id, mac);
+	if (!peer || !peer->dp_setup_done) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	rx_tid = &peer->rx_tid[tid];
+	if (!rx_tid->active || !rx_tid->reo_queue ||
+	    READ_ONCE(rx_tid->reo_queue->retiring) ||
+	    READ_ONCE(rx_tid->reo_queue->phase) != ATH11K_REO_QUEUE_PUBLISHED) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
+	query->queue = rx_tid->reo_queue;
+	ath11k_dp_reo_queue_get(query->queue);
+	result->queue_generation = query->queue->generation;
+	result->paddr = query->queue->paddr;
+	result->requested_window = rx_tid->ba_win_sz;
+	result->peer_id = peer->peer_id;
+	spin_lock_bh(&dp->reo_cmd_lock);
+	result->submit_epoch = dp->reo_cmd_epoch;
+	spin_unlock_bh(&dp->reo_cmd_lock);
