+	key = ar->install_key;
+	poisoned = !!(ar->ab->wmi_key_poisoned & BIT(ar->pdev_idx));
+	admitting = ar->ab->wmi_key_admitting;
+	spin_unlock_bh(&ar->ab->base_lock);
+	seq_printf(s, "admitting: %u\n", admitting);
+	seq_printf(s, "active: %u\nterminal: %u\nclosed: %u\npoisoned: %u\nresult: %d\nreply_seen: %u\n",
+		   key.active, key.terminal, key.closed, poisoned, key.result, key.reply_seen);
+	seq_printf(s, "started: %llu\nsent: %llu\ncompleted: %llu\nmismatched: %llu\nunexpected: %llu\n",
+		   key.started, key.sent, key.completed, key.mismatched, key.unexpected);
+	seq_printf(s, "timeouts: %llu\naborted: %llu\nsend_failed: %llu\npoison_events: %llu\n",
+		   key.timeouts, key.aborted, key.send_failed, key.poisoned);
+	seq_printf(s, "expected_vdev: %u\nexpected_idx: %u\nexpected_flags: 0x%x\nexpected_addr: %pM\n",
+		   key.expected.vdev_id, key.expected.key_idx,
+		   key.expected.key_flags, key.expected.addr);
+	seq_printf(s, "received_vdev: %u\nreceived_idx: %u\nreceived_flags: 0x%x\nreceived_addr: %pM\nreceived_status: %u\n",
+		   key.last_rx.vdev_id, key.last_rx.key_idx, key.last_rx.key_flags,
+		   key.last_rx.addr, key.last_fw_status);
+	return 0;
+}
+
+static int ath11k_wmi_key_stats_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ath11k_wmi_key_stats_show, inode->i_private);
+}
