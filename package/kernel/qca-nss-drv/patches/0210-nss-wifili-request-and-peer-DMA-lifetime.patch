+uint64_t nss_wifili_peer_memory_dma(struct nss_wifili_peer_memory *memory);
+void nss_wifili_peer_memory_free(struct nss_wifili_peer_memory *memory);
+void nss_wifili_peer_memory_quarantine(struct nss_wifili_peer_memory *memory);
+void nss_wifili_interface_quarantine(struct nss_ctx_instance *ctx, uint32_t if_num);
