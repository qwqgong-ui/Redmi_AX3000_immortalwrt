From: Redmi AX3000 NSS integration
Subject: [PATCH] ath11k: confirm NSS key requests before publishing host key state

Keep a peer-instance lease across WMI/NSS configuration, wait for private
VDEV/security/authorization ACKs outside base_lock, and stop the affected
interface after a partial install. Require fresh VDEV creation to remove
the failed-key gate instead of resetting and reinstalling an old key with
unknown hardware packet numbers.

--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -312,6 +312,57 @@
 	kfree(state);
 }
 
+bool ath11k_nss_vdev_key_failed(struct ath11k_vif *arvif)
+{
+	return READ_ONCE(arvif->nss.key_failed) ||
+		(arvif->nss.ap_vif && READ_ONCE(arvif->nss.ap_vif->nss.key_failed));
+}
+
+int ath11k_nss_key_check(struct ath11k *ar, struct ath11k_peer *peer,
+			 struct ath11k_nss_peer_state *state)
+{
+	struct ath11k_base *ab = ar->ab;
+
+	lockdep_assert_held(&ab->base_lock);
+	if (!state)
+		return ab->nss.enabled ? -ESHUTDOWN : 0;
+	if (!ab->nss.enabled || ab->nss.quiescing ||
+	    ab->nss.ownership_uncertain || !ab->nss.registered)
+		return -ESHUTDOWN;
+	if (!peer->vif || ath11k_nss_vdev_key_failed(ath11k_vif_to_arvif(peer->vif)))
+		return -ESHUTDOWN;
+	if (state->peer != peer || peer->nss.state != state ||
+	    state->delete_submitted ||
+	    ath11k_peer_find(ar, state->vdev_id, state->addr) != peer)
+		return -ENOENT;
+	if (!state->create_done)
+		return -EAGAIN;
+	return state->create_result;
+}
+
+struct ath11k_nss_peer_state *ath11k_nss_key_get(struct ath11k *ar,
+					       struct ath11k_peer *peer)
+{
+	struct ath11k_nss_peer_state *state;
+	int ret;
+
+	lockdep_assert_held(&ar->ab->base_lock);
+	if (!ar->ab->nss.enabled)
+		return NULL;
+	state = peer->nss.state;
+	ret = ath11k_nss_key_check(ar, peer, state);
+	if (ret)
+		return ERR_PTR(ret);
+	refcount_inc(&state->refs);
+	return state;
+}
+
+void ath11k_nss_key_put(struct ath11k_nss_peer_state *state)
+{
+	if (state)
+		ath11k_nss_peer_state_put(state);
+}
