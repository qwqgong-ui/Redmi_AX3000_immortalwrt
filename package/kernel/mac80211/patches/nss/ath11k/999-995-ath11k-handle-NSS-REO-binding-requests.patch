+static void ath11k_nss_reoq_job_put(struct ath11k_nss_reoq_job *job)
+{
+	ath11k_dp_reo_queue_put(job->queue);
+	ath11k_peer_put(job->ar, job->peer);
+}
+
+static void ath11k_nss_reoq_work(struct work_struct *work)
+{
+	struct ath11k_soc_nss *nss = container_of(work, struct ath11k_soc_nss, reoq_work);
+	struct ath11k_base *ab = container_of(nss, struct ath11k_base, nss);
+	struct ath11k_nss_reoq_job job;
+	unsigned int i, batch;
+	int ret;
+
+	for (batch = 0; batch < ATH11K_NSS_REOQ_JOBS; batch++) {
+		spin_lock_bh(&ab->base_lock);
+		for (i = 0; i < ATH11K_NSS_REOQ_JOBS; i++)
+			if (nss->reoq_jobs[i].pending)
+				break;
+		if (i == ATH11K_NSS_REOQ_JOBS) {
+			spin_unlock_bh(&ab->base_lock);
+			return;
+		}
+		nss->reoq_jobs[i].pending = false;
+		nss->reoq_jobs[i].running = true;
+		nss->reoq_stats.pending--;
+		nss->reoq_stats.running++;
+		job = nss->reoq_jobs[i];
+		spin_unlock_bh(&ab->base_lock);
+
+		/* Serialize with BA negotiation and ordinary peer cleanup. Closing
+		 * drains this worker outside conf_mutex, before ar or WMI can be freed.
+		 */
+		mutex_lock(&job.ar->conf_mutex);
+		ret = ath11k_dp_reo_queue_rebind(job.ar, job.peer, job.queue,
+					       job.tid, job.epoch);
+		mutex_unlock(&job.ar->conf_mutex);
+
+		spin_lock_bh(&ab->base_lock);
+		if (!ret)
+			nss->reoq_stats.sent++;
+		else if (ret == -ESTALE)
+			nss->reoq_stats.stale++;
+		else if (ret == -ESHUTDOWN)
+			nss->reoq_stats.closed++;
+		else if (ret == -EBUSY)
+			nss->reoq_stats.busy++;
+		else
+			nss->reoq_stats.failed++;
+		nss->reoq_stats.last_result = ret;
+		nss->reoq_stats.last_job_peer_id = job.peer_id;
+		nss->reoq_stats.last_job_tid = job.tid;
+		nss->reoq_stats.last_job_source = job.injected;
+		nss->reoq_stats.last_generation = job.queue->generation;
+		nss->reoq_stats.last_epoch = job.epoch;
+		memset(&nss->reoq_jobs[i], 0, sizeof(nss->reoq_jobs[i]));
+		nss->reoq_stats.running--;
+		spin_unlock_bh(&ab->base_lock);
+		ath11k_nss_reoq_job_put(&job);
+	}
+	/* Bound each invocation so continuous notifications cannot monopolize aux. */
+	spin_lock_bh(&ab->base_lock);
+	if (nss->reoq_admitting && nss->reoq_stats.pending)
+		queue_work(ab->workqueue_aux, &nss->reoq_work);
+	spin_unlock_bh(&ab->base_lock);
+}
+
+void ath11k_nss_reoq_init(struct ath11k_base *ab)
+{
+	INIT_WORK(&ab->nss.reoq_work, ath11k_nss_reoq_work);
+	ab->nss.reoq_initialized = true;
+}
+
+void ath11k_nss_reoq_start(struct ath11k_base *ab)
+{
+	/* Only core_pdev_create success may call this, after every radio hash and
+	 * registration is stable. NSS START alone does not establish that lifetime.
+	 */
+	spin_lock_bh(&ab->base_lock);
+	ab->nss.reoq_admitting = ab->nss.reoq_initialized && ab->nss.enabled &&
+		ab->nss.registered && !ab->nss.quiescing &&
+		!READ_ONCE(ab->nss.ownership_uncertain);
+	spin_unlock_bh(&ab->base_lock);
+}
+
+void ath11k_nss_reoq_stop(struct ath11k_base *ab)
+{
+	struct ath11k_nss_reoq_job job;
+	unsigned int i;
+
+	if (!ab->nss.reoq_initialized)
+		return;
+	spin_lock_bh(&ab->base_lock);
+	ab->nss.reoq_admitting = false;
+	spin_unlock_bh(&ab->base_lock);
+	/* Caller must not hold base_lock/conf_mutex or be the notification worker. */
+	cancel_work_sync(&ab->nss.reoq_work);
+	for (i = 0; i < ATH11K_NSS_REOQ_JOBS; i++) {
+		spin_lock_bh(&ab->base_lock);
+		if (!ab->nss.reoq_jobs[i].pending) {
+			spin_unlock_bh(&ab->base_lock);
+			continue;
+		}
+		job = ab->nss.reoq_jobs[i];
+		memset(&ab->nss.reoq_jobs[i], 0, sizeof(ab->nss.reoq_jobs[i]));
+		ab->nss.reoq_stats.pending--;
+		ab->nss.reoq_stats.cancelled++;
+		spin_unlock_bh(&ab->base_lock);
+		ath11k_nss_reoq_job_put(&job);
+	}
+}
+
+static int ath11k_nss_reoq_enqueue(struct ath11k_base *ab, u32 peer_id,
+				 u32 tid, bool injected)
+{
+	struct ath11k_nss_reoq_job *job;
+	struct ath11k_peer *peer = NULL;
+	struct ath11k_reo_queue *queue;
+	struct ath11k *ar = NULL;
+	struct dp_rx_tid *rx_tid;
+	u64 epoch;
+	unsigned int i, free_slot = ATH11K_NSS_REOQ_JOBS;
+	int ret;
+
+	spin_lock_bh(&ab->base_lock);
+	if (injected)
+		ab->nss.reoq_stats.injected++;
+	if (tid > IEEE80211_NUM_TIDS || peer_id > U16_MAX) {
+		ab->nss.reoq_stats.invalid++;
+		ret = -EINVAL;
+		goto unlock;
+	}
+	if (!ab->nss.reoq_admitting || ab->nss.quiescing ||
+	    !ab->nss.enabled || READ_ONCE(ab->nss.ownership_uncertain) ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags)) {
+		ab->nss.reoq_stats.closed++;
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (!ar)
+			continue;
+		peer = ath11k_peer_find_by_id(ar, peer_id);
+		if (peer)
+			break;
+	}
+	if (!peer || !peer->dp_setup_done) {
+		ab->nss.reoq_stats.not_ready++;
+		ret = -ENOENT;
+		goto unlock;
+	}
+	rx_tid = &peer->rx_tid[tid];
+	queue = rx_tid->reo_queue;
+	if (!rx_tid->active || !queue || READ_ONCE(queue->retiring) ||
+	    READ_ONCE(queue->phase) != ATH11K_REO_QUEUE_PUBLISHED) {
+		ab->nss.reoq_stats.not_ready++;
+		ret = -EAGAIN;
+		goto unlock;
+	}
+	spin_lock_bh(&ab->dp.reo_cmd_lock);
+	epoch = ab->dp.reo_cmd_epoch;
+	ret = ab->dp.reo_cmd_accepting ? 0 : -ESHUTDOWN;
+	spin_unlock_bh(&ab->dp.reo_cmd_lock);
+	if (ret) {
+		ab->nss.reoq_stats.closed++;
+		goto unlock;
+	}
+	for (i = 0; i < ATH11K_NSS_REOQ_JOBS; i++) {
+		job = &ab->nss.reoq_jobs[i];
+		if (!job->pending && !job->running) {
+			free_slot = i;
+			continue;
+		}
+		if (job->peer == peer && job->queue == queue && job->tid == tid) {
+			ab->nss.reoq_stats.duplicate++;
+			ret = 0;
+			goto unlock;
+		}
+	}
+	if (free_slot == ATH11K_NSS_REOQ_JOBS) {
+		ab->nss.reoq_stats.full++;
+		ret = -ENOSPC;
+		goto unlock;
+	}
+	ath11k_peer_get(peer);
+	ath11k_dp_reo_queue_get(queue);
+	job = &ab->nss.reoq_jobs[free_slot];
+	*job = (struct ath11k_nss_reoq_job) {
+		.ar = ar, .peer = peer, .queue = queue, .epoch = epoch,
+		.peer_id = peer_id, .tid = tid, .injected = injected, .pending = true,
+	};
+	ab->nss.reoq_stats.queued++;
+	ab->nss.reoq_stats.pending++;
+	queue_work(ab->workqueue_aux, &ab->nss.reoq_work);
+	ret = 0;
+unlock:
+	spin_unlock_bh(&ab->base_lock);
+	return ret;
+}
+
+static void ath11k_nss_reoq_receive(struct ath11k_base *ab, struct nss_wifili_msg *msg)
+{
+	struct ath11k_nss_reoq_stats *s = &ab->nss.reoq_stats;
+	u32 peer_id, tid;
+	bool valid;
+
+	/* The driver verifies actual receive-buffer bounds before dispatch/logging. */
+	spin_lock_bh(&ab->base_lock);
+	s->received++;
+	s->last_interface = msg->cm.interface;
+	s->last_response = msg->cm.response;
+	s->last_error = msg->cm.error;
+	s->last_len = msg->cm.len;
+	s->last_source = 0;
+	valid = msg->cm.len >= sizeof(msg->msg.reotidqmsg) &&
+		msg->cm.response == NSS_CMN_RESPONSE_NOTIFY && !msg->cm.error &&
+		msg->cm.interface == ab->nss.if_num;
+	if (msg->cm.response == NSS_CMN_RESPONSE_NOTIFY)
+		s->notify++;
+	if (!valid) {
+		s->invalid++;
+		spin_unlock_bh(&ab->base_lock);
+		return;
+	}
+	s->last_peer_id = msg->msg.reotidqmsg.peer_id;
+	s->last_tid = msg->msg.reotidqmsg.tid;
+	peer_id = s->last_peer_id;
+	tid = s->last_tid;
+	spin_unlock_bh(&ab->base_lock);
+	ath11k_nss_reoq_enqueue(ab, peer_id, tid, false);
+}
+
+#ifdef CPTCFG_ATH11K_DEBUGFS
+static ssize_t ath11k_nss_reoq_stats_read(struct file *file, char __user *user_buf,
+					 size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_nss_reoq_stats s;
+	bool admitting;
+	char *buf;
+	int len;
+	ssize_t ret;
+
+	buf = kzalloc(4096, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	spin_lock_bh(&ab->base_lock);
+	s = ab->nss.reoq_stats;
+	admitting = ab->nss.reoq_admitting;
+	spin_unlock_bh(&ab->base_lock);
+	len = scnprintf(buf, 4096,
+		"admitting: %u\nreceived: %llu\nnotify: %llu\ninjected: %llu\n"
+		"queued: %llu\nduplicate: %llu\nfull: %llu\ninvalid: %llu\n"
+		"closed: %llu\nnot_ready: %llu\nstale: %llu\nbusy: %llu\n"
+		"wmi_queued: %llu\nfailed: %llu\ncancelled: %llu\npending: %u\nrunning: %u\n"
+		"last_received_peer_id: %u\nlast_received_tid: %u\nlast_received_interface: %u\n"
+		"last_received_response: %u\nlast_received_error: %u\nlast_received_len: %u\n"
+		"last_job_peer_id: %u\nlast_job_tid: %u\nlast_job_source: %u\n"
+		"last_job_generation: %llu\nlast_job_epoch: %llu\nlast_job_result: %d\n",
+		admitting, s.received, s.notify, s.injected, s.queued, s.duplicate,
+		s.full, s.invalid, s.closed, s.not_ready, s.stale, s.busy, s.sent,
+		s.failed, s.cancelled, s.pending, s.running, s.last_peer_id, s.last_tid,
+		s.last_interface, s.last_response, s.last_error, s.last_len,
+		s.last_job_peer_id, s.last_job_tid, s.last_job_source,
+		s.last_generation, s.last_epoch, s.last_result);
+	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+	return ret;
+}
+
+static ssize_t ath11k_nss_reoq_rebind_write(struct file *file, const char __user *user_buf,
+					   size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	char buf[64], peer_text[12], tid_text[12], trailing;
+	u32 peer_id, tid;
+	int ret;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (sscanf(buf, "%11s %11s %c", peer_text, tid_text, &trailing) != 2 ||
+	    kstrtou32(peer_text, 10, &peer_id) || kstrtou32(tid_text, 10, &tid))
+		return -EINVAL;
+	/* Explicit diagnostic source: never count this as a firmware notification. */
+	ret = ath11k_nss_reoq_enqueue(ab, peer_id, tid, true);
+	return ret ? ret : count;
+}
+
