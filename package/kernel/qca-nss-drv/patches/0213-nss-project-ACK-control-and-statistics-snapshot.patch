 /*
@@ -238,35 +275,58 @@
 static int nss_project_wt_stats_handler(compat_const struct ctl_table *ctl, int write,
 	void __user *buffer, size_t *lenp, loff_t *ppos)
 {
-	int ret;
-	int i;
-
-	ret = proc_dointvec(ctl, write, buffer, lenp, ppos);
-
-	/*
-	 * In case of error, stop now.
-	 */
-	if (ret) {
-		return ret;
-	}
+	struct ctl_table local = *ctl;
+	int requested, ret = 0, first_error = 0, i;
 
-	/*
-	 * No additional behavior necessary for a read operation.
-	 */
+	mutex_lock(&nss_project_wt_mutex);
 	if (!write) {
-		return ret;
+		ret = proc_dointvec(ctl, write, buffer, lenp, ppos);
+		goto unlock;
 	}
-
-	/*
-	 * If a value was written, send a message containing that value to each
-	 * NSS core.
-	 */
-	for (i = 0; i < nss_top_main.num_nss; ++i) {
-		nss_project_wt_stats_send_enable(&(nss_top_main.nss[i]),
-			nss_project_wt_stats_enable);
+	requested = nss_project_wt_stats_enable;
+	local.data = &requested;
+	ret = proc_dointvec_minmax(&local, write, buffer, lenp, ppos);
+	if (ret)
+		goto unlock;
+	if (!nss_top_main.num_nss) {
+		ret = -ENODEV;
+		goto unlock;
 	}
+	for (i = 0; i < nss_top_main.num_nss; i++) {
+		if (requested && nss_project_wt_state[i] == 1)
+			continue;
+		spin_lock_bh(&nss_top_main.stats_lock);
+		nss_project_wt_state[i] = -1;
+		spin_unlock_bh(&nss_top_main.stats_lock);
+		ret = nss_project_wt_stats_send_enable(&nss_top_main.nss[i], requested);
+		if (ret && !first_error)
+			first_error = ret;
+		/* Still try every core when disabling, including after a timeout. */
+		if (ret && requested)
+			break;
+	}
+	if (first_error && requested) {
+		/* A timeout or allocation failure can follow firmware accepting ENABLE.
+		 * Explicitly disable every core, including the failed one, to converge.
+		 */
+		for (i = 0; i < nss_top_main.num_nss; i++) {
+			spin_lock_bh(&nss_top_main.stats_lock);
+			nss_project_wt_state[i] = -1;
+			spin_unlock_bh(&nss_top_main.stats_lock);
+			nss_project_wt_stats_send_enable(&nss_top_main.nss[i], false);
+		}
+	}
+	/* -1 reports a mixed or unconfirmed state. Never publish a requested
+	 * integer as proof of firmware completion.
+	 */
+	nss_project_wt_stats_enable = nss_project_wt_state[0];
+	for (i = 1; i < nss_top_main.num_nss; i++)
+		if (nss_project_wt_state[i] != nss_project_wt_stats_enable)
+			nss_project_wt_stats_enable = -1;
+	ret = first_error;
+unlock:
+	mutex_unlock(&nss_project_wt_mutex);
 	return ret;
-
 }
 
