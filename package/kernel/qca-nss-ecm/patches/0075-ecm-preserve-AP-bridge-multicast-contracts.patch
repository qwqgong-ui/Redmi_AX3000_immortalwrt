 #include <ovsmgr.h>
 #endif
@@ -1936,6 +1937,9 @@
 	struct net_device *dest_dev __maybe_unused;
 	uint16_t vid __maybe_unused;
 
+	if (ecm_bridge_mcast_contract(out, skb))
+		return NF_ACCEPT;
+
 	DEBUG_TRACE("%px: IPv4 CMN Bridge: %s skb=%px\n", out, out->name, skb);
 
 	/*
@@ -2223,6 +2227,9 @@
 	 */
 	{
 		.hook		= ecm_ipv4_bridge_post_routing_hook,
+#ifdef ECM_BRIDGE_AP_MCAST_CONTRACT
+		.hook_ops_type	= NF_HOOK_OP_BRIDGE_AP_MCAST_CONTRACT,
+#endif
 		.pf		= PF_BRIDGE,
 		.hooknum	= NF_BR_POST_ROUTING,
 		.priority	= NF_BR_PRI_FILTER_OTHER,
