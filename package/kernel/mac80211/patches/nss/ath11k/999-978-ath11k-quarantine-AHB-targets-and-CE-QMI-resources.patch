+/* Only external teardown calls this: the QMI event worker may mark ownership
+ * unresolved, but must never cancel itself or destroy its own workqueue.
+ */
+static void ath11k_qmi_stop_service(struct ath11k_base *ab)
+{
+	struct ath11k_qmi *qmi = &ab->qmi;
+	struct ath11k_qmi_driver_event *event, *next;
+
+	if (qmi->event_work_initialized) {
+		spin_lock(&qmi->event_lock);
+		qmi->event_live = false;
+		spin_unlock(&qmi->event_lock);
+	}
+	if (qmi->handle_live) {
+		qmi->handle_live = false;
+		qmi_handle_release(&qmi->handle);
+	}
+	if (qmi->event_work_initialized)
+		cancel_work_sync(&qmi->event_work);
+	if (qmi->event_wq) {
+		destroy_workqueue(qmi->event_wq);
+		qmi->event_wq = NULL;
+	}
+	if (qmi->event_work_initialized) {
+		spin_lock(&qmi->event_lock);
+		list_for_each_entry_safe(event, next, &qmi->event_list, list) {
+			list_del(&event->list);
+			kfree(event);
+		}
+		spin_unlock(&qmi->event_lock);
+		qmi->event_work_initialized = false;
+	}
+}
