+static void ath11k_mac_key_install_poison_locked(struct ath11k *ar)
+{
+	lockdep_assert_held(&ar->ab->base_lock);
+	if (!(ar->ab->wmi_key_poisoned & BIT(ar->pdev_idx))) {
+		ar->ab->wmi_key_poisoned |= BIT(ar->pdev_idx);
+		ar->install_key.poisoned++;
+	}
+}
+
+int ath11k_mac_key_install_open(struct ath11k *ar)
+{
+	int ret = 0;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	spin_lock_bh(&ar->ab->base_lock);
+	if (!ar->ab->wmi_key_admitting ||
+	    (ar->ab->wmi_key_poisoned & BIT(ar->pdev_idx)) ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_QMI_FAIL, &ar->ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ar->ab->dev_flags))
+		ret = -ESHUTDOWN;
+	else if (ar->install_key.active)
+		ret = -EBUSY;
+	else
+		ar->install_key.closed = false;
+	spin_unlock_bh(&ar->ab->base_lock);
+	return ret;
+}
+
+void ath11k_mac_key_install_close(struct ath11k *ar)
+{
+	struct ath11k_key_install_state *key = &ar->install_key;
+
+	/* Recovery must wake a caller holding conf_mutex, so never acquire it. */
+	spin_lock_bh(&ar->ab->base_lock);
+	key->closed = true;
+	if (key->active && key->result != -ESHUTDOWN) {
+		if (!key->terminal)
+			ath11k_mac_key_install_poison_locked(ar);
+		key->result = -ESHUTDOWN;
+		key->terminal = true;
+		key->aborted++;
+		complete(&ar->install_key_done);
+	}
+	spin_unlock_bh(&ar->ab->base_lock);
+}
+
+static int ath11k_mac_key_install_begin(struct ath11k *ar,
+				      const struct wmi_vdev_install_key_arg *arg)
+{
+	struct ath11k_key_install_state *key = &ar->install_key;
+	int ret = 0;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	spin_lock_bh(&ar->ab->base_lock);
+	if (!ar->ab->wmi_key_admitting || key->closed ||
+	    (ar->ab->wmi_key_poisoned & BIT(ar->pdev_idx)) ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_QMI_FAIL, &ar->ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ar->ab->dev_flags) ||
+	    (ar->state != ATH11K_STATE_ON && ar->state != ATH11K_STATE_RESTARTED)) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (key->active) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	reinit_completion(&ar->install_key_done);
+	key->expected.vdev_id = arg->vdev_id;
+	key->expected.key_idx = arg->key_idx;
+	key->expected.key_flags = arg->key_flags;
+	ether_addr_copy(key->expected.addr, arg->macaddr);
+	key->result = -EINPROGRESS;
+	key->active = true;
+	key->terminal = false;
+	key->reply_seen = false;
+	key->started++;
+out:
+	spin_unlock_bh(&ar->ab->base_lock);
+	return ret;
+}
+
+bool ath11k_mac_key_install_event(struct ath11k *ar,
+		const struct wmi_vdev_install_key_complete_arg *event)
+{
+	struct ath11k_key_install_state *key = &ar->install_key;
+	bool accepted = false;
+
+	spin_lock_bh(&ar->ab->base_lock);
+	key->last_rx.vdev_id = event->vdev_id;
+	key->last_rx.key_idx = event->key_idx;
+	key->last_rx.key_flags = event->key_flags;
+	ether_addr_copy(key->last_rx.addr, event->macaddr);
+	key->last_fw_status = event->status;
+	if (!key->active || key->terminal) {
+		key->unexpected++;
+		goto out;
+	}
+	if (key->expected.vdev_id != event->vdev_id ||
+	    key->expected.key_idx != event->key_idx ||
+	    key->expected.key_flags != event->key_flags ||
+	    !ether_addr_equal(key->expected.addr, event->macaddr)) {
+		key->mismatched++;
+		goto out;
+	}
+
+	key->result = event->status == WMI_VDEV_INSTALL_KEY_COMPL_STATUS_SUCCESS ?
+		0 : -EINVAL;
+	key->terminal = true;
+	key->reply_seen = true;
+	key->completed++;
+	/* Completion and terminal publication stay under the same lock as begin.
+	 * An event must not drop the lock then wake a later reinitialized waiter.
+	 */
+	complete(&ar->install_key_done);
+	accepted = true;
+out:
+	spin_unlock_bh(&ar->ab->base_lock);
+	return accepted;
+}
+
+static int ath11k_mac_key_install_finish(struct ath11k *ar, int send_error,
+				       bool waited)
+{
+	struct ath11k_key_install_state *key = &ar->install_key;
+	int ret;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	spin_lock_bh(&ar->ab->base_lock);
+	if (WARN_ON(!key->active)) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (send_error) {
+		key->send_failed++;
+		if (key->reply_seen) {
+			/* A completion for a command reported unpublished is ambiguous. */
+			ath11k_mac_key_install_poison_locked(ar);
+			ret = -EIO;
+		} else {
+			ret = key->terminal ? key->result : send_error;
+		}
+	} else {
+		key->sent++;
+		if (!ar->ab->wmi_key_admitting || key->closed ||
+		    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags) ||
+		    test_bit(ATH11K_FLAG_QMI_FAIL, &ar->ab->dev_flags) ||
+		    test_bit(ATH11K_FLAG_UNREGISTERING, &ar->ab->dev_flags)) {
+			key->result = -ESHUTDOWN;
+			if (!key->reply_seen)
+				ath11k_mac_key_install_poison_locked(ar);
+		} else if (!key->terminal) {
+			key->result = waited ? -EIO : -ETIMEDOUT;
+			key->timeouts++;
+			ath11k_mac_key_install_poison_locked(ar);
+		}
+		ret = key->result;
+	}
+	key->result = ret;
+	key->terminal = true;
+	key->active = false;
+out:
+	spin_unlock_bh(&ar->ab->base_lock);
+	return ret;
+}
