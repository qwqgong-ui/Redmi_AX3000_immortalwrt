+	}
+	request->cookie = sequence;
+	request->if_num = ncm->interface;
+	request->type = ncm->type;
+	request->callback = callback;
+	request->app_data = app_data;
+	spin_lock_bh(&nss_wifili_peer_memory_lock);
+	if (!nss_wifili_registered_interfaces[ncm->interface] ||
+	    (nss_wifili_blocked_interfaces[ncm->interface] & BIT(nss_ctx->id))) {
+		spin_unlock_bh(&nss_wifili_peer_memory_lock);
+		kfree(request);
+		return NSS_TX_FAILURE;
+	}
+	list_add_tail(&request->list, &nss_wifili_requests);
+	if (cookie)
+		*cookie = sequence;
+	ncm->cb = (nss_ptr_t)(uintptr_t)nss_wifili_request_receive;
+	ncm->app_data = sequence;
+	status = nss_core_send_cmd(nss_ctx, msg, sizeof(*msg), NSS_NBUF_PAYLOAD_SIZE);
+	ncm->cb = callback;
+	ncm->app_data = app_data;
+	if (status != NSS_TX_SUCCESS) {
+		list_del(&request->list);
+		kfree(request);
+		if (cookie)
+			*cookie = 0;
+	}
+	/* Registration-to-enqueue is indivisible with interface shutdown. */
+	spin_unlock_bh(&nss_wifili_peer_memory_lock);
+	return status;
+}
+EXPORT_SYMBOL(nss_wifili_tx_msg_tracked);
+
+nss_tx_status_t nss_wifili_tx_msg(struct nss_ctx_instance *nss_ctx, struct nss_wifili_msg *msg)
+{
+	return nss_wifili_tx_msg_tracked(nss_ctx, msg, NULL);
 }
 EXPORT_SYMBOL(nss_wifili_tx_msg);
 
