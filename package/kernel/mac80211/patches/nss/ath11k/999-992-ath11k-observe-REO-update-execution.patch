Subject: [PATCH] ath11k: observe REO queue update execution without callback ownership

--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -292,6 +292,42 @@
 	struct ath11k_base *ab;
 };
 
+/* Numeric diagnostics only: no queue/peer references or callback ownership. */
+struct ath11k_reo_update_stats {
+	u64 epoch;
+	u64 requested;
+	u64 queued;
+	u64 rejected;
+	u64 status_requested;
+	u64 ba_queued;
+	u64 ssn_queued;
+	u64 pn_queued;
+	u64 status[4];
+	u64 status_unknown;
+	u64 last_paddr;
+	u32 last_flags;
+	u32 last_upd0;
+	u32 last_window;
+	u16 last_ssn;
+	u16 last_cmd;
+	int last_errno;
+	u64 last_ba_paddr;
+	u16 last_ba_cmd;
+	u32 last_ba_window;
+	u16 last_ba_ssn;
+	u16 last_status_cmd;
+	u32 last_status;
+	u32 last_timestamp;
+};
+
+struct ath11k_reo_update_input {
+	u64 paddr;
+	u32 flags;
+	u32 upd0;
+	u32 window;
+	u16 ssn;
+};
+
 struct ath11k_dp {
 	struct ath11k_base *ab;
 	enum ath11k_htc_ep_id eid;
@@ -322,6 +358,8 @@
 	 * - reo_cmd_cache_flush_count
 	 */
 	spinlock_t reo_cmd_lock;
+	spinlock_t reo_stats_lock;
+	struct ath11k_reo_update_stats reo_update_stats;
 	struct list_head reo_cmd_update_rx_queue_list;
 	/**
 	 * protects access to below field,
@@ -332,6 +370,90 @@
 	struct ath11k_hp_update_timer tx_ring_timer[DP_TCL_NUM_RING_MAX];
 };
 
+static inline struct ath11k_reo_update_input
+ath11k_dp_reo_update_input(const struct ath11k_hal_reo_cmd *cmd)
+{
+	/* HAL normalizes window=1 and PN sizes in place. Retain requested values. */
+	return (struct ath11k_reo_update_input) {
+		.paddr = ((u64)cmd->addr_hi << 32) | cmd->addr_lo,
+		.flags = cmd->flag,
+		.upd0 = cmd->upd0,
+		.window = cmd->ba_window_size,
+		.ssn = FIELD_GET(HAL_REO_CMD_UPD2_SSN, cmd->upd2),
+	};
+}
+
+static inline void ath11k_dp_reo_update_record(struct ath11k_dp *dp,
+		const struct ath11k_reo_update_input *input, int cmd_num)
+{
+	struct ath11k_reo_update_stats *stats = &dp->reo_update_stats;
+
+	spin_lock_bh(&dp->reo_stats_lock);
+	stats->requested++;
+	stats->last_paddr = input->paddr;
+	stats->last_flags = input->flags;
+	stats->last_upd0 = input->upd0;
+	stats->last_window = input->window;
+	stats->last_ssn = input->ssn;
+	stats->last_cmd = cmd_num > 0 ? cmd_num : 0;
+	stats->last_errno = cmd_num > 0 ? 0 : cmd_num < 0 ? cmd_num : -EINVAL;
+	if (cmd_num > 0) {
+		stats->queued++;
+		if (input->flags & HAL_REO_CMD_FLG_NEED_STATUS)
+			stats->status_requested++;
+		if (input->upd0 & HAL_REO_CMD_UPD0_BA_WINDOW_SIZE) {
+			stats->ba_queued++;
+			stats->last_ba_paddr = input->paddr;
+			stats->last_ba_cmd = cmd_num;
+			stats->last_ba_window = input->window;
+			stats->last_ba_ssn = input->ssn;
+		}
+		if (input->upd0 & HAL_REO_CMD_UPD0_SSN)
+			stats->ssn_queued++;
+		if (input->upd0 & (HAL_REO_CMD_UPD0_PN_CHECK | HAL_REO_CMD_UPD0_PN))
+			stats->pn_queued++;
+	} else {
+		stats->rejected++;
+	}
+	spin_unlock_bh(&dp->reo_stats_lock);
+}
+
+static inline void ath11k_dp_reo_update_status(struct ath11k_dp *dp,
+		const struct hal_reo_status_header *header)
+{
+	struct ath11k_reo_update_stats *stats = &dp->reo_update_stats;
+	u32 status = header->cmd_status;
+
+	spin_lock_bh(&dp->reo_stats_lock);
+	if (status < ARRAY_SIZE(stats->status))
+		stats->status[status]++;
+	else
+		stats->status_unknown++;
+	stats->last_status_cmd = header->cmd_num;
+	stats->last_status = status;
+	stats->last_timestamp = header->timestamp;
+	spin_unlock_bh(&dp->reo_stats_lock);
+}
+
+static inline void ath11k_dp_reo_update_snapshot(struct ath11k_dp *dp,
+		struct ath11k_reo_update_stats *snapshot)
+{
+	spin_lock_bh(&dp->reo_stats_lock);
+	*snapshot = dp->reo_update_stats;
+	spin_unlock_bh(&dp->reo_stats_lock);
+}
+
+static inline void ath11k_dp_reo_update_reset(struct ath11k_dp *dp)
+{
+	u64 epoch;
+
+	spin_lock_bh(&dp->reo_stats_lock);
+	epoch = dp->reo_update_stats.epoch + 1;
+	memset(&dp->reo_update_stats, 0, sizeof(dp->reo_update_stats));
+	dp->reo_update_stats.epoch = epoch;
+	spin_unlock_bh(&dp->reo_stats_lock);
+}
+
 /* HTT definitions */
 
 #define HTT_TCL_META_DATA_TYPE			BIT(0)
