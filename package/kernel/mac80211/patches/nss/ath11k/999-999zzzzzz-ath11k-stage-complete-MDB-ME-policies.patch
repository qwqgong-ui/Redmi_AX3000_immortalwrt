+/* Count only our bounded tagged probe, without modifying or retaining skb. */
+void ath11k_nss_me_tx_observe(struct ath11k_vif *arvif,
+			    const struct sk_buff *skb, int encap_type)
+{
+	static const u8 magic[] = "NSSME35";
+	struct ethhdr eth;
+	struct iphdr ip;
+	struct udphdr udp;
+	u8 tag[sizeof(magic) - 1];
+	u32 offset;
+
+	if (!READ_ONCE(nss_me_test) || arvif->vif->type != NL80211_IFTYPE_AP ||
+	    encap_type != HAL_TCL_ENCAP_TYPE_ETHERNET ||
+	    skb_copy_bits(skb, 0, &eth, sizeof(eth)) || eth.h_proto != htons(ETH_P_IP) ||
+	    skb_copy_bits(skb, ETH_HLEN, &ip, sizeof(ip)) || ip.version != 4 || ip.ihl < 5 ||
+	    ip.protocol != IPPROTO_UDP || (ntohs(ip.frag_off) & (IP_MF | IP_OFFSET)) ||
+	    ip.saddr != htonl(0xc0a801fa) || (ntohl(ip.daddr) & 0xffff0000) != 0xef230000)
+		return;
+	offset = ETH_HLEN + ip.ihl * 4;
+	if (ntohs(ip.tot_len) != ip.ihl * 4 + 1032 ||
+	    skb->len < ETH_HLEN + ntohs(ip.tot_len) ||
+	    skb_copy_bits(skb, offset, &udp, sizeof(udp)) ||
+	    udp.source != htons(45354) || udp.dest != htons(45355) ||
+	    ntohs(udp.len) != 1032 ||
+	    skb_copy_bits(skb, offset + sizeof(udp), tag, sizeof(tag)) ||
+	    memcmp(tag, magic, sizeof(tag)))
+		return;
+	if (is_multicast_ether_addr(eth.h_dest))
+		atomic64_inc(&arvif->nss.me.tx_probe_group_da);
+	else
+		atomic64_inc(&arvif->nss.me.tx_probe_unicast_da);
+}
 
