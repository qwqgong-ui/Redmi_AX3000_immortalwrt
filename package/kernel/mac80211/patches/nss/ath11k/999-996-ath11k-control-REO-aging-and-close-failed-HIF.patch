+static ssize_t ath11k_debugfs_reo_aging_read(struct file *file,
+					  char __user *user_buf,
+					  size_t count, loff_t *ppos)
+{
+	struct ath11k *ar = file->private_data;
+	u32 raw[4];
+	u64 epoch;
+	char buf[128];
+	int ret, len;
+
+	mutex_lock(&ar->conf_mutex);
+	ret = ath11k_dp_reo_aging_read(ar, &epoch, raw);
+	mutex_unlock(&ar->conf_mutex);
+	if (ret)
+		return ret;
+	len = scnprintf(buf, sizeof(buf), "epoch: %llu\nthresholds_raw: %u %u %u %u\n",
+			(unsigned long long)epoch, raw[0], raw[1], raw[2], raw[3]);
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t ath11k_debugfs_reo_aging_write(struct file *file,
+					   const char __user *user_buf,
+					   size_t count, loff_t *ppos)
+{
+	struct ath11k *ar = file->private_data;
+	char *buf, *cursor, *token;
+	u32 raw[8];
+	u64 epoch;
+	int n = 0, ret = -EINVAL;
+
+	/* epoch, four expected raw values, then four desired raw values.
+	 * One complete request per write; a stale epoch/value cannot restore
+	 * an earlier device instance's settings after recovery.
+	 */
+	if (!count || count > 192)
+		return -EINVAL;
+	buf = memdup_user_nul(user_buf, count);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+	if (memchr(buf, '\0', count)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	cursor = buf;
+	while ((token = strsep(&cursor, " \t\r\n"))) {
+		if (!*token)
+			continue;
+		if (n == 9) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = n ? kstrtou32(token, 0, &raw[n - 1]) : kstrtou64(token, 0, &epoch);
+		if (ret)
+			goto out;
+		n++;
+	}
+	if (n != 9) {
+		ret = -EINVAL;
+		goto out;
+	}
+	mutex_lock(&ar->conf_mutex);
+	ret = ath11k_dp_reo_aging_replace(ar, epoch, raw, raw + 4);
+	mutex_unlock(&ar->conf_mutex);
+out:
+	kfree(buf);
+	return ret ? ret : count;
+}
+
+static const struct file_operations fops_reo_aging = {
+	.read = ath11k_debugfs_reo_aging_read,
+	.write = ath11k_debugfs_reo_aging_write,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
