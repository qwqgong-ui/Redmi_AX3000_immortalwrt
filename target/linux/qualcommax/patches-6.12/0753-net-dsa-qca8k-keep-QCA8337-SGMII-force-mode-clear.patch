From: qwqgong-ui <qwqgong-ui@users.noreply.github.com>
Subject: [PATCH] net: dsa: qca8k: keep QCA8337 SGMII force mode clear

Linux 6.12.116 sets QCA8K_PORT_PAD_SGMII_FORCE_MODE on QCA8337 for
out-of-band (fixed-link) SGMII. Upstream pairs that with dropping 0751,
a qca-ssdk update and a UNIPHY reset change, which this tree defers.
While 0751 keeps SerDes auto-negotiation on, restore the 6.12.108 PAD
register write so the IPQ5018 to QCA8337 link is programmed exactly as
on the validated sta63 image.

--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -1538,7 +1538,7 @@ static int qca8k_pcs_config(struct phyli
 {
 	struct qca8k_priv *priv = pcs_to_qca8k_pcs(pcs)->priv;
 	int cpu_port_index, ret, port;
-	u32 mask, reg, val;
+	u32 reg, val;
 
 	port = pcs_to_qca8k_pcs(pcs)->port;
 	switch (port) {
@@ -1610,21 +1610,11 @@ static int qca8k_pcs_config(struct phyli
 	if (priv->ports_config.sgmii_tx_clk_falling_edge)
 		val |= QCA8K_PORT0_PAD_SGMII_TXCLK_FALLING_EDGE;
 
-	mask = (val) ? (QCA8K_PORT0_PAD_SGMII_RXCLK_FALLING_EDGE |
-			QCA8K_PORT0_PAD_SGMII_TXCLK_FALLING_EDGE) : 0;
-
-	/*
-	 * (Un)set force mode on QCA8337 only, don't include it in the mask for
-	 * others. It is written to the PORT0 PAD register for both port 0 and 6.
-	 */
-	if (priv->switch_id == QCA8K_ID_QCA8337) {
-		if (neg_mode == PHYLINK_PCS_NEG_OUTBAND)
-			val |= QCA8K_PORT_PAD_SGMII_FORCE_MODE;
-		mask |= QCA8K_PORT_PAD_SGMII_FORCE_MODE;
-	}
-
-	if (mask)
-		ret = qca8k_rmw(priv, reg, mask, val);
+	if (val)
+		ret = qca8k_rmw(priv, reg,
+				QCA8K_PORT0_PAD_SGMII_RXCLK_FALLING_EDGE |
+				QCA8K_PORT0_PAD_SGMII_TXCLK_FALLING_EDGE,
+				val);
 
 	return 0;
 }
