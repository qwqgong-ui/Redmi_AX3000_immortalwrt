+static int ecm_interface_accel_denied_read(void *buffer, size_t *lenp, loff_t *ppos)
+{
+	const size_t capacity = ECM_INTERFACE_ACCEL_DENIED_DEVICE_HTABLE_SIZE * IFNAMSIZ + 2;
+	struct ecm_interface_denied_node *node;
+	char *snapshot;
+	size_t bytes = 0;
+	ssize_t copied;
+	int bucket;
+
+	snapshot = kzalloc(capacity, GFP_KERNEL);
+	if (!snapshot)
+		return -ENOMEM;
+	spin_lock_bh(&ecm_interface_accel_denied_lock);
+	hash_for_each(ecm_interface_accel_denied_list, bucket, node, hnode)
+		bytes += scnprintf(snapshot + bytes, capacity - bytes, "%s ", node->name);
+	spin_unlock_bh(&ecm_interface_accel_denied_lock);
+	bytes += scnprintf(snapshot + bytes, capacity - bytes, "\n");
+	copied = memory_read_from_buffer(buffer, *lenp, ppos, snapshot, bytes);
+	kfree(snapshot);
+	if (copied < 0)
+		return copied;
+	*lenp = copied;
+	return 0;
+}
+
+/* Validate the entire request before touching the list. Names may precede
+ * netdev creation, and deletion must work after a wireless VIF disappears.
+ * The writer mutex serializes updates and rule retirement; packet lookups
+ * and snapshots share a short BH-safe lock with publication and removal.
+ */
+static int ecm_interface_accel_denied_handler(int write, void *buffer, size_t *lenp, loff_t *ppos)
+{
+	struct ecm_interface_denied_node *nodes[ECM_INTERFACE_ACCEL_DENIED_DEVICE_HTABLE_SIZE] = {};
+	char *names[ECM_INTERFACE_ACCEL_DENIED_DEVICE_HTABLE_SIZE];
+	char *request, *cursor, *command, *token;
+	size_t length = *lenp;
+	int count = 0, needed = 0, i, j, ret = 0;
+	bool add;
+
+	if (!write)
+		return ecm_interface_accel_denied_read(buffer, lenp, ppos);
+	if (!length || length > 256 || memchr(buffer, '\0', length))
+		return -EINVAL;
+	request = kzalloc(length + 1, GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	memcpy(request, buffer, length);
+	cursor = strim(request);
+	command = strsep(&cursor, " \t\n");
+	if (!strcmp(command, "add"))
+		add = true;
+	else if (!strcmp(command, "del"))
+		add = false;
+	else {
+		ret = -EINVAL;
+		goto free_request;
+	}
+	while ((token = strsep(&cursor, " \t\n"))) {
+		if (!*token)
+			continue;
+		if (strlen(token) >= IFNAMSIZ || !dev_valid_name(token)) {
+			ret = -EINVAL;
+			goto free_request;
+		}
+		for (j = 0; j < count; j++)
+			if (!strcmp(names[j], token))
+				break;
+		if (j < count)
+			continue;
+		if (count == ARRAY_SIZE(names)) {
+			ret = -E2BIG;
+			goto free_request;
+		}
+		names[count++] = token;
+	}
+	if (!count) {
+		ret = -EINVAL;
+		goto free_request;
+	}
+	if (add) {
+		for (i = 0; i < count; i++) {
+			nodes[i] = kzalloc(sizeof(*nodes[i]), GFP_KERNEL);
+			if (!nodes[i]) {
+				ret = -ENOMEM;
+				goto free_nodes;
+			}
+			strscpy(nodes[i]->name, names[i], IFNAMSIZ);
+		}
+	}
+	mutex_lock(&ecm_interface_accel_denied_writer);
+	spin_lock_bh(&ecm_interface_accel_denied_lock);
+	if (add) {
+		for (i = 0; i < count; i++)
+			if (!ecm_interface_lookup_in_denied_list_locked(names[i]))
+				needed++;
+		if (atomic_read(&ecm_interface_accel_denied_list_count) + needed >
+				ECM_INTERFACE_ACCEL_DENIED_DEVICE_HTABLE_SIZE) {
+			ret = -ENOSPC;
+			goto unlock;
+		}
+	}
+	for (i = 0; i < count; i++) {
+		uint32_t hash = jhash(names[i], strlen(names[i]), ecm_db_jhash_rnd) %
+			ECM_INTERFACE_ACCEL_DENIED_DEVICE_HTABLE_SIZE;
+		struct ecm_interface_denied_node *node;
+		struct hlist_node *next;
+
+		if (add) {
+			if (ecm_interface_lookup_in_denied_list_locked(names[i]))
+				continue;
+			hlist_add_head(&nodes[i]->hnode, &ecm_interface_accel_denied_list[hash]);
+			nodes[i] = NULL;
+			atomic_inc(&ecm_interface_accel_denied_list_count);
+		} else {
+			hlist_for_each_entry_safe(node, next, &ecm_interface_accel_denied_list[hash], hnode) {
+				if (strcmp(node->name, names[i]))
+					continue;
+				hlist_del(&node->hnode);
+				atomic_dec(&ecm_interface_accel_denied_list_count);
+				kfree(node);
+				break;
+			}
+		}
+	}
+unlock:
+	spin_unlock_bh(&ecm_interface_accel_denied_lock);
+	if (!ret) {
+		/* Publication precedes retirement so replacement flows see the policy. */
+		for (i = 0; i < count; i++) {
+			struct net_device *dev = dev_get_by_name(&init_net, names[i]);
+			if (!dev)
+				continue;
+			ecm_interface_denied_defunct(dev);
+			dev_put(dev);
+		}
+		*ppos += length;
+	}
+	mutex_unlock(&ecm_interface_accel_denied_writer);
+free_nodes:
+	for (i = 0; i < count; i++)
+		kfree(nodes[i]);
+free_request:
+	kfree(request);
+	return ret;
+}
+
+static void ecm_interface_accel_denied_clear(void)
+{
+	struct ecm_interface_denied_node *node;
+	struct hlist_node *next;
+	int bucket;
+
+	spin_lock_bh(&ecm_interface_accel_denied_lock);
+	hash_for_each_safe(ecm_interface_accel_denied_list, bucket, next, node, hnode) {
+		hlist_del(&node->hnode);
+		kfree(node);
+	}
+	atomic_set(&ecm_interface_accel_denied_list_count, 0);
+	spin_unlock_bh(&ecm_interface_accel_denied_lock);
 }
 
