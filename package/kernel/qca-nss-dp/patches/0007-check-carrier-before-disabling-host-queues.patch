+static int syn_dp_tx_prepare_segment(struct syn_dp_tx_prepare *prepare,
+				    void *data, unsigned int length,
+				    unsigned int packet_len, bool checksum)
+{
+	struct syn_dp_info_tx *tx_info = prepare->info;
+	struct syn_dp_tx_buf *buffer;
+	struct dma_desc_tx *desc;
+	dma_addr_t address;
+	unsigned int index;
+
+	if (!length)
+		return 0;
+	if (length > 2 * SYN_DP_MAX_DESC_BUFF_LEN ||
+	    prepare->count == SYN_DP_TX_DESC_SIZE)
+		return -EMSGSIZE;
+	if (prepare->bytes > packet_len || length > packet_len - prepare->bytes)
+		return -EINVAL;
