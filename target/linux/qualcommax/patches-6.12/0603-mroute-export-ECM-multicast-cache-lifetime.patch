+static struct mfc_cache *ipmr_offload_cache_find(struct mr_table *mrt,
+						 __be32 origin, __be32 group)
+{
+	struct mfc_cache *c, *found = NULL;
+	struct rhlist_head *next;
+
+	for (c = ipmr_cache_find(mrt, origin, group); c;
+	     c = next ? container_of(next, struct mfc_cache, _c.mnode) : NULL) {
+		next = rcu_dereference(c->_c.mnode.next);
+		if (c->_c.mfc_flags & MFC_DELETED)
+			continue;
+		if (found)
+			return ERR_PTR(-EOPNOTSUPP);
+		found = c;
+	}
+	return found ?: ERR_PTR(-ENOENT);
+}
+
+/* Caller holds mrt_lock and an RCU read-side critical section. Build into a
+ * private array so a missing VIF or short caller buffer never returns a
+ * partially usable destination set.
+ */
+static int ipmr_offload_ifindexes(struct mr_table *mrt, struct mfc_cache *c,
+				 u32 ifindexes[MAXVIFS], u32 *vif_mask)
+{
+	struct net_device *dev;
+	u32 mask = 0;
+	int count = 0, i;
+
+	if (c->_c.mfc_flags & MFC_DELETED)
+		return -ENOENT;
+	if (c->_c.mfc_parent >= MAXVIFS ||
+	    !vif_dev_read(&mrt->vif_table[c->_c.mfc_parent]))
+		return -ENODEV;
+	for (i = 0; i < MAXVIFS; i++) {
+		if (!c->_c.mfc_un.res.ttls[i] || c->_c.mfc_un.res.ttls[i] == 255)
+			continue;
+		/* NSS has no per-OIF TTL threshold in its multicast rule. */
+		if (c->_c.mfc_un.res.ttls[i] != 1)
+			return -EOPNOTSUPP;
+		dev = vif_dev_read(&mrt->vif_table[i]);
+		if (!dev)
+			return -ENODEV;
+		ifindexes[count++] = dev->ifindex;
+		mask |= BIT(i);
+	}
+	if (vif_mask)
+		*vif_mask = mask;
+	return count;
+}
+
+int ipmr_find_mfc_entry(struct net *net, __be32 origin, __be32 group,
+		       u32 capacity, u32 ifindexes[], u64 *cookie)
+{
+	struct mr_table *mrt;
+	struct mfc_cache *c;
+	u32 indices[MAXVIFS];
+	int count = -ENOENT;
+
+	if (!ifindexes && capacity)
+		return -EINVAL;
+	if (!net_eq(net, &init_net))
+		return -EOPNOTSUPP;
+	rcu_read_lock();
+	spin_lock_bh(&mrt_lock);
+	mrt = __ipmr_get_table(net, RT_TABLE_DEFAULT);
+	if (!mrt)
+		goto out;
+	c = ipmr_offload_cache_find(mrt, origin, group);
+	if (IS_ERR(c)) {
+		count = PTR_ERR(c);
+		goto out;
+	}
+	count = ipmr_offload_ifindexes(mrt, c, indices, NULL);
+	if (count >= 0 && (u32)count > capacity) {
+		count = -EINVAL;
+		goto out;
+	}
+	if (count > 0)
+		memcpy(ifindexes, indices, count * sizeof(indices[0]));
+	if (count >= 0 && cookie)
+		*cookie = c->_c.offload_cookie;
+out:
+	spin_unlock_bh(&mrt_lock);
+	rcu_read_unlock();
+	return count;
+}
+EXPORT_SYMBOL(ipmr_find_mfc_entry);
