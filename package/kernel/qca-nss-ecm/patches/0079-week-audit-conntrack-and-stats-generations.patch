--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -9197,51 +9197,13 @@
 	cancel_work_sync(&ecm_interface_multicast_work);
 }
 
-/*
- * SYNC_MANY is a tagged scan of active firmware slots.  Snapshot only rules
- * already ACKed when this request is submitted.  A later CREATE, a new CI
- * using the same tuple, or a topology change cannot inherit this request.
- */
-void ecm_interface_multicast_stats_snapshot(int ip_version, unsigned long request)
-{
-	struct ecm_db_connection_instance *ci;
-
-	ci = ecm_db_connections_get_and_ref_first();
-	while (ci) {
-		struct ecm_db_connection_instance *next;
-
-		next = ecm_db_connection_get_and_ref_next(ci);
-		if (ecm_db_connection_ip_version_get(ci) == ip_version &&
-		    ecm_db_multicast_connection_to_interfaces_set_check(ci)) {
-			struct ecm_front_end_connection_instance *feci;
-
-			feci = ecm_db_connection_front_end_get_and_ref(ci);
-			spin_lock_bh(&feci->lock);
-			feci->multicast_stats_request = 0;
-			if (!feci->is_defunct &&
-			    feci->accel_engine == ECM_FRONT_END_ENGINE_NSS &&
-			    feci->accel_mode == ECM_FRONT_END_ACCELERATION_MODE_ACCEL &&
-			    feci->multicast_generation == ecm_interface_multicast_generation_get()) {
-				feci->multicast_stats_request = request;
-				feci->multicast_stats_rule_generation = feci->multicast_rule_generation;
-				feci->multicast_stats_route_cookie = feci->multicast_route_cookie;
-			}
-			spin_unlock_bh(&feci->lock);
-			ecm_front_end_connection_deref(feci);
-		}
-		ecm_db_connection_deref(ci);
-		ci = next;
-		cond_resched();
-	}
-}
-
 bool ecm_interface_multicast_stats_valid(struct ecm_front_end_connection_instance *feci,
 					unsigned long request, u64 *route_cookie)
 {
 	bool valid;
 
 	spin_lock_bh(&feci->lock);
-	valid = request && request == feci->multicast_stats_request &&
+	valid = request && (long)(request - feci->multicast_stats_after) > 0 &&
 		!feci->is_defunct &&
 		feci->accel_mode == ECM_FRONT_END_ACCELERATION_MODE_ACCEL &&
 		feci->multicast_rule_generation == feci->multicast_stats_rule_generation &&
--- a/ecm_interface.h
