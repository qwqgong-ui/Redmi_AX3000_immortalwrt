+static struct ath11k_peer *ath11k_dp_reo_query_peer(struct ath11k_base *ab,
+						  u32 vdev_id, const u8 *mac)
+{
+	struct ath11k_peer *peer;
+	struct ath11k *ar;
+	unsigned int i;
+
+	lockdep_assert_held(&ab->base_lock);
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (!ar)
+			continue;
+		peer = ath11k_peer_find(ar, vdev_id, mac);
+		if (peer)
+			return peer;
+	}
+	return NULL;
+}
