+static bool ath11k_mon_meta_tlv(u32 word, u32 tag, size_t payload)
+{
+	return FIELD_GET(HAL_TLV_HDR_TAG, word) == tag &&
+		FIELD_GET(HAL_TLV_HDR_LEN, word) == payload;
+}
+
+/* Monitor-only compact layout. Never enable the normal low-memory getter. */
+static void ath11k_mon_meta_decode(const void *buffer, size_t bytes, u16 expected,
+				  u32 msdu_flags, struct ath11k_mon_meta_record *r)
+{
+	const struct hal_rx_desc_qcn9074 *d = buffer;
+	const struct rx_mpdu_start_qcn9074 *m;
+	const struct ieee80211_hdr *h;
+	u32 v, header_len;
+	__le16 fc;
+	u16 first_last;
+	int hdrlen;
+
+	memset(r, 0, sizeof(*r));
+	r->expected_ppdu = expected;
+	r->tid = 0xff;
+	if (msdu_flags & RX_MSDU_DESC_INFO0_MSDU_CONTINUATION)
+		r->flags |= ATH11K_MON_META_CONTINUATION;
+	if (bytes < sizeof(*d))
+		return;
+	r->mpdu_tag = le32_to_cpu(d->mpdu_start_tag);
+	r->header_tag = le32_to_cpu(d->hdr_status_tag);
+	r->end_tag = le32_to_cpu(d->msdu_end_tag);
+	r->attention_tag = le32_to_cpu(d->rx_attn_tag);
+	if (!ath11k_mon_meta_tlv(r->mpdu_tag, HAL_RX_MPDU_START, sizeof(d->mpdu_start)))
+		return;
+	r->flags |= ATH11K_MON_META_MPDU_VALID;
+	m = &d->mpdu_start;
+	r->ppdu = le16_to_cpu(m->phy_ppdu_id);
+	if (r->ppdu == expected)
+		r->flags |= ATH11K_MON_META_PPDU_MATCH;
+	r->info11 = v = le32_to_cpu(m->info11);
+	r->info13 = le32_to_cpu(m->info13);
+	r->decap = FIELD_GET(RX_MPDU_START_INFO12_DECAP_TYPE, le32_to_cpu(m->info12));
+	if (v & RX_MPDU_START_INFO11_MPDU_FCTRL_VALID) {
+		r->fc = le16_to_cpu(m->frame_ctrl);
+		if (!(r->fc & IEEE80211_FCTL_VERS))
+			r->flags |= ATH11K_MON_META_FC_VALID;
+	}
+	if (v & RX_MPDU_START_INFO11_MAC_ADDR1_VALID) {
+		ether_addr_copy(r->ra, m->addr1);
+		r->flags |= ATH11K_MON_META_RA_VALID;
+	}
+	if (v & RX_MPDU_START_INFO11_MAC_ADDR2_VALID) {
+		ether_addr_copy(r->ta, m->addr2);
+		r->flags |= ATH11K_MON_META_TA_VALID;
+	}
+	if (v & RX_MPDU_START_INFO11_MPDU_SEQ_CTRL_VALID) {
+		r->seq_ctrl = le16_to_cpu(m->seq_ctrl);
+		if ((r->seq_ctrl >> 4) == FIELD_GET(RX_MPDU_START_INFO11_MPDU_SEQ_NUM, v) &&
+		    (r->seq_ctrl & 15) == FIELD_GET(RX_MPDU_START_INFO11_MPDU_FRAG_NUMBER, v))
+			r->flags |= ATH11K_MON_META_SEQ_VALID;
+	}
+	fc = cpu_to_le16(r->fc);
+	if ((v & RX_MPDU_START_INFO11_MPDU_QOS_CTRL_VALID) &&
+	    (r->flags & ATH11K_MON_META_FC_VALID) && ieee80211_is_data_qos(fc)) {
+		r->qos = le16_to_cpu(m->qos_ctrl);
+		if ((r->qos & 15) == FIELD_GET(RX_MPDU_START_INFO9_TID, le32_to_cpu(m->info9))) {
+			r->tid = r->qos & 15;
+			r->flags |= ATH11K_MON_META_QOS_VALID;
+		}
+	}
+	/* MSDU_END/attention are only valid on the final buffer of an MSDU. */
+	if (!(r->flags & ATH11K_MON_META_CONTINUATION) &&
+	    ath11k_mon_meta_tlv(r->end_tag, HAL_RX_MSDU_END, sizeof(d->msdu_end)) &&
+	    ath11k_mon_meta_tlv(r->attention_tag, HAL_RX_ATTENTION, sizeof(d->attention))) {
+		r->flags |= ATH11K_MON_META_END_VALID;
+		first_last = le16_to_cpu(d->msdu_end.info4);
+		if ((first_last & (RX_MSDU_END_INFO4_FIRST_MSDU | RX_MSDU_END_INFO4_LAST_MSDU)) ==
+		    (RX_MSDU_END_INFO4_FIRST_MSDU | RX_MSDU_END_INFO4_LAST_MSDU))
+			r->flags |= ATH11K_MON_META_FIRST_LAST;
+		if (le32_to_cpu(d->attention.info2) & RX_ATTENTION_INFO2_MSDU_DONE)
+			r->flags |= ATH11K_MON_META_DONE;
+		if (le32_to_cpu(d->attention.info1) & RX_ATTENTION_INFO1_FCS_ERR)
+			r->flags |= ATH11K_MON_META_FCS_BAD;
+	}
+	header_len = FIELD_GET(HAL_TLV_HDR_LEN, r->header_tag);
+	if (FIELD_GET(HAL_TLV_HDR_TAG, r->header_tag) != HAL_RX_HEADER ||
+	    header_len < sizeof(d->phy_ppdu_id) + sizeof(h->frame_control) ||
+	    header_len > sizeof(d->phy_ppdu_id) + sizeof(d->hdr_status))
+		return;
+	r->header_ppdu = le32_to_cpu(d->phy_ppdu_id);
+	h = (const struct ieee80211_hdr *)d->hdr_status;
+	fc = h->frame_control;
+	if ((fc & cpu_to_le16(IEEE80211_FCTL_VERS)) || !ieee80211_is_data(fc))
+		return;
+	hdrlen = ieee80211_hdrlen(fc);
+	if (hdrlen < 24 || hdrlen > header_len - sizeof(d->phy_ppdu_id))
+		return;
+	r->flags |= ATH11K_MON_META_HDR_VALID;
+	if ((r->header_ppdu & 0xffff) != r->ppdu ||
+	    r->fc != le16_to_cpu(fc) || r->seq_ctrl != le16_to_cpu(h->seq_ctrl) ||
+	    !ether_addr_equal(r->ra, h->addr1) || !ether_addr_equal(r->ta, h->addr2))
+		return;
+	if (ieee80211_is_data_qos(fc) &&
+	    (!(r->flags & ATH11K_MON_META_QOS_VALID) ||
+	     r->qos != get_unaligned_le16(ieee80211_get_qos_ctl((struct ieee80211_hdr *)h))))
+		return;
+	if (!!(r->fc & IEEE80211_FCTL_RETRY) != !!(r->info11 & RX_MPDU_START_INFO11_MPDU_RETRY))
+		return;
+	r->flags |= ATH11K_MON_META_HDR_MATCH;
+	v = ATH11K_MON_META_MPDU_VALID | ATH11K_MON_META_FC_VALID |
+		ATH11K_MON_META_RA_VALID | ATH11K_MON_META_TA_VALID | ATH11K_MON_META_SEQ_VALID |
+		ATH11K_MON_META_PPDU_MATCH | ATH11K_MON_META_HDR_VALID | ATH11K_MON_META_HDR_MATCH |
+		ATH11K_MON_META_END_VALID | ATH11K_MON_META_FIRST_LAST | ATH11K_MON_META_DONE;
+	if ((r->flags & v) == v && !(r->flags & (ATH11K_MON_META_FCS_BAD | ATH11K_MON_META_CONTINUATION)))
+		r->flags |= ATH11K_MON_META_TRUSTED;
+}
+
+static void ath11k_mon_meta_observe(struct ath11k *ar, struct sk_buff *skb,
+				   u16 ppdu, u32 msdu_flags)
+{
+	struct ath11k_mon_metadata *meta = ar->mon_metadata;
+	struct ath11k_mon_meta_record r;
+	u32 slot;
+
+	if (!meta || ar->ab->hw_rev != ATH11K_HW_QCN6122_HW10)
+		return;
+	ath11k_mon_meta_decode(skb->data, skb_headlen(skb), ppdu, msdu_flags, &r);
+	r.time_ns = ktime_get_ns();
+	r.session = atomic64_read(&ar->monitor_observation[ATH11K_MON_STARTS]);
+	spin_lock_bh(&meta->lock);
+	r.ordinal = ++meta->produced;
+	slot = (r.ordinal - 1) % ATH11K_MON_META_CAPACITY;
+	meta->records[slot] = r;
+	spin_unlock_bh(&meta->lock);
+}
