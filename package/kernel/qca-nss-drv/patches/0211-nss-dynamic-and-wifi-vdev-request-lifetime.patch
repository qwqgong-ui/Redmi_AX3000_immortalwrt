 static nss_dynamic_interface_assigned nss_dynamic_interface_assigned_types[NSS_CORE_MAX][NSS_MAX_DYNAMIC_INTERFACES]; /* Array of assigned interface types */
+static uint32_t nss_dynamic_interface_assigned_generations[NSS_CORE_MAX][NSS_MAX_DYNAMIC_INTERFACES];
+static DEFINE_SPINLOCK(nss_dynamic_interface_assignment_lock);
+
+/* Update the host allocator only after a current request has been claimed. */
+static void nss_dynamic_interface_prepare_reply(struct nss_ctx_instance *ctx,
+					       struct nss_cmn_msg *cm, const void *original,
+					       uint32_t generation)
+{
+	struct nss_dynamic_interface_msg *msg = (void *)cm;
+	const struct nss_dynamic_interface_msg *sent = original;
+	int if_num;
+	bool dealloc = cm->type == NSS_DYNAMIC_INTERFACE_DEALLOC_NODE;
+	enum nss_dynamic_interface_type type;
+
+	if (cm->response != NSS_CMN_RESPONSE_ACK)
+		return;
+	if (cm->type == NSS_DYNAMIC_INTERFACE_ALLOC_NODE) {
+		if (cm->len < sizeof(msg->msg.alloc_node) ||
+		    msg->msg.alloc_node.type != sent->msg.alloc_node.type)
+			goto invalid;
+		if_num = msg->msg.alloc_node.if_num;
+		if (!nss_is_dynamic_interface(if_num))
+			goto invalid;
+		type = msg->msg.alloc_node.type;
+	} else {
+		if (cm->len < sizeof(msg->msg.dealloc_node) ||
+		    msg->msg.dealloc_node.type != sent->msg.dealloc_node.type ||
+		    msg->msg.dealloc_node.if_num != sent->msg.dealloc_node.if_num)
+			goto invalid;
+		if_num = msg->msg.dealloc_node.if_num;
+		if (!nss_is_dynamic_interface(if_num))
+			goto invalid;
+		type = NSS_DYNAMIC_INTERFACE_TYPE_NONE;
+	}
+	spin_lock_bh(&nss_dynamic_interface_assignment_lock);
+	if (generation > nss_dynamic_interface_assigned_generations[ctx->id][if_num - NSS_DYNAMIC_IF_START]) {
+		nss_dynamic_interface_assigned_generations[ctx->id][if_num - NSS_DYNAMIC_IF_START] = generation;
+		WRITE_ONCE(nss_dynamic_interface_assigned_types[ctx->id][if_num - NSS_DYNAMIC_IF_START], type);
+		/* This notifier is atomic; serialize its deallocation event with later
+		 * shadow updates. The lockless type getter remains usable by notifiers.
+		 */
+		if (dealloc)
+			nss_dynamic_interface_stats_notify(if_num, ctx->id);
+	}
+	spin_unlock_bh(&nss_dynamic_interface_assignment_lock);
+	return;
+invalid:
+	cm->response = NSS_CMN_RESPONSE_EMSG;
+}
 
