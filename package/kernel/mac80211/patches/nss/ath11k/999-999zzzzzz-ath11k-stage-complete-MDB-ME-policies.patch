+static int ath11k_nss_me_recheck_plan(struct ath11k_vif *arvif,
+		struct ath11k_nss_me_pin pins[], u32 count,
+		const struct br_mcast_offload_lookup_snapshot *expected)
+{
+	struct br_mcast_offload_lookup_snapshot now;
+	struct ath11k_base *ab = arvif->ar->ab;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(arvif->vif);
+	u32 i;
+	int ret;
+
+	ret = br_mcast_offload_snapshot_lookups(wdev->netdev, NULL, 0, NULL, 0, &now);
+	if (ret && ret != -E2BIG)
+		return ret;
+	if (now.seq != expected->seq || now.bridge_ifindex != expected->bridge_ifindex ||
+	    now.snooping != expected->snooping || now.vlan_snooping != expected->vlan_snooping ||
+	    now.source_filter_ipv4 != expected->source_filter_ipv4 ||
+	    now.source_filter_ipv6 != expected->source_filter_ipv6 ||
+	    now.querier_ipv4 != expected->querier_ipv4 || now.querier_ipv6 != expected->querier_ipv6 ||
+	    now.router_ipv4 != expected->router_ipv4 || now.router_ipv6 != expected->router_ipv6 ||
+	    now.forwarding != expected->forwarding ||
+	    now.multicast_to_unicast != expected->multicast_to_unicast)
+		return -ESTALE;
+	spin_lock_bh(&ab->base_lock);
+	ret = ath11k_nss_me_admit(arvif);
+	for (i = 0; !ret && i < count; i++) {
+		ret = ath11k_nss_key_check(arvif->ar, pins[i].peer, pins[i].state);
+		if (!ret && (!pins[i].peer->is_authorized || pins[i].peer->vif != arvif->vif))
+			ret = -ENOENT;
+	}
+	spin_unlock_bh(&ab->base_lock);
+	return ret;
+}
+
+static int ath11k_nss_me_fill_table(struct ath11k_vif *arvif,
+		const struct ath11k_nss_me_member members[],
+		struct ath11k_nss_me_pin pins[], u32 count,
+		struct nss_wifi_vdev_msg *msg)
+{
+	u32 i, j, source_len;
+	u8 group_mac[ETH_ALEN];
+	int ret;
+
+	memset(msg, 0, sizeof(*msg));
+	ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_SNOOPLIST_RESET_MSG,
+				     0, NULL, NULL);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		if (members[i].group.proto == htons(ETH_P_IP)) {
+			ip_eth_mc_map(members[i].group.dst.ip4, group_mac);
+			source_len = 4;
+		} else {
+#if IS_ENABLED(CONFIG_IPV6)
+			ipv6_eth_mc_map(&members[i].group.dst.ip6, group_mac);
+			source_len = 16;
+#else
+			return -EAFNOSUPPORT;
+#endif
+		}
+		for (j = 0; j < i; j++)
+			if (ath11k_nss_me_same_group(&members[i].group, &members[j].group))
+				break;
+		if (j == i) {
+			memset(msg, 0, sizeof(*msg));
+			msg->msg.vdev_grp_list_create.ether_type = ntohs(members[i].group.proto);
+			memcpy(&msg->msg.vdev_grp_list_create.u, &members[i].group.dst, source_len);
+			ether_addr_copy(msg->msg.vdev_grp_list_create.grp_addr, group_mac);
+			ret = ath11k_nss_me_exchange(arvif, msg,
+				NSS_WIFI_VDEV_SNOOPLIST_GRP_LIST_CREATE_MSG,
+				sizeof(msg->msg.vdev_grp_list_create), NULL, NULL);
+			if (ret)
+				return ret;
+		}
+		memset(msg, 0, sizeof(*msg));
+		msg->msg.vdev_grp_member_add.ether_type = ntohs(members[i].group.proto);
+		memcpy(&msg->msg.vdev_grp_member_add.u, &members[i].group.dst, source_len);
+		msg->msg.vdev_grp_member_add.peer_id = pins[i].peer_id;
+		ether_addr_copy(msg->msg.vdev_grp_member_add.grp_addr, group_mac);
+		ether_addr_copy(msg->msg.vdev_grp_member_add.grp_member_addr, members[i].mac);
+		ether_addr_copy(msg->msg.vdev_grp_member_add.ra_entry.ramac, members[i].mac);
+		msg->msg.vdev_grp_member_add.mode = members[i].mode;
+		msg->msg.vdev_grp_member_add.nsrcs = members[i].source_count;
+		for (j = 0; j < members[i].source_count; j++)
+			memcpy(msg->msg.vdev_grp_member_add.src_ip_addr + j * source_len,
+			       members[i].source[j], source_len);
+		ret = ath11k_nss_me_exchange(arvif, msg,
+			NSS_WIFI_VDEV_SNOOPLIST_GRP_MEMBER_ADD_MSG,
+			sizeof(msg->msg.vdev_grp_member_add), pins[i].peer, pins[i].state);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
