+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Compile the bridge's actual (*,G)/(S,G) selection, not its timer lists. */
+#include <linux/etherdevice.h>
+#include <linux/igmp.h>
+#include <linux/in.h>
+#include <linux/string.h>
+#include <net/ipv6.h>
+#include <net/addrconf.h>
