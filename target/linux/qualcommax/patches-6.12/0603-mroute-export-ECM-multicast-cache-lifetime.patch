+int ipmr_mfc_stats_update(struct net *net, __be32 origin, __be32 group,
+			 u64 cookie, u64 packets_in, u64 bytes_in,
+			 u64 packets_out, u64 bytes_out)
+{
+	struct mr_table *mrt;
+	struct mfc_cache *c;
+	struct vif_device *vif;
+	u32 indices[MAXVIFS], mask;
+	int ret = -ENOENT, i;
+
+	if (!net_eq(net, &init_net))
+		return -EOPNOTSUPP;
+	rcu_read_lock();
+	spin_lock_bh(&mrt_lock);
+	mrt = __ipmr_get_table(net, RT_TABLE_DEFAULT);
+	if (!mrt)
+		goto out;
+	c = ipmr_offload_cache_find(mrt, origin, group);
+	if (IS_ERR(c)) {
+		ret = PTR_ERR(c);
+		goto out;
+	}
+	if (!cookie || c->_c.offload_cookie != cookie) {
+		ret = -ESTALE;
+		goto out;
+	}
+	ret = ipmr_offload_ifindexes(mrt, c, indices, &mask);
+	if (ret < 0)
+		goto out;
+	vif = &mrt->vif_table[c->_c.mfc_parent];
+	atomic_long_add(packets_in, &vif->pkt_in);
+	atomic_long_add(bytes_in, &vif->bytes_in);
+	atomic_long_add(packets_out, &c->_c.mfc_un.res.pkt);
+	atomic_long_add(bytes_out, &c->_c.mfc_un.res.bytes);
+	WRITE_ONCE(c->_c.mfc_un.res.lastuse, jiffies);
+	for (i = 0; i < MAXVIFS; i++) {
+		if (!(mask & BIT(i)))
+			continue;
+		vif = &mrt->vif_table[i];
+		atomic_long_add(packets_out, &vif->pkt_out);
+		atomic_long_add(bytes_out, &vif->bytes_out);
+	}
+	ret = 0;
+out:
+	spin_unlock_bh(&mrt_lock);
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL(ipmr_mfc_stats_update);
