+struct ath11k_nss_vdev_state_request {
+	struct ath11k_nss_vdev_request request;
+	u8 mac_addr[ETH_ALEN];
+	bool echo_match;
+};
+
+static void ath11k_nss_vdev_state_cb(void *app_data, struct nss_cmn_msg *cm)
+{
+	struct ath11k_nss_vdev_state_request *state = app_data;
+	struct ath11k_nss_vdev_request *request;
+	struct nss_wifi_vdev_msg *msg;
+
+	if (!state)
+		return;
+	request = &state->request;
+	if (cm->type != request->type || cm->interface != request->if_num ||
+	    cm->response == NSS_CMN_RESPONSE_NOTIFY)
+		return;
+
+	/* An ACK confirms acceptance, not a state readback. The ABI does not
+	 * require an echoed MAC or a response payload; inspect only a complete
+	 * UP payload and record its echo without rejecting a valid ACK.
+	 */
+	request->result = cm->response == NSS_CMN_RESPONSE_ACK && !cm->error ?
+		0 : -EREMOTEIO;
+	if (request->type == NSS_WIFI_VDEV_INTERFACE_UP_MSG &&
+	    cm->len == sizeof(msg->msg.vdev_enable)) {
+		msg = container_of(cm, struct nss_wifi_vdev_msg, cm);
+		state->echo_match = ether_addr_equal(msg->msg.vdev_enable.mac_addr,
+						    state->mac_addr);
+	}
+	request->response = cm->response;
+	request->error = cm->error;
+	request->len = cm->len;
+	complete(&request->complete);
+}
+
+static int ath11k_nss_vdev_set_state(struct ath11k_vif *arvif, bool up)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_nss_vdev_state_request *state;
+	struct ath11k_nss_vdev_request *request;
+	struct nss_wifi_vdev_msg *msg;
+	nss_tx_status_t status = NSS_TX_FAILURE;
+	unsigned long waited = 0, started = jiffies;
+	u32 cookie = 0, payload_len;
+	int ret;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg) {
+		kfree(state);
+		return -ENOMEM;
+	}
+	request = &state->request;
+	init_completion(&request->complete);
+	request->type = up ? NSS_WIFI_VDEV_INTERFACE_UP_MSG :
+		NSS_WIFI_VDEV_INTERFACE_DOWN_MSG;
+	request->if_num = arvif->nss.if_num;
+	request->result = -ETIMEDOUT;
+	payload_len = up ? sizeof(struct nss_wifi_vdev_enable_msg) :
+		sizeof(struct nss_wifi_vdev_disable_msg);
+	if (up) {
+		ether_addr_copy(state->mac_addr, arvif->vif->addr);
+		ether_addr_copy(msg->msg.vdev_enable.mac_addr, state->mac_addr);
+	}
+	nss_wifi_vdev_msg_init(msg, request->if_num, request->type, payload_len,
+		(nss_wifi_vdev_msg_callback_t *)ath11k_nss_vdev_state_cb, state);
+	spin_lock_bh(&ab->base_lock);
+	ret = !ab->nss.enabled || !ab->nss.registered || ab->nss.quiescing ||
+		ab->nss.ownership_uncertain || !arvif->nss.created ||
+		test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+		(up && (!arvif->nss.format_ready || arvif->nss.format_failed ||
+			arvif->nss.key_failed)) ? -ESHUTDOWN : 0;
+	if (!ret)
+		status = nss_wifi_vdev_tx_msg_tracked(ar->nss.ctx, msg, &cookie);
+	spin_unlock_bh(&ab->base_lock);
+	if (!ret && status != NSS_TX_SUCCESS)
+		ret = -EIO;
+	if (!ret)
+		waited = wait_for_completion_timeout(&request->complete,
+				msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS));
+	/* Drains an already-dispatched callback before freeing its private
+	 * waiter. It cannot undo a command that firmware already accepted.
+	 */
+	nss_wifi_vdev_cancel_msg(cookie);
+	if (!ret)
+		ret = waited || completion_done(&request->complete) ?
+			READ_ONCE(request->result) : -ETIMEDOUT;
+	spin_lock_bh(&ab->base_lock);
+	if (!ret && (!ab->nss.enabled || !ab->nss.registered || ab->nss.quiescing ||
+		     ab->nss.ownership_uncertain || !arvif->nss.created ||
+		     arvif->nss.if_num != request->if_num ||
+		     test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+		     (up && (!arvif->nss.format_ready || arvif->nss.format_failed ||
+			     arvif->nss.key_failed))))
+		ret = -ESHUTDOWN;
+	spin_unlock_bh(&ab->base_lock);
+	if (ret)
+		ath11k_warn(ab,
+			"NSS VDEV state %s if=%u result=%d response=%u error=%u rxlen=%u echo=%u wait_ms=%u\n",
+			up ? "up" : "down", request->if_num, ret, request->response,
+			request->error, request->len, state->echo_match,
+			jiffies_to_msecs(jiffies - started));
+	else
+		ath11k_info(ab,
+			"NSS VDEV state %s if=%u result=0 response=%u error=%u rxlen=%u echo=%u wait_ms=%u\n",
+			up ? "up" : "down", request->if_num, request->response,
+			request->error, request->len, state->echo_match,
+			jiffies_to_msecs(jiffies - started));
+	kfree(msg);
+	kfree(state);
+	return ret;
+}
