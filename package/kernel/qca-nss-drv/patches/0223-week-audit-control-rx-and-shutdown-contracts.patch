 	    nss_control_closing[ctx->id])
 		goto unlock;
+	if (family == NSS_CONTROL_BASE_IF &&
+	    (!generation || generation == U64_MAX ||
+	     generation != nss_control_base_generation[ctx->id][cm->interface]))
+		goto unlock;
 	if (request) {
 		/* Tokens are also host shadow generations: assign them in enqueue order. */
 		sequence = atomic64_inc_return(&nss_control_sequence);
@@ -184,6 +271,27 @@
 	return status;
 }
 
+nss_tx_status_t nss_control_send(struct nss_ctx_instance *ctx, void *msg,
+			       uint32_t size, uint32_t buffer_size,
+			       enum nss_control_family family, uint32_t *cookie)
+{
+	/* BASE_IF must use the DP lease captured at its API entry. */
+	if (family == NSS_CONTROL_BASE_IF) {
+		if (cookie)
+			*cookie = 0;
+		return NSS_TX_FAILURE_BAD_PARAM;
+	}
+	return nss_control_send_generation(ctx, msg, size, buffer_size, family, 0, cookie);
+}
+
+nss_tx_status_t nss_control_base_send(struct nss_ctx_instance *ctx, void *msg,
+				    uint32_t size, uint32_t buffer_size,
+				    uint64_t generation, uint32_t *cookie)
+{
+	return nss_control_send_generation(ctx, msg, size, buffer_size,
+					   NSS_CONTROL_BASE_IF, generation, cookie);
+}
+
 bool nss_control_receive(struct nss_ctx_instance *ctx, struct nss_cmn_msg *cm,
 			 enum nss_control_family family,
 			 void (*prepare)(struct nss_ctx_instance *, struct nss_cmn_msg *,
@@ -226,3 +334,36 @@
 	rcu_read_unlock_bh();
 	return accepted;
 }
