+	case NSS_WIFI_EXT_VDEV_MSG_STATS_SYNC:
+		minimum = sizeof(msg->msg.stats);
+		break;
+	case NSS_WIFI_EXT_VDEV_MSG_CONFIGURE_VLAN:
+		minimum = sizeof(msg->msg.vmsg);
+		break;
