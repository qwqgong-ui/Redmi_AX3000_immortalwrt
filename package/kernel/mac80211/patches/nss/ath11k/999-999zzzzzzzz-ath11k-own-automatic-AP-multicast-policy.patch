+	me->mdb_input_keys = policy->snapshot.key_count;
+	me->mdb_querier4 = policy->snapshot.querier_ipv4;
+	me->mdb_querier6 = policy->snapshot.querier_ipv6;
+	if (ret && ret != -E2BIG)
+		goto fail;
+	host_capacity = policy->snapshot.host_count;
+	key_capacity = policy->snapshot.key_count;
+	if (!host_capacity || host_capacity > 2048 || key_capacity > 8192) {
+		ret = host_capacity ? -E2BIG : -ENODATA;
+		goto fail;
+	}
+	hosts = kvcalloc(host_capacity, sizeof(*hosts), GFP_KERNEL);
+	keys = kvcalloc(max_t(u32, key_capacity, 1), sizeof(*keys), GFP_KERNEL);
+	policy->members = kvcalloc(host_capacity, sizeof(*policy->members), GFP_KERNEL);
+	if (!hosts || !keys || !policy->members) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	ret = br_mcast_offload_snapshot_lookups(wdev->netdev, hosts, host_capacity,
+					      keys, key_capacity, &policy->snapshot);
+	me->mdb_input_seq = policy->snapshot.seq;
+	me->mdb_input_hosts = policy->snapshot.host_count;
+	me->mdb_input_keys = policy->snapshot.key_count;
+	me->mdb_querier4 = policy->snapshot.querier_ipv4;
+	me->mdb_querier6 = policy->snapshot.querier_ipv6;
+	if (ret)
+		goto fail;
+	me->mdb_build_stage = 2;
+	ret = ath11k_nss_me_plan_build(hosts, keys, &policy->snapshot,
+				     policy->members, host_capacity, &policy->count);
+	if (ret)
+		goto fail;
+	if (!policy->count) {
+		ret = -ENODATA;
+		goto fail;
+	}
+	policy->pins = kvcalloc(policy->count, sizeof(*policy->pins), GFP_KERNEL);
+	if (!policy->pins) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	for (i = 0; i < policy->count; i++) {
+		struct ath11k_peer *peer;
+		struct ath11k_nss_peer_state *state;
+
+		me->mdb_build_stage = 3;
+		spin_lock_bh(&ab->base_lock);
+		ret = ath11k_nss_me_admit(arvif);
+		peer = ret ? NULL : ath11k_peer_find(arvif->ar, arvif->vdev_id, policy->members[i].mac);
+		if (!ret && (!peer || !peer->sta || !peer->is_authorized || peer->vif != arvif->vif))
+			ret = -ENOENT;
+		if (!ret) {
+			me->mdb_pin_peer = peer->peer_id;
+			state = ath11k_nss_key_get(arvif->ar, peer);
+			if (IS_ERR_OR_NULL(state)) {
+				ret = state ? PTR_ERR(state) : -ESHUTDOWN;
+			} else {
+				ath11k_peer_get(peer);
+				policy->pins[i].peer = peer;
+				policy->pins[i].state = state;
+				policy->pins[i].peer_id = peer->peer_id;
+			}
+		}
+		me->mdb_pin_result = ret;
+		spin_unlock_bh(&ab->base_lock);
+		if (ret)
+			goto fail;
+	}
+	policy->cookie = atomic64_inc_return(&ath11k_nss_me_cookie);
+	me->mdb_build_stage = 0;
+	kvfree(keys);
+	kvfree(hosts);
+	return policy;
+fail:
+	kvfree(keys);
+	kvfree(hosts);
+	ath11k_nss_me_policy_free(arvif, policy);
+	return ERR_PTR(ret);
+}
+
+void ath11k_nss_me_dirty_locked(struct ath11k_vif *arvif)
+{
+	struct ath11k_nss_me_auto *auto_me = &arvif->nss.me_auto;
+
+	lockdep_assert_held(&arvif->ar->ab->base_lock);
+	if (!auto_me->initialized || auto_me->closing)
+		return;
+	auto_me->active = false;
+	auto_me->generation++;
+	if (auto_me->running)
+		mod_delayed_work(system_wq, &auto_me->work, msecs_to_jiffies(100));
+}
+
+void ath11k_nss_me_dirty(struct ath11k_vif *arvif)
+{
+	spin_lock_bh(&arvif->ar->ab->base_lock);
+	ath11k_nss_me_dirty_locked(arvif);
+	spin_unlock_bh(&arvif->ar->ab->base_lock);
+}
+
+static int ath11k_nss_me_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct ath11k_nss_me_auto *auto_me = container_of(nb, struct ath11k_nss_me_auto, mdb);
+
+	/* The notifier runs under the bridge multicast lock. Retain no bridge
+	 * pointer and never snapshot or submit/wait for firmware here.
+	 */
+	ath11k_nss_me_dirty(auto_me->arvif);
+	return NOTIFY_DONE;
+}
+
+static void ath11k_nss_me_work(struct work_struct *work)
+{
+	struct ath11k_nss_me_auto *auto_me = container_of(to_delayed_work(work),
+							      struct ath11k_nss_me_auto, work);
+	struct ath11k_vif *arvif = auto_me->arvif;
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_nss_me_state *me = &arvif->nss.me;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(arvif->vif);
+	struct ath11k_nss_me_policy *policy = NULL, *old;
+	struct nss_wifi_vdev_msg *msg = NULL;
+	u64 generation;
+	u32 i, groups = 0;
+	int ret = 0;
+
+	/* remove/stop holds conf_mutex while canceling work. Never wait for it. */
+	if (!mutex_trylock(&ar->conf_mutex))
+		goto requeue;
+	spin_lock_bh(&ab->base_lock);
+	if (!auto_me->running || auto_me->closing || !arvif->is_up ||
+	    arvif->nss.encap != HAL_TCL_ENCAP_TYPE_ETHERNET ||
+	    arvif->nss.decap != ATH11K_HW_TXRX_ETHERNET ||
+	    !me->rx_mcbc_known || me->rx_mcbc != 1) {
+		spin_unlock_bh(&ab->base_lock);
+		goto unlock;
+	}
+	generation = auto_me->generation;
+	old = auto_me->policy;
+	spin_unlock_bh(&ab->base_lock);
+	if (old && READ_ONCE(auto_me->active) &&
+	    !ath11k_nss_me_recheck_plan(arvif, old->pins, old->count, &old->snapshot))
+		goto unlock;
+	spin_lock_bh(&ab->base_lock);
+	auto_me->active = false;
+	spin_unlock_bh(&ab->base_lock);
+	br_mcast_offload_set_mcu(wdev->netdev, 0, 0, false);
+	/* All RAW enqueues counted under base_lock precede withdrawal. COW/free
+	 * of those independent extension references drives this exact counter.
+	 */
+	if (!wait_event_timeout(auto_me->flight->drained,
+				!atomic_read(&auto_me->flight->pending), msecs_to_jiffies(3000))) {
+		ret = -ETIMEDOUT;
+		goto finish;
+	}
+	spin_lock_bh(&ab->base_lock);
+	old = auto_me->policy;
+	auto_me->policy = NULL;
+	spin_unlock_bh(&ab->base_lock);
+	ath11k_nss_me_policy_free(arvif, old);
+	policy = ath11k_nss_me_policy_build(arvif);
+	if (IS_ERR(policy)) {
+		ret = PTR_ERR(policy);
+		policy = NULL;
+		goto finish;
+	}
+	if (!br_mcast_offload_mcu_capable(wdev->netdev)) {
+		ret = -EOPNOTSUPP;
+		goto finish;
+	}
+	if (me->uncertain) {
+		ret = -EUCLEAN;
+		goto finish;
+	}
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg) {
+		ret = -ENOMEM;
+		goto finish;
+	}
+	/* Adopted mode5 state has the same fallback obligations as a cold enable. */
+	spin_lock_bh(&ab->base_lock);
+	auto_me->redirect = true;
+	spin_unlock_bh(&ab->base_lock);
+	if (!me->mode_known) {
+		/* Sticky until this VDEV is destroyed, even after an ambiguous ACK:
+		 * ordinary group frames must never escape into GTK/empty ME fallback.
+		 */
+		msg->msg.vdev_cmd.cmd = NSS_WIFI_VDEV_ENABLE_ME_CMD;
+		msg->msg.vdev_cmd.value = 5;
+		ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_INTERFACE_CMD_MSG,
+					    sizeof(msg->msg.vdev_cmd), NULL, NULL);
+		if (ret)
+			goto finish;
+		me->mode = 5;
+		me->global_mode = 5;
+		me->mode_known = true;
+		me->table_known = true;
+		me->table = 0;
+	}
+	if (me->mode != 5 || !me->table_known) {
+		ret = -EUCLEAN;
+		goto finish;
+	}
+	/* MP12.2 commands write 1-selector. Never disable or re-enable ME here;
+	 * re-enabling would force the data selector to zero.
+	 */
+	ret = ath11k_nss_me_fill_table(arvif, policy->members, policy->pins, policy->count, msg);
+	if (ret)
+		goto finish;
+	ret = ath11k_nss_me_recheck_plan(arvif, policy->pins, policy->count, &policy->snapshot);
+	if (ret)
+		goto finish;
+	memset(msg, 0, sizeof(*msg));
+	ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_SNOOPLIST_TOGGLE_MSG, 0, NULL, NULL);
+	if (ret)
+		goto finish;
+	me->table ^= 1;
+	ret = ath11k_nss_me_recheck_plan(arvif, policy->pins, policy->count, &policy->snapshot);
+	if (ret)
+		goto finish;
+	ret = br_mcast_offload_commit_mcu(wdev->netdev, &policy->snapshot, policy->cookie);
+	if (ret)
+		goto finish;
+	spin_lock_bh(&ab->base_lock);
+	ret = ath11k_nss_me_admit(arvif);
+	if (!ret && (generation != auto_me->generation || !auto_me->running || auto_me->closing))
+		ret = -ESTALE;
+	if (!ret) {
+		auto_me->policy = policy;
+		auto_me->active = true;
+		me->mdb_seq = policy->snapshot.seq;
+		me->mdb_members = policy->count;
+		me->mdb_staged = true;
+		for (i = 0; i < policy->count; i++) {
+			u32 j;
+			for (j = 0; j < i; j++)
+				if (ath11k_nss_me_same_group(&policy->members[i].group, &policy->members[j].group))
+					break;
+			groups += j == i;
+		}
+		me->mdb_groups = groups;
+		policy = NULL;
+	}
+	spin_unlock_bh(&ab->base_lock);
+finish:
+	if (ret) {
+		me->mdb_staged = false;
+		br_mcast_offload_set_mcu(wdev->netdev, 0, 0, false);
+	}
+	me->mdb_result = ret;
+	kfree(msg);
+	ath11k_nss_me_policy_free(arvif, policy);
+unlock:
+	mutex_unlock(&ar->conf_mutex);
+requeue:
+	spin_lock_bh(&ab->base_lock);
+	if (auto_me->initialized && auto_me->running && !auto_me->closing)
+		mod_delayed_work(system_wq, &auto_me->work, HZ);
+	spin_unlock_bh(&ab->base_lock);
+}
+
+void ath11k_nss_me_init(struct ath11k_vif *arvif)
+{
+	struct ath11k_nss_me_auto *auto_me = &arvif->nss.me_auto;
+
+	lockdep_assert_held(&arvif->ar->conf_mutex);
+	if (arvif->vif->type != NL80211_IFTYPE_AP || auto_me->initialized ||
+	    (arvif->ar->ab->hw_rev != ATH11K_HW_IPQ5018_HW10 &&
+	     arvif->ar->ab->hw_rev != ATH11K_HW_QCN6122_HW10))
+		return;
+	memset(auto_me, 0, sizeof(*auto_me));
+	auto_me->flight = kzalloc(sizeof(*auto_me->flight), GFP_KERNEL);
+	if (!auto_me->flight)
+		return;
+	refcount_set(&auto_me->flight->refs, 1);
+	atomic_set(&auto_me->flight->pending, 0);
+	init_waitqueue_head(&auto_me->flight->drained);
+	auto_me->arvif = arvif;
+	INIT_DELAYED_WORK(&auto_me->work, ath11k_nss_me_work);
+	auto_me->mdb.notifier_call = ath11k_nss_me_notify;
+	if (br_mcast_offload_mdb_register_notify(&auto_me->mdb)) {
+		br_mcast_flight_put(auto_me->flight);
+		auto_me->flight = NULL;
+		return;
+	}
+	auto_me->registered = true;
+	spin_lock_bh(&arvif->ar->ab->base_lock);
+	auto_me->initialized = true;
+	spin_unlock_bh(&arvif->ar->ab->base_lock);
+}
+
+void ath11k_nss_me_start(struct ath11k_vif *arvif)
+{
+	struct ath11k_nss_me_auto *auto_me = &arvif->nss.me_auto;
+
+	lockdep_assert_held(&arvif->ar->conf_mutex);
+	ath11k_nss_me_init(arvif);
+	spin_lock_bh(&arvif->ar->ab->base_lock);
+	if (auto_me->initialized && !auto_me->closing && !auto_me->retained) {
+		auto_me->running = true;
+		ath11k_nss_me_dirty_locked(arvif);
+	}
+	spin_unlock_bh(&arvif->ar->ab->base_lock);
+}
+
+void ath11k_nss_me_stop(struct ath11k_vif *arvif, bool destroy)
+{
+	struct ath11k_nss_me_auto *auto_me = &arvif->nss.me_auto;
+	struct ath11k_nss_me_policy *old;
+	struct wireless_dev *wdev;
+
+	lockdep_assert_held(&arvif->ar->conf_mutex);
+	if (!auto_me->initialized)
+		return;
+	spin_lock_bh(&arvif->ar->ab->base_lock);
+	auto_me->active = false;
+	auto_me->running = false;
+	auto_me->closing |= destroy;
+	auto_me->generation++;
+	spin_unlock_bh(&arvif->ar->ab->base_lock);
+	if (destroy && auto_me->registered) {
+		br_mcast_offload_mdb_unregister_notify(&auto_me->mdb);
+		auto_me->registered = false;
+	}
+	cancel_delayed_work_sync(&auto_me->work);
+	wdev = ieee80211_vif_to_wdev(arvif->vif);
+	br_mcast_offload_set_mcu(wdev->netdev, 0, 0, false);
+	if (!wait_event_timeout(auto_me->flight->drained,
+				!atomic_read(&auto_me->flight->pending), msecs_to_jiffies(3000))) {
+		auto_me->retained = true;
+		arvif->nss.me.uncertain = true;
+		ath11k_warn(arvif->ar->ab, "NSS ME table reader drain timed out; retain VDEV %d\n",
+			    arvif->nss.if_num);
+	}
+	spin_lock_bh(&arvif->ar->ab->base_lock);
+	old = auto_me->policy;
+	auto_me->policy = NULL;
+	spin_unlock_bh(&arvif->ar->ab->base_lock);
+	ath11k_nss_me_policy_free(arvif, old);
+	arvif->nss.me.mdb_staged = false;
+	if (destroy) {
+		br_mcast_flight_put(auto_me->flight);
+		auto_me->flight = NULL;
+		auto_me->initialized = false;
+	}
+}
