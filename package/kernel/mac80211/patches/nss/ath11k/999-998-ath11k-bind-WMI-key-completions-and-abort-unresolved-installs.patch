+static bool ath11k_mac_key_install_available_locked(struct ath11k *ar)
+{
+	lockdep_assert_held(&ar->ab->base_lock);
+	return ar->ab->wmi_key_admitting && !ar->install_key.closed &&
+		!(ar->ab->wmi_key_poisoned & BIT(ar->pdev_idx)) &&
+		!test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags) &&
+		!test_bit(ATH11K_FLAG_QMI_FAIL, &ar->ab->dev_flags) &&
+		!test_bit(ATH11K_FLAG_UNREGISTERING, &ar->ab->dev_flags) &&
+		(ar->state == ATH11K_STATE_ON || ar->state == ATH11K_STATE_RESTARTED);
 }
 
