+	br = netdev_priv(dev);
+	key = *addr;
+	if (capacity) {
+		indices = kmalloc_array(capacity, sizeof(*indices), GFP_ATOMIC);
+		if (!indices)
+			return -ENOMEM;
+	}
+	rcu_read_lock();
+	spin_lock_bh(&br->multicast_lock);
+	if (!br_opt_get(br, BROPT_MULTICAST_ENABLED)) {
+		count = -EOPNOTSUPP;
+		goto out;
+	}
+	brmctx = &br->multicast_ctx;
+#ifdef CONFIG_BRIDGE_VLAN_FILTERING
+	if (br_opt_get(br, BROPT_MCAST_VLAN_SNOOPING_ENABLED)) {
+		vlan = br_vlan_find(rcu_dereference(br->vlgrp), key.vid);
+		if (!vlan || br_multicast_ctx_vlan_global_disabled(&vlan->br_mcast_ctx))
+			goto out;
+		brmctx = &vlan->br_mcast_ctx;
+	}
+#endif
+	if (!br_multicast_should_handle_mode(brmctx, key.proto))
+		memset(&key.src, 0, sizeof(key.src));
+	mp = br_mdb_ip_get(br, &key);
+	if (!mp && !br_multicast_is_star_g(&key)) {
+		memset(&key.src, 0, sizeof(key.src));
+		mp = br_mdb_ip_get(br, &key);
+	}
+	if (!mp)
+		goto out;
+	/* No NSS host-copy destination is provided by this interface. */
+	eth.h_proto = addr->proto;
+	meta.protocol = addr->proto;
+	if (!br_multicast_querier_exists(brmctx, &eth, mp)) {
+		count = -EAGAIN;
+		goto out;
+	}
+	if (mp->host_joined || (dev->flags & IFF_ALLMULTI) ||
+	    br_multicast_is_router(brmctx, &meta)) {
+		count = -EOPNOTSUPP;
+		goto out;
+	}
+	count = br_mcast_offload_ports(brmctx, mp, NULL, 0);
+	if (count < 0)
+		goto out;
+	if ((u32)count > capacity) {
+		count = -E2BIG;
+		goto out;
+	}
+	copied = br_mcast_offload_ports(brmctx, mp, indices, capacity);
+	if (copied != count) {
+		count = copied < 0 ? copied : -EAGAIN;
+		goto out;
+	}
+	if (count > 0)
+		memcpy(ifindexes, indices, count * sizeof(*indices));
+	if (seq)
+		*seq = atomic64_read(&br->mcast_offload_seq);
+out:
+	spin_unlock_bh(&br->multicast_lock);
+	rcu_read_unlock();
+	kfree(indices);
+	return count;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_get_ifindexes);
