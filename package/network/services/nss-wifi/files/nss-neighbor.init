#!/bin/sh /etc/rc.common
START=56
STOP=44
USE_PROCD=1

start_service() {
	local enabled neighbor
	. /lib/functions.sh
	config_load nss-wifi
	config_get_bool enabled main enabled 1
	config_get_bool neighbor main relay_neighbor_refresh 1
	[ "$enabled" = 1 ] && [ "$neighbor" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/nss-relay-neighbor-watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 7
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nss-wifi
}
