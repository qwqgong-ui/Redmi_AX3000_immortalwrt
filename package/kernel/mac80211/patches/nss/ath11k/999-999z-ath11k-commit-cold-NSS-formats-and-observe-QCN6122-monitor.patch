+static void ath11k_dp_rx_mon_observe_header(struct ath11k *ar, struct sk_buff *skb)
+{
+	__le16 fc, ba_control;
+	u16 control;
+	int hdrlen, index;
+
+	if (skb_copy_bits(skb, 0, &fc, sizeof(fc)))
+		goto short_header;
+	if (fc & cpu_to_le16(IEEE80211_FCTL_VERS))
+		goto invalid_header;
+	hdrlen = ieee80211_hdrlen(fc);
+	if (skb->len < hdrlen)
+		goto short_header;
+	if (ieee80211_is_data(fc))
+		index = ATH11K_MON_HEADER_DATA;
+	else if (ieee80211_is_ctl(fc))
+		index = ATH11K_MON_HEADER_CONTROL;
+	else if (ieee80211_is_mgmt(fc))
+		index = ATH11K_MON_HEADER_MANAGEMENT;
+	else
+		goto invalid_header;
+	atomic64_inc(&ar->monitor_observation[index]);
+	if (!ieee80211_is_back(fc))
+		return;
+	if (skb_copy_bits(skb, 16, &ba_control, sizeof(ba_control)))
+		goto other_ba;
+	control = le16_to_cpu(ba_control);
+	if (control & IEEE80211_BAR_CTRL_MULTI_TID)
+		goto other_ba;
+	/* Single-TID BA: MAC header + control + SSN + compressed/basic bitmap. */
+	if (skb->len < ((control & IEEE80211_BAR_CTRL_CBMTID_COMPRESSED_BA) ? 28 : 148))
+		goto other_ba;
+	atomic64_inc(&ar->monitor_observation[ATH11K_MON_BA_COMPLETE]);
+	return;
+other_ba:
+	atomic64_inc(&ar->monitor_observation[ATH11K_MON_BA_OTHER]);
+	return;
+short_header:
+	atomic64_inc(&ar->monitor_observation[ATH11K_MON_HEADER_SHORT]);
+	return;
+invalid_header:
+	atomic64_inc(&ar->monitor_observation[ATH11K_MON_HEADER_INVALID]);
+}
