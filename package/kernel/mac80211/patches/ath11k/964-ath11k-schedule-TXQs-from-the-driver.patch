Subject: [PATCH] wifi: ath11k: schedule TXQs from the driver

ath11k uses ieee80211_handle_wake_tx_queue(), so a scheduling round can
only be started by mac80211, i.e. when a frame arrives from the network
stack (or on a block ack session change, a station leaving powersave, or a
stopped queue restarting). For the completion-driven round that follows,
the driver needs to be able to start one itself.

Move the round into the driver: dequeue through a deficit round robin over
ieee80211_next_txq(), which is what the generic handler does today, so the
airtime fairness accounting added in the previous patch keeps working. The
per frame ieee80211_txq_airtime_check() ends a selection where the airtime
queue limit binds and drains the station's queue where it does not.

Rounds are now started from two contexts, so they are serialised on a new
per radio lock; mac80211 requires that a driver never runs two rounds for
the same hw concurrently.

This is a backport of patch 5/9 of the series

  [PATCH ath-next v3 0/9] wifi: ath11k: airtime queue limits, fairness and
  a driver TXQ scheduler

posted to linux-wireless by Julius Bairaktaris <julius@bairaktaris.de>
(message-id 20260824142350.1757379-1-julius@bairaktaris.de). The series is
not merged upstream yet and the original diffs were not reachable from the
build host, so the change was reimplemented against backports 6.18.26 from
the series description. It therefore carries no upstream Signed-off-by and
may differ from the patch that eventually lands.

diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index f892731..94d8b96 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -701,6 +701,12 @@ struct ath11k {
 	 */
 	spinlock_t data_lock;
 
+	/* serialises TXQ scheduling rounds; mac80211 requires that the
+	 * driver never runs two rounds for the same hw concurrently, and
+	 * rounds are started both from wake_tx_queue and from tx completion
+	 */
+	spinlock_t txq_lock;
+
 	struct list_head arvifs;
 	/* should never be NULL; needed for regular htt rx */
 	struct ieee80211_channel *rx_channel;
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index ae37f0e..2f2ce10 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6182,12 +6182,10 @@ static int ath11k_mac_mgmt_tx(struct ath11k *ar, struct sk_buff *skb,
 	return 0;
 }
 
-static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
-			     struct ieee80211_tx_control *control,
-			     struct sk_buff *skb)
+static int ath11k_mac_tx(struct ath11k *ar, struct ieee80211_sta *sta,
+			 struct sk_buff *skb)
 {
 	struct ath11k_skb_cb *skb_cb = ATH11K_SKB_CB(skb);
-	struct ath11k *ar = hw->priv;
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
 	struct ieee80211_vif *vif = info->control.vif;
 	struct ath11k_vif *arvif = ath11k_vif_to_arvif(vif);
@@ -6216,17 +6214,74 @@ static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
 				    ret);
 			ieee80211_free_txskb(ar->hw, skb);
 		}
-		return;
+		return 0;
 	}
 
-	if (control->sta)
-		arsta = ath11k_sta_to_arsta(control->sta);
+	if (sta)
+		arsta = ath11k_sta_to_arsta(sta);
 
 	ret = ath11k_dp_tx(ar, arvif, arsta, skb);
 	if (unlikely(ret)) {
 		ath11k_warn(ar->ab, "failed to transmit frame %d\n", ret);
 		ieee80211_free_txskb(ar->hw, skb);
 	}
+
+	return ret;
+}
+
+static void ath11k_mac_push_txq(struct ath11k *ar, struct ieee80211_txq *txq)
+{
+	struct ieee80211_hw *hw = ar->hw;
+	struct sk_buff *skb;
+
+	/* The airtime queue limit is checked per frame rather than only at
+	 * selection time: a station whose limit binds mid-selection must stop
+	 * here, otherwise the whole mac80211 backlog ends up in the hardware
+	 * rings again and the limit never holds anything back.
+	 */
+	while (ieee80211_txq_airtime_check(hw, txq)) {
+		skb = ieee80211_tx_dequeue(hw, txq);
+		if (!skb)
+			break;
+
+		ath11k_mac_tx(ar, txq->sta, skb);
+	}
+}
+
+void ath11k_mac_tx_push_pending(struct ath11k *ar, u8 ac)
+{
+	struct ieee80211_hw *hw = ar->hw;
+	struct ieee80211_txq *txq;
+
+	rcu_read_lock();
+	spin_lock_bh(&ar->txq_lock);
+
+	ieee80211_txq_schedule_start(hw, ac);
+	while ((txq = ieee80211_next_txq(hw, ac))) {
+		ath11k_mac_push_txq(ar, txq);
+		ieee80211_return_txq(hw, txq, false);
+	}
+	ieee80211_txq_schedule_end(hw, ac);
+
+	spin_unlock_bh(&ar->txq_lock);
+	rcu_read_unlock();
+}
+
+static void ath11k_mac_op_wake_tx_queue(struct ieee80211_hw *hw,
+					struct ieee80211_txq *txq)
+{
+	struct ath11k *ar = hw->priv;
+
+	ath11k_mac_tx_push_pending(ar, txq->ac);
+}
+
+static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
+			     struct ieee80211_tx_control *control,
+			     struct sk_buff *skb)
+{
+	struct ath11k *ar = hw->priv;
+
+	ath11k_mac_tx(ar, control->sta, skb);
 }
 
 void ath11k_mac_drain_tx(struct ath11k *ar)
@@ -9907,7 +9962,7 @@ static int ath11k_mac_op_sta_state(struct ieee80211_hw *hw,
 
 static const struct ieee80211_ops ath11k_ops = {
 	.tx				= ath11k_mac_op_tx,
-	.wake_tx_queue			= ieee80211_handle_wake_tx_queue,
+	.wake_tx_queue			= ath11k_mac_op_wake_tx_queue,
 	.start                          = ath11k_mac_op_start,
 	.stop                           = ath11k_mac_op_stop,
 	.reconfig_complete              = ath11k_mac_op_reconfig_complete,
@@ -10642,6 +10697,7 @@ int ath11k_mac_allocate(struct ath11k_base *ab)
 
 		pdev->ar = ar;
 		spin_lock_init(&ar->data_lock);
+		spin_lock_init(&ar->txq_lock);
 		INIT_LIST_HEAD(&ar->arvifs);
 		INIT_LIST_HEAD(&ar->ppdu_stats_info);
 		mutex_init(&ar->conf_mutex);
diff --git a/drivers/net/wireless/ath/ath11k/mac.h b/drivers/net/wireless/ath/ath11k/mac.h
index 5e61eea..2accbd6 100644
--- a/drivers/net/wireless/ath/ath11k/mac.h
+++ b/drivers/net/wireless/ath/ath11k/mac.h
@@ -161,6 +161,7 @@ struct ath11k *ath11k_mac_get_ar_by_vdev_id(struct ath11k_base *ab, u32 vdev_id)
 struct ath11k *ath11k_mac_get_ar_by_pdev_id(struct ath11k_base *ab, u32 pdev_id);
 
 void ath11k_mac_drain_tx(struct ath11k *ar);
+void ath11k_mac_tx_push_pending(struct ath11k *ar, u8 ac);
 void ath11k_mac_peer_cleanup_all(struct ath11k *ar);
 int ath11k_mac_tx_mgmt_pending_free(int buf_id, void *skb, void *ctx);
 u8 ath11k_mac_bw_to_mac80211_bw(u8 bw);
