+/* Build both tables while ME is positively disabled. This does not publish
+ * bridge MCU or claim the data-plane fallback/automatic lifecycle is ready.
+ */
+static int ath11k_nss_me_mdb_stage(struct ath11k_vif *arvif)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_nss_me_state *me = &arvif->nss.me;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(arvif->vif);
+	struct br_mcast_offload_lookup_snapshot snapshot;
+	struct br_mcast_offload_host *hosts = NULL;
+	struct ath11k_nss_me_member *members = NULL;
+	struct ath11k_nss_me_pin *pins = NULL;
+	struct br_ip *keys = NULL;
+	struct nss_wifi_vdev_msg *msg = NULL;
+	u32 host_capacity, key_capacity, count = 0, i, pass, groups = 0;
+	int ret = -EUCLEAN;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	me->mdb_staged = false;
+	me->mdb_seq = 0;
+	me->mdb_members = 0;
+	me->mdb_groups = 0;
+	if (me->uncertain || !me->mode_known || me->mode != 4 || !me->table_known ||
+	    (me->global_mode != 5 && me->global_mode != 6))
+		goto out;
+	ret = br_mcast_offload_snapshot_lookups(wdev->netdev, NULL, 0, NULL, 0, &snapshot);
+	if (ret && ret != -E2BIG)
+		goto out;
+	host_capacity = snapshot.host_count;
+	key_capacity = snapshot.key_count;
+	if (host_capacity > 2048 || key_capacity > 8192) {
+		ret = -E2BIG;
+		goto out;
+	}
+	hosts = kvcalloc(max_t(u32, host_capacity, 1), sizeof(*hosts), GFP_KERNEL);
+	keys = kvcalloc(max_t(u32, key_capacity, 1), sizeof(*keys), GFP_KERNEL);
+	members = kvcalloc(max_t(u32, host_capacity, 1), sizeof(*members), GFP_KERNEL);
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!hosts || !keys || !members || !msg) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = br_mcast_offload_snapshot_lookups(wdev->netdev, hosts, host_capacity,
+					      keys, key_capacity, &snapshot);
+	if (ret)
+		goto out;
+	ret = ath11k_nss_me_plan_build(hosts, keys, &snapshot, members, host_capacity, &count);
+	if (ret)
+		goto out;
+	pins = kvcalloc(max_t(u32, count, 1), sizeof(*pins), GFP_KERNEL);
+	if (!pins) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	for (i = 0; i < count; i++) {
+		struct ath11k_peer *peer;
+		struct ath11k_nss_peer_state *state;
+
+		spin_lock_bh(&ab->base_lock);
+		ret = ath11k_nss_me_admit(arvif);
+		peer = ret ? NULL : ath11k_peer_find(ar, arvif->vdev_id, members[i].mac);
+		if (!ret && (!peer || !peer->sta || !peer->is_authorized || peer->vif != arvif->vif))
+			ret = -ENOENT;
+		if (!ret) {
+			state = ath11k_nss_key_get(ar, peer);
+			if (IS_ERR_OR_NULL(state)) {
+				ret = state ? PTR_ERR(state) : -ESHUTDOWN;
+			} else {
+				ath11k_peer_get(peer);
+				pins[i].peer = peer;
+				pins[i].state = state;
+				pins[i].peer_id = peer->peer_id;
+			}
+		}
+		spin_unlock_bh(&ab->base_lock);
+		if (ret)
+			goto out;
+	}
+	ret = ath11k_nss_me_recheck_plan(arvif, pins, count, &snapshot);
+	if (ret)
+		goto out;
+	for (i = 0; i < count; i++) {
+		u32 j;
+
+		for (j = 0; j < i; j++)
+			if (ath11k_nss_me_same_group(&members[i].group, &members[j].group))
+				break;
+		groups += j == i;
+	}
+	for (pass = 0; pass < 2; pass++) {
+		ret = ath11k_nss_me_fill_table(arvif, members, pins, count, msg);
+		if (ret)
+			goto out;
+		ret = ath11k_nss_me_recheck_plan(arvif, pins, count, &snapshot);
+		if (ret)
+			goto out;
+		memset(msg, 0, sizeof(*msg));
+		ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_SNOOPLIST_TOGGLE_MSG,
+					     0, NULL, NULL);
+		if (ret)
+			goto out;
+		me->table ^= 1;
+	}
+	/* enable5/6 selects table0, so both sides must be complete before enable. */
+	if (me->table) {
+		memset(msg, 0, sizeof(*msg));
+		ret = ath11k_nss_me_exchange(arvif, msg, NSS_WIFI_VDEV_SNOOPLIST_TOGGLE_MSG,
+					     0, NULL, NULL);
+		if (ret)
+			goto out;
+		me->table = 0;
+	}
+	ret = ath11k_nss_me_recheck_plan(arvif, pins, count, &snapshot);
+	if (!ret) {
+		me->mdb_seq = snapshot.seq;
+		me->mdb_members = count;
+		me->mdb_groups = groups;
+		me->mdb_staged = true;
+	}
+out:
+	me->mdb_result = ret;
+	if (pins)
+		for (i = 0; i < count; i++) {
+			if (pins[i].peer)
+				ath11k_peer_put(ar, pins[i].peer);
+			if (pins[i].state)
+				ath11k_nss_key_put(pins[i].state);
+		}
+	kvfree(pins);
+	kvfree(members);
+	kvfree(keys);
+	kvfree(hosts);
+	kfree(msg);
+	return ret;
+}
+#else
+static int ath11k_nss_me_mdb_stage(struct ath11k_vif *arvif)
+{
+	arvif->nss.me.mdb_result = -EOPNOTSUPP;
+	return -EOPNOTSUPP;
+}
+#endif
