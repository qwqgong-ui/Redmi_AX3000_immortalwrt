+static ssize_t ath11k_debugfs_reo_cmd_stats(struct file *file,
+					 char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath11k_base *ab = file->private_data;
+	struct ath11k_dp *dp = &ab->dp;
+	struct ath11k_reo_cmd_stats stats;
+	char buf[768];
+	bool accepting;
+	u64 epoch;
+	int len;
+
+	spin_lock_bh(&dp->reo_cmd_lock);
+	stats = dp->reo_cmd_stats;
+	accepting = dp->reo_cmd_accepting;
+	epoch = dp->reo_cmd_epoch;
+	spin_unlock_bh(&dp->reo_cmd_lock);
+	len = scnprintf(buf, sizeof(buf),
+		"accepting: %u\nepoch: %llu\npending: %u\nsubmitted: %llu\nstatus_requested: %llu\n"
+		"completed: %llu\ncallbacks_registered: %llu\ncallbacks_claimed: %llu\n"
+		"submit_failed: %llu\nallocation_failed: %llu\nslot_busy: %llu\n"
+		"unexpected_status: %llu\ntag_mismatch: %llu\n",
+		accepting, epoch, stats.pending, stats.submitted, stats.status_requested,
+		stats.completed, stats.callbacks_registered, stats.callbacks_claimed,
