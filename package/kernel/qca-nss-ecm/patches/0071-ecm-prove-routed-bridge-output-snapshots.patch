Subject: [PATCH] ecm: expand only proven MFC output bridges as local-out

Validate the current MFC cookie and output list before relaxing bridge
host-copy constraints.  Synthetic input-bridge copies keep the L2 getter.

--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -37,6 +37,8 @@
 #include <linux/wireless.h>
 #if defined(ECM_MULTICAST_ENABLE) && defined(ECM_MCAST_LINUX_SNOOPER_SUPPORT)
 #include <linux/if_bridge.h>
+#include <linux/mroute.h>
+#include <linux/mroute6.h>
 #endif
 #ifdef ECM_MULTICAST_ENABLE
 #include <linux/workqueue.h>
@@ -5359,6 +5361,57 @@
 	}
 }
 
+#ifdef ECM_MCAST_LINUX_SNOOPER_SUPPORT
+/* A routed hierarchy can contain an added input bridge as well as true MFC
+ * outputs.  Only the latter use bridge local-out (without a host copy).
+ */
+static int ecm_interface_multicast_routed_bridge_get_if(
+		struct ecm_front_end_connection_instance *feci,
+		struct net_device *brdev, bool input_bridge,
+		ip_addr_t origin, ip_addr_t group, uint32_t max_dst,
+		uint32_t *dst_dev, bool is_v4)
+{
+	uint32_t routed_ifindexes[ECM_DB_MULTICAST_IF_MAX];
+	struct br_ip ip = {};
+	u64 cookie = 0, seq;
+	int count, i;
+
+	if (input_bridge)
+		return ecm_interface_linux_mcs_bridge_get_if(brdev, origin,
+				group, max_dst, dst_dev, is_v4);
+	if (is_v4) {
+		ip.proto = htons(ETH_P_IP);
+		ip.src.ip4 = htonl(origin[0]);
+		ip.dst.ip4 = htonl(group[0]);
+		count = ipmr_find_mfc_entry(&init_net, ip.src.ip4, ip.dst.ip4,
+				ECM_DB_MULTICAST_IF_MAX, routed_ifindexes, &cookie);
+	} else {
+#ifdef ECM_IPV6_ENABLE
+		ip.proto = htons(ETH_P_IPV6);
+		ECM_IP_ADDR_TO_NIN6_ADDR(ip.src.ip6, origin);
+		ECM_IP_ADDR_TO_NIN6_ADDR(ip.dst.ip6, group);
+		count = ip6mr_find_mfc_entry(&init_net, &ip.src.ip6, &ip.dst.ip6,
+				ECM_DB_MULTICAST_IF_MAX, routed_ifindexes, &cookie);
+#else
+		return -EOPNOTSUPP;
+#endif
+	}
+	if (count > ECM_DB_MULTICAST_IF_MAX)
+		return -E2BIG;
+	if (count <= 0)
+		return count < 0 ? count : -ENOENT;
+	if (!cookie || cookie != feci->multicast_route_cookie)
+		return -ESTALE;
+	for (i = 0; i < count; i++) {
+		if (routed_ifindexes[i] == (uint32_t)brdev->ifindex)
+			return br_mcast_offload_get_routed_egress_ifindexes(brdev,
+					&ip, dst_dev, max_dst, &seq);
+	}
+	return ecm_interface_linux_mcs_bridge_get_if(brdev, origin, group,
+			max_dst, dst_dev, is_v4);
+}
+#endif
+
 /*
  * ecm_interface_multicast_heirarchy_construct_routed()
  *	Create destination interface heirarchy for a routed multicast connectiona
