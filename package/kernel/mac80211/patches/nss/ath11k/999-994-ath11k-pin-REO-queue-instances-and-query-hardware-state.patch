+int ath11k_dp_reo_queue_query(struct ath11k_base *ab, u32 vdev_id,
+			    const u8 *mac, u8 tid, struct ath11k_reo_query_result *result)
+{
+	struct ath11k_dp *dp = &ab->dp;
+	struct ath11k_reo_query *query;
+	struct ath11k_peer *peer;
+	struct dp_rx_tid *rx_tid;
+	int ret;
+
+	memset(result, 0, sizeof(*result));
+	result->vdev_id = vdev_id;
+	ether_addr_copy(result->mac, mac);
+	result->tid = tid;
+	result->status.uniform_hdr.cmd_status = HAL_REO_CMD_DRAIN;
+	if (tid > IEEE80211_NUM_TIDS) {
+		result->error = -EINVAL;
+		return -EINVAL;
