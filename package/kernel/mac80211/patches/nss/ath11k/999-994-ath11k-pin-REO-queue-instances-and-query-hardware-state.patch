+static int ath11k_dp_tx_reo_submit_locked(struct ath11k_base *ab,
+					enum hal_reo_cmd_type type,
+					struct ath11k_hal_reo_cmd *cmd,
+					struct dp_reo_cmd *entry, u64 epoch)
+{
+	struct ath11k_dp *dp = &ab->dp;
+	struct hal_srng *ring;
+	int cmd_num;
+
+	lockdep_assert_held(&dp->reo_cmd_lock);
+	if (!dp->reo_cmd_accepting || epoch != dp->reo_cmd_epoch ||
+	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+	    READ_ONCE(ab->nss.ownership_uncertain))
+		return -ESHUTDOWN;
+	if (entry && entry->kind == ATH11K_REO_CMD_QUERY && dp->reo_query_outstanding)
+		return -EBUSY;
+
+	ring = &ab->hal.srng_list[dp->reo_cmd_ring.ring_id];
+	cmd_num = ath11k_hal_reo_cmd_send(ab, ring, type, cmd);
+	if (cmd_num <= 0) {
+		dp->reo_cmd_stats.submit_failed++;
+		return cmd_num < 0 ? cmd_num : -EINVAL;
+	}
+	dp->reo_cmd_stats.submitted++;
+	if (cmd->flag & HAL_REO_CMD_FLG_NEED_STATUS) {
+		dp->reo_cmd_status_tag[cmd_num] = ath11k_dp_reo_cmd_status_tag(type);
+		dp->reo_cmd_stats.status_requested++;
+		dp->reo_cmd_stats.pending++;
+	}
+	if (entry) {
+		entry->cmd_num = cmd_num;
+		if (entry->kind == ATH11K_REO_CMD_QUERY) {
+			refcount_inc(&entry->query->refs);
+			entry->query->cmd_num = cmd_num;
+			dp->reo_query_outstanding = true;
+		}
+		list_add_tail(&entry->list, &dp->reo_cmd_list);
+		dp->reo_cmd_stats.callbacks_registered++;
+	}
+	return cmd_num;
+}
