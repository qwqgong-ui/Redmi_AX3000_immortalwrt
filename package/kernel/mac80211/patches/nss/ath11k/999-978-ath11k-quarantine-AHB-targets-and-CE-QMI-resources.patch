Subject: [PATCH] ath11k: exclude quarantined AHB targets and close CE/QMI cleanup

Reject reprobe before hardware operations, keep CE and QMI DMA,
and revoke only initialized QMI CPU resources. Gate new events
before queue destruction and preserve the startup error result.

--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -1211,6 +1211,11 @@
 
 	hw_rev = (uintptr_t)device_get_match_data(&pdev->dev);
 
+	if (ath11k_nss_hw_quarantined(hw_rev)) {
+		dev_err(&pdev->dev, "NSS shared DMA ownership unresolved; reboot required before reprobe\n");
+		return -EBUSY;
+	}
+
 	switch (hw_rev) {
 	case ATH11K_HW_IPQ8074:
 	case ATH11K_HW_IPQ6018_HW10:
@@ -1347,13 +1352,19 @@
 
 	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
 	cancel_work_sync(&ab->restart_work);
-	cancel_work_sync(&ab->qmi.event_work);
+	if (ab->qmi.event_work_initialized)
+		cancel_work_sync(&ab->qmi.event_work);
 	cancel_work_sync(&ab->wmi_ast_work);
 }
 
 static void ath11k_ahb_free_resources(struct ath11k_base *ab)
 {
 	struct platform_device *pdev = ab->pdev;
+
+	/* Also closes the unregistered/shutdown path; stage flags make repeated
+	 * service cleanup safe after core_deinit() or the QMI-fail branch.
+	 */
+	ath11k_qmi_deinit_service(ab);
 
 	ath11k_ahb_free_irq(ab);
 	ath11k_hal_srng_deinit(ab);
