+		[ATH11K_MON_MERGE_FAILED] = "merge_failed",
+		[ATH11K_MON_HEADER_DATA] = "complete_data_header",
+		[ATH11K_MON_HEADER_CONTROL] = "complete_control_header",
+		[ATH11K_MON_HEADER_MANAGEMENT] = "complete_management_header",
+		[ATH11K_MON_HEADER_SHORT] = "short_header",
+		[ATH11K_MON_HEADER_INVALID] = "invalid_header",
+		[ATH11K_MON_BA_COMPLETE] = "complete_single_tid_ba",
+		[ATH11K_MON_BA_OTHER] = "other_or_short_ba",
+		[ATH11K_MON_SUBMITTED] = "submitted_to_mac80211",
+		[ATH11K_MON_FCS_BAD] = "fcs_bad_merge",
+		[ATH11K_MON_STARTS] = "monitor_starts",
+	};
+	struct ath11k *ar = s->private;
+	struct ath11k_vif *arvif;
+	int i;
+
+	seq_puts(s, "scope: radio_lifetime_nonatomic_snapshot\n");
+	for (i = 0; i < ATH11K_MON_OBSERVATION_MAX; i++)
+		seq_printf(s, "%s: %lld\n", names[i], atomic64_read(&ar->monitor_observation[i]));
+	mutex_lock(&ar->conf_mutex);
+	seq_printf(s, "vdev_id: %d\ncreated: %u\nstarted: %u\nlast_errno: %d\nconcurrent_decap: %u\n",
+		   ar->monitor_vdev_id,
+		   test_bit(ATH11K_FLAG_MONITOR_VDEV_CREATED, &ar->monitor_flags),
+		   test_bit(ATH11K_FLAG_MONITOR_STARTED, &ar->monitor_flags),
+		   READ_ONCE(ar->monitor_last_errno),
+		   ieee80211_hw_check(ar->hw, SUPPORTS_CONC_MON_RX_DECAP));
+	list_for_each_entry(arvif, &ar->arvifs, list) {
+		if (!arvif->nss.created)
+			continue;
+		seq_printf(s, "nss_vdev: %u ifnum=%d encap=%d decap=%d ready=%u failed=%u flags=0x%x\n",
+			   arvif->vdev_id, arvif->nss.if_num,
+			   READ_ONCE(arvif->nss.encap), READ_ONCE(arvif->nss.decap),
+			   READ_ONCE(arvif->nss.format_ready), READ_ONCE(arvif->nss.format_failed),
+			   arvif->vif->offload_flags);
+	}
+	mutex_unlock(&ar->conf_mutex);
+	return 0;
+}
