Subject: [PATCH] nss: keep complete AP multicast fanout under host policy

Native Linux bridge/MFC events invalidate complete ECM multicast rules. An AP
output must not be removed from a hardware fanout and leave a partial rule,
nor bypass the host's MDB/ME policy. Scan all hierarchy layers with owned
netdev references both during construction and before CREATE submission.

--- a/frontends/nss/ecm_nss_common.h
+++ b/frontends/nss/ecm_nss_common.h
@@ -33,6 +33,83 @@
 #endif
 
 #include <net/xfrm.h>
+#include <net/cfg80211.h>
+
+#ifdef ECM_MULTICAST_ENABLE
+/* Reject the complete fanout if a host-managed AP appears at any hierarchy
+ * layer. Removing only that output would leave an incomplete hardware rule.
+ * Netdev references pin mac80211's embedded wdev; RCU also covers cfg80211
+ * unregister. This type snapshot is not a type-change/firmware-drain barrier.
+ */
+static inline bool ecm_nss_common_multicast_fanout_allowed(
+		struct ecm_db_iface_instance *to_ifaces, int32_t *first)
+{
+	int row, layer;
+	bool seen = false;
+
+	for (row = 0; row < ECM_DB_MULTICAST_IF_MAX; row++) {
+		int start = *ecm_db_multicast_if_first_get_at_index(first, row);
+		struct ecm_db_iface_instance **ifaces;
+
+		if (start == ECM_DB_IFACE_HEIRARCHY_MAX)
+			continue;
+		if (start < 0 || start >= ECM_DB_IFACE_HEIRARCHY_MAX)
+			return false;
+		seen = true;
+		ifaces = (struct ecm_db_iface_instance **)
+				ecm_db_multicast_if_heirarchy_get(to_ifaces, row);
+		if (!ifaces)
+			return false;
+		for (layer = start; layer < ECM_DB_IFACE_HEIRARCHY_MAX; layer++) {
+			struct net_device *dev;
+			struct wireless_dev *wdev;
+			bool allowed = true;
+			int ifindex;
+
+			if (!ifaces[layer])
+				return false;
+			ifindex = ecm_db_iface_interface_identifier_get(ifaces[layer]);
+			rcu_read_lock();
+			dev = dev_get_by_index(&init_net, ifindex);
+			if (!dev) {
+				rcu_read_unlock();
+				return false;
+			}
+			wdev = READ_ONCE(dev->ieee80211_ptr);
+			if (wdev) {
+				enum nl80211_iftype type = READ_ONCE(wdev->iftype);
+
+				allowed = type != NL80211_IFTYPE_AP &&
+					  type != NL80211_IFTYPE_AP_VLAN;
+			}
+			rcu_read_unlock();
+			dev_put(dev);
+			if (!allowed)
+				return false;
+		}
+	}
+	return seen;
+}
+
+static inline bool ecm_nss_common_multicast_outputs_allowed(
+		struct ecm_front_end_connection_instance *feci)
+{
+	struct ecm_db_iface_instance *to_ifaces = NULL;
+	int32_t *first = NULL;
+	bool allowed;
+
+	if (!ecm_db_multicast_connection_to_interfaces_get_and_ref_all(
+			feci->ci, &to_ifaces, &first)) {
+		/* A set but empty DB table still returns allocated snapshots. */
+		if (to_ifaces && first)
+			ecm_db_multicast_connection_to_interfaces_deref_all(to_ifaces, first);
+		return false;
+	}
+	allowed = ecm_nss_common_multicast_fanout_allowed(to_ifaces, first);
+	ecm_db_multicast_connection_to_interfaces_deref_all(to_ifaces, first);
+	return allowed;
+}
+#endif
 
