+/* RX descriptors live in the skb head, including the part before skb->data.
+ * pskb_expand_head() moves that storage, so relocate the descriptor explicitly.
+ * Monitor/fragment callers may use skb->cb for ieee80211_rx_status instead.
+ */
+static int ath11k_dp_rx_expand_head(struct sk_buff *skb, int nhead, int ntail,
+				  struct hal_rx_desc **desc, u32 desc_size)
+{
+	unsigned long offset = 0;
+	int ret;
+
+	if (desc) {
+		if ((unsigned long)*desc < (unsigned long)skb->head ||
+		    (unsigned long)*desc > (unsigned long)skb_tail_pointer(skb) ||
+		    desc_size > (unsigned long)skb_tail_pointer(skb) -
+				(unsigned long)*desc)
+			return -EINVAL;
+		offset = (u8 *)*desc - skb->head;
+	}
+
+	ret = pskb_expand_head(skb, nhead, ntail, GFP_ATOMIC);
+	if (!ret && desc)
+		*desc = (void *)(skb->head + nhead + offset);
+	return ret;
+}
