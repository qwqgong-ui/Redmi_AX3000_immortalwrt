+static bool br_mcast_offload_mcu_supported(const struct net_bridge_port *p)
+{
+	/* Native M2U runs the forwarding/egress hooks once per unicast DA.
+	 * A group collapse cannot reproduce per-host MAC filters or classifiers.
+	 */
+#ifdef CONFIG_NETFILTER_FAMILY_BRIDGE
+	struct net *net = dev_net(p->dev);
+
+	if (rcu_access_pointer(net->nf.hooks_bridge[NF_BR_FORWARD]) ||
+	    rcu_access_pointer(net->nf.hooks_bridge[NF_BR_LOCAL_OUT]) ||
+	    !br_mcast_offload_ct_only_hooks(rcu_dereference(net->nf.hooks_bridge[NF_BR_POST_ROUTING])))
+		return false;
+#endif
+#ifdef CONFIG_NETFILTER_EGRESS
+	if (rcu_access_pointer(p->dev->nf_hooks_egress))
+		return false;
+#endif
+#ifdef CONFIG_NET_XGRESS
+	if (rcu_access_pointer(p->dev->tcx_egress))
+		return false;
+#endif
+#ifdef CONFIG_NET_SCHED
+	{
+		struct Qdisc *qdisc = rcu_dereference(p->dev->qdisc);
+
+		if (qdisc && strcmp(qdisc->ops->id, "noqueue"))
+			return false;
+	}
+#endif
+	return br_mcast_offload_ap_port(p) &&
+		!br_opt_get(p->br, BROPT_VLAN_ENABLED) &&
+		!br_opt_get(p->br, BROPT_MCAST_VLAN_SNOOPING_ENABLED) &&
+		!br_opt_get(p->br, BROPT_MST_ENABLED) &&
+		!br_opt_get(p->br, BROPT_NEIGH_SUPPRESS_ENABLED) &&
+		!(p->flags & (BR_PROXYARP | BR_PROXYARP_WIFI | BR_NEIGH_SUPPRESS |
+			      BR_NEIGH_VLAN_SUPPRESS | BR_ISOLATED | BR_PORT_LOCKED)) &&
+		!rcu_access_pointer(p->backup_port);
+}
+
+bool br_mcast_offload_mcu_capable(struct net_device *dev)
+{
+	struct net_bridge_port *p;
+	bool capable = false;
+
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (p) {
+		spin_lock_bh(&p->br->multicast_lock);
+		capable = br_mcast_offload_mcu_supported(p);
+		spin_unlock_bh(&p->br->multicast_lock);
+	}
+	rcu_read_unlock();
+	return capable;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_mcu_capable);
+
+bool br_mcast_offload_mcu_valid(const struct net_bridge_port *p)
+{
+	struct br_mcast_offload_lookup_snapshot now = { };
+
+	lockdep_assert_held(&p->br->multicast_lock);
+	if (!p->mcast_hw_to_unicast || !p->mcast_mcu_cookie ||
+	    !br_mcast_offload_mcu_supported(p))
+		return false;
+	br_mcast_offload_conditions(p, &now);
+	return br_mcast_offload_conditions_equal(&now, &p->mcast_hw_snapshot);
+}
+
+int br_mcast_offload_commit_mcu(struct net_device *dev,
+		const struct br_mcast_offload_lookup_snapshot *expected, u64 owner_cookie)
+{
+	struct br_mcast_offload_lookup_snapshot now = { };
+	struct net_bridge_port *p;
+	int ret = -ENODEV;
+
+	if (!expected || !owner_cookie)
+		return -EINVAL;
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (!p)
+		goto out;
+	spin_lock_bh(&p->br->multicast_lock);
+	br_mcast_offload_conditions(p, &now);
+	if (!br_mcast_offload_conditions_equal(&now, expected)) {
+		ret = -ESTALE;
+	} else if (!br_mcast_offload_mcu_supported(p) || !now.snooping ||
+		   !now.forwarding || !now.multicast_to_unicast) {
+		ret = -EOPNOTSUPP;
+	} else {
+		p->mcast_hw_snapshot = *expected;
+		p->mcast_mcu_cookie = owner_cookie;
+		WRITE_ONCE(p->mcast_hw_to_unicast, true);
+		ret = 0;
+	}
+	spin_unlock_bh(&p->br->multicast_lock);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_commit_mcu);
+
