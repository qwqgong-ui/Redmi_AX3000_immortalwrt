 		input = ath11k_dp_reo_update_input(cmd);
 	status_tag = ath11k_dp_reo_cmd_status_tag(type);
@@ -974,51 +1019,55 @@
 			cmd_num = -ENOMEM;
 			goto out;
 		}
-		memcpy(&dp_cmd->data, rx_tid, sizeof(*rx_tid));
+		ath11k_dp_reo_tid_clone(&dp_cmd->data, rx_tid);
+		dp_cmd->kind = ATH11K_REO_CMD_RETIRE;
 		dp_cmd->status_tag = status_tag;
 		dp_cmd->handler = cb;
 	}
 
 	spin_lock_bh(&dp->reo_cmd_lock);
-	if (!dp->reo_cmd_accepting || epoch != dp->reo_cmd_epoch ||
-	    test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
-	    READ_ONCE(ab->nss.ownership_uncertain)) {
-		cmd_num = -ESHUTDOWN;
-		goto unlock;
-	}
-
-	cmd_ring = &ab->hal.srng_list[dp->reo_cmd_ring.ring_id];
-	cmd_num = ath11k_hal_reo_cmd_send(ab, cmd_ring, type, cmd);
-	if (cmd_num <= 0) {
-		if (!cmd_num)
-			cmd_num = -EINVAL;
-		dp->reo_cmd_stats.submit_failed++;
-		goto unlock;
-	}
-
-	dp->reo_cmd_stats.submitted++;
-	if (cmd->flag & HAL_REO_CMD_FLG_NEED_STATUS) {
-		dp->reo_cmd_status_tag[cmd_num] = status_tag;
-		dp->reo_cmd_stats.status_requested++;
-		dp->reo_cmd_stats.pending++;
-	}
-	if (dp_cmd) {
-		dp_cmd->cmd_num = cmd_num;
-		list_add_tail(&dp_cmd->list, &dp->reo_cmd_list);
-		dp->reo_cmd_stats.callbacks_registered++;
-		/* Ownership transfers only after publication and registration succeeded. */
+	cmd_num = ath11k_dp_tx_reo_submit_locked(ab, type, cmd, dp_cmd, epoch);
+	if (cmd_num > 0)
 		dp_cmd = NULL;
-	}
 
 unlock:
 	spin_unlock_bh(&dp->reo_cmd_lock);
 out:
+	if (dp_cmd)
+		ath11k_dp_reo_tid_drop(&dp_cmd->data);
 	kfree(dp_cmd);
 	if (observe)
 		ath11k_dp_reo_update_record(dp, &input, cmd_num);
 	return cmd_num > 0 ? 0 : cmd_num;
 }
 
+int ath11k_dp_tx_reo_query(struct ath11k_base *ab, struct ath11k_reo_query *query)
+{
+	struct ath11k_dp *dp = &ab->dp;
+	struct ath11k_hal_reo_cmd cmd = {
+		.flag = HAL_REO_CMD_FLG_NEED_STATUS,
+		.addr_lo = lower_32_bits(query->queue->paddr),
+		.addr_hi = upper_32_bits(query->queue->paddr),
+	};
+	struct dp_reo_cmd *entry;
+	int ret;
+
+	lockdep_assert_held(&ab->base_lock);
+	entry = kzalloc(sizeof(*entry), GFP_ATOMIC);
+	if (!entry)
+		return -ENOMEM;
+	entry->kind = ATH11K_REO_CMD_QUERY;
+	entry->query = query;
+	entry->status_tag = HAL_REO_GET_QUEUE_STATS_STATUS;
+	spin_lock_bh(&dp->reo_cmd_lock);
+	ret = ath11k_dp_tx_reo_submit_locked(ab, HAL_REO_CMD_GET_QUEUE_STATS,
+					    &cmd, entry, query->result.submit_epoch);
+	spin_unlock_bh(&dp->reo_cmd_lock);
+	if (ret < 0)
+		kfree(entry);
+	return ret > 0 ? 0 : ret;
+}
