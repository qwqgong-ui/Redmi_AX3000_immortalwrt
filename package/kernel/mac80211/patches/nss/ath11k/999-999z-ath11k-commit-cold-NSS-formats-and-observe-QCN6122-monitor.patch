+static int ath11k_nss_80211_header_len(struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr;
+	int len;
+
+	if (!pskb_may_pull(skb, sizeof(hdr->frame_control)))
+		return -EMSGSIZE;
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if ((hdr->frame_control & cpu_to_le16(IEEE80211_FCTL_VERS)) ||
+	    !ieee80211_is_data(hdr->frame_control))
+		return -EINVAL;
+	len = ieee80211_hdrlen(hdr->frame_control);
+	if (!pskb_may_pull(skb, len))
+		return -EMSGSIZE;
+	return len;
+}
