+int br_mcast_offload_snapshot_lookups(struct net_device *dev,
+		struct br_mcast_offload_host hosts[], u32 host_capacity,
+		struct br_ip keys[], u32 key_capacity,
+		struct br_mcast_offload_lookup_snapshot *snapshot)
+{
+	struct net_bridge_mdb_entry *mp;
+	struct net_bridge_port_group *pg;
+	struct net_bridge_port *p;
+	struct net_bridge *br;
+	struct ethhdr eth = { .h_proto = htons(ETH_P_IP) };
+	u32 host_count = 0, key_count = 0, i = 0;
+	int ret = -ENODEV;
+
+	if (!snapshot || (!hosts && host_capacity) || (!keys && key_capacity))
+		return -EINVAL;
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (!p)
+		goto out;
+	br = p->br;
+	spin_lock_bh(&br->multicast_lock);
+	hlist_for_each_entry(pg, &p->mglist, mglist)
+		host_count++;
+	hlist_for_each_entry(mp, &br->mdb_list, mdb_node)
+		key_count++;
+	memset(snapshot, 0, sizeof(*snapshot));
+	snapshot->seq = atomic64_read(&br->mcast_offload_seq);
+	snapshot->host_count = host_count;
+	snapshot->key_count = key_count;
+	snapshot->bridge_ifindex = br->dev->ifindex;
+	snapshot->snooping = br_opt_get(br, BROPT_MULTICAST_ENABLED);
+	snapshot->vlan_snooping = br_opt_get(br, BROPT_MCAST_VLAN_SNOOPING_ENABLED);
+	snapshot->source_filter_ipv4 =
+		br_multicast_should_handle_mode(&br->multicast_ctx, eth.h_proto);
+	snapshot->querier_ipv4 =
+		br_multicast_querier_exists(&br->multicast_ctx, &eth, NULL);
+	snapshot->router_ipv4 = !hlist_unhashed(&p->multicast_ctx.ip4_rlist);
+#if IS_ENABLED(CONFIG_IPV6)
+	eth.h_proto = htons(ETH_P_IPV6);
+	snapshot->source_filter_ipv6 =
+		br_multicast_should_handle_mode(&br->multicast_ctx, eth.h_proto);
+	snapshot->querier_ipv6 =
+		br_multicast_querier_exists(&br->multicast_ctx, &eth, NULL);
+	snapshot->router_ipv6 = !hlist_unhashed(&p->multicast_ctx.ip6_rlist);
+#endif
+	snapshot->forwarding = p->state == BR_STATE_FORWARDING;
+	snapshot->multicast_to_unicast = !!(p->flags & BR_MULTICAST_TO_UNICAST);
+	if (snapshot->vlan_snooping) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	/* Do not expose a partial set: an omitted foreign S,G changes EXCLUDE. */
+	if (host_count > host_capacity || key_count > key_capacity) {
+		ret = -E2BIG;
+		goto unlock;
+	}
+	hlist_for_each_entry(pg, &p->mglist, mglist) {
+		struct br_mcast_offload_host *host = &hosts[i++];
+
+		memset(host, 0, sizeof(*host));
+		host->addr = pg->key.addr;
+		ether_addr_copy(host->host_mac, pg->eth_addr);
+		host->filter_mode = pg->filter_mode;
+		if (pg->host_specific)
+			host->flags |= BR_MCAST_OFFLOAD_HOST_SPECIFIC;
+		if (pg->flags & MDB_PG_FLAGS_PERMANENT)
+			host->flags |= BR_MCAST_OFFLOAD_PERMANENT;
+		if (pg->flags & MDB_PG_FLAGS_STAR_EXCL)
+			host->flags |= BR_MCAST_OFFLOAD_STAR_EXCL;
+		if (pg->flags & MDB_PG_FLAGS_BLOCKED)
+			host->flags |= BR_MCAST_OFFLOAD_BLOCKED;
+	}
+	i = 0;
+	hlist_for_each_entry(mp, &br->mdb_list, mdb_node)
+		keys[i++] = mp->addr;
+	ret = 0;
+unlock:
+	spin_unlock_bh(&br->multicast_lock);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_mcast_offload_snapshot_lookups);
