 #include <net/netfilter/nf_conntrack_helper.h>
@@ -354,6 +355,12 @@ static void ecm_nss_ported_ipv6_connection_accelerate(
 	regen_occurrances = ecm_db_connection_regeneration_occurrances_get(feci->ci);
 
