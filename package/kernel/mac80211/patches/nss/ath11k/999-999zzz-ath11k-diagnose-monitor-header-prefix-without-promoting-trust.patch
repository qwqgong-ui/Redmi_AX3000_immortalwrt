+/* Diagnose the stored prefix without interpreting an oversized TLV as complete.
+ * Bits 0..7 are offsets 0,4,..28 from hdr_status, bounded by both the declared
+ * prefix and the actual compact descriptor. Store comparison results only.
+ */
+static void ath11k_mon_meta_probe(const struct hal_rx_desc_qcn9074 *d,
+				size_t prefix, struct ath11k_mon_meta_record *r)
+{
+	const struct ieee80211_hdr *h;
+	__le16 fc = cpu_to_le16(r->fc);
+	size_t pos, i, qos_offset;
+	u8 bit;
+
+	if (prefix > sizeof(d->hdr_status))
+		prefix = sizeof(d->hdr_status);
+	r->header_bytes = prefix;
+	for (i = 0; i < prefix; i++)
+		r->header_nonzero += !!d->hdr_status[i];
+	if (!(r->flags & ATH11K_MON_META_FC_VALID) || !ieee80211_is_data(fc))
+		return;
+	qos_offset = ieee80211_has_a4(fc) ? 30 : 24;
+	for (i = 0; i < 8; i++) {
+		pos = i * 4;
+		if (pos + 24 > prefix)
+			break;
+		bit = BIT(i);
+		h = (const struct ieee80211_hdr *)(d->hdr_status + pos);
+		if (h->frame_control == fc)
+			r->probe_fc |= bit;
+		if ((r->flags & ATH11K_MON_META_RA_VALID) &&
+		    ether_addr_equal(r->ra, h->addr1))
+			r->probe_ra |= bit;
+		if ((r->flags & ATH11K_MON_META_TA_VALID) &&
+		    ether_addr_equal(r->ta, h->addr2))
+			r->probe_ta |= bit;
+		if ((r->flags & ATH11K_MON_META_SEQ_VALID) &&
+		    r->seq_ctrl == le16_to_cpu(h->seq_ctrl))
+			r->probe_seq |= bit;
+		if ((r->flags & ATH11K_MON_META_QOS_VALID) &&
+		    pos + qos_offset + 2 <= prefix && h->frame_control == fc &&
+		    r->qos == get_unaligned_le16((const u8 *)h + qos_offset))
+			r->probe_qos |= bit;
+	}
+}
