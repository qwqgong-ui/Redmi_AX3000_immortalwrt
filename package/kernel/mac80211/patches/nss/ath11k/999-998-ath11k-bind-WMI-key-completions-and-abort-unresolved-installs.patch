 		return 0;
@@ -4362,15 +4528,27 @@
 			      IEEE80211_KEY_FLAG_RESERVE_TAILROOM;
 
 install:
-	ret = ath11k_wmi_vdev_install_key(arvif->ar, &arg);
-
+	ret = ath11k_mac_key_install_begin(ar, &arg);
 	if (ret)
 		return ret;
-
-	if (!wait_for_completion_timeout(&ar->install_key_done, 1 * HZ))
-		return -ETIMEDOUT;
-
-	return ar->install_key_status ? -EINVAL : 0;
+	ret = ath11k_wmi_vdev_install_key(arvif->ar, &arg);
+
+	if (ret)
+		return ath11k_mac_key_install_finish(ar, ret, false);
+
+	return ath11k_mac_key_install_finish(ar, 0,
+		wait_for_completion_timeout(&ar->install_key_done, HZ));
+}
