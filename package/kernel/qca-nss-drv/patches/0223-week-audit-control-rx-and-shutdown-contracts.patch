+bool nss_control_receive_base(struct nss_ctx_instance *ctx, struct nss_cmn_msg *cm)
+{
+	struct nss_control_request *request;
+	uint64_t cookie = cm->app_data;
+	bool base = false, other = false;
+
+	if (cm->response == NSS_CMN_RESPONSE_NOTIFY ||
+	    cm->cb != (nss_ptr_t)(uintptr_t)nss_control_wire_callback)
+		return false;
+	if (!nss_control_valid(ctx, NSS_CONTROL_BASE_IF, cm->interface) ||
+	    !cookie || cookie > U32_MAX)
+		return true;
+	spin_lock_bh(&nss_control_lock);
+	list_for_each_entry(request, &nss_control_requests, list) {
+		if (request->cookie != cookie)
+			continue;
+		if (request->core_id == ctx->id && request->if_num == cm->interface &&
+		    request->type == cm->type &&
+		    nss_control_registered[request->family][ctx->id][cm->interface]) {
+			base = request->family == NSS_CONTROL_BASE_IF;
+			other = !base;
+		}
+		break;
+	}
+	spin_unlock_bh(&nss_control_lock);
+	if (other)
+		return false;
+	if (base)
+		nss_control_receive(ctx, cm, NSS_CONTROL_BASE_IF, NULL);
+	/* A cancel/close racing the second lookup must not fall through to parsers. */
+	return true;
+}
