index f53971f..21087cd 100644
--- a/net/ipv4/ipmr.c
+++ b/net/ipv4/ipmr.c
@@ -2360,6 +2360,25 @@ static struct mr_table *ipmr_rt_fib_lookup(struct net *net, struct sk_buff *skb)
 /* Multicast packets for forwarding arrive here
  * Called with rcu_read_lock();
  */
+/* Preserve the actual input selection across clone and FORWARD mark changes.
+ * This bit is protocol metadata, not a replacement for skb->mark or iif.
+ */
+static void ipmr_mfc_offload_mark(struct net *net, struct sk_buff *skb, u32 table)
+{
+	IPCB(skb)->flags &= ~IPSKB_MROUTE_OFFLOAD_DEFAULT;
+	if (net_eq(net, &init_net) && table == RT_TABLE_DEFAULT)
+		IPCB(skb)->flags |= IPSKB_MROUTE_OFFLOAD_DEFAULT;
+}
+
+bool ipmr_mfc_offload_eligible(struct net *net, const struct sk_buff *skb)
+{
+	u16 required = IPSKB_FORWARDED | IPSKB_MROUTE_OFFLOAD_DEFAULT;
+
+	return skb && net_eq(net, &init_net) &&
+		(IPCB(skb)->flags & required) == required;
+}
+EXPORT_SYMBOL_GPL(ipmr_mfc_offload_eligible);
+
