Subject: [PATCH] dnsmasq: allow bounded upstream TCP DNS waits

Add opt-in millisecond send/connect and response timeouts so a silent
upstream can be replaced before a client abandons its request. Keep
the existing five/ten-second defaults when the option is absent.
Do not extend a configured fastopen timeout through datagram retries.

--- a/src/dnsmasq.h
+++ b/src/dnsmasq.h
@@ -1263,6 +1263,7 @@
   unsigned long soa_sn, soa_refresh, soa_retry, soa_expiry;
   u32 metrics[__METRIC_MAX];
   int fast_retry_time, fast_retry_timeout;
+  int dns_tcp_send_timeout, dns_tcp_receive_timeout; /* milliseconds; zero uses defaults */
   int cache_max_expiry;
 #ifdef HAVE_DNSSEC
   struct ds_config *ds;
--- a/src/forward.c
+++ b/src/forward.c
@@ -2038,6 +2038,44 @@
 }
 
  
+#if defined(SO_SNDTIMEO) && defined(SO_RCVTIMEO)
+static void set_upstream_tcp_timeouts(int fd)
+{
+  int send_timeout = daemon->dns_tcp_send_timeout ? daemon->dns_tcp_send_timeout : TCP_TIMEOUT * 1000;
+  int receive_timeout = daemon->dns_tcp_receive_timeout ? daemon->dns_tcp_receive_timeout : TCP_TIMEOUT * 2000;
+  struct timeval tv;
+
+  tv.tv_sec = send_timeout / 1000;
+  tv.tv_usec = (send_timeout % 1000) * 1000;
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+  tv.tv_sec = receive_timeout / 1000;
+  tv.tv_usec = (receive_timeout % 1000) * 1000;
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+}
+#endif
+
+#ifdef MSG_FASTOPEN
+static ssize_t send_upstream_tcp_fastopen(int fd, struct msghdr *msg)
+{
+  ssize_t result;
+
+  if (daemon->dns_tcp_send_timeout)
+    {
+      /* EAGAIN here means the configured socket timeout expired, not that
+         the datagram-style retry_send() loop should extend it. */
+      do
+        result = sendmsg(fd, msg, MSG_FASTOPEN);
+      while (result == -1 && errno == EINTR);
+      if (result >= 0)
+        errno = 0;
+    }
+  else
+    while (retry_send(result = sendmsg(fd, msg, MSG_FASTOPEN)));
+
+  return result;
+}
+#endif
+
 /* Send query in header, qsize to a server determined by first,last,start and
    get the reply into the buffer passed by outbuff. Return reply size. */
 static ssize_t tcp_talk(int first, int last, int start, struct dns_header *header, size_t qsize,
@@ -2048,7 +2086,6 @@
   unsigned int rsize = 0;
   int class, rclass, type, rtype;
   unsigned char *p;
-  struct timeval tv;
   struct iovec sendio[2];
 #ifdef MSG_FASTOPEN
   struct msghdr msg;
@@ -2115,11 +2152,7 @@
 	     We set the recieve timeout as twice the send timeout; we
 	     want to fail quickly on a non-responsive server, but give it time to get an
 	     answer. */
-	  tv.tv_sec = TCP_TIMEOUT;
-	  tv.tv_usec = 0;
-	  setsockopt(serv->tcpfd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
-	  tv.tv_sec += TCP_TIMEOUT;
-	  setsockopt(serv->tcpfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+          set_upstream_tcp_timeouts(serv->tcpfd);
 #endif
 #ifdef MSG_FASTOPEN
 	  msg.msg_name = &serv->addr.sa;
@@ -2130,11 +2163,12 @@
 	  msg.msg_controllen = 0;
 	  msg.msg_flags = 0;
 
-	  while (retry_send(sendmsg(serv->tcpfd, &msg, MSG_FASTOPEN)));
+	  send_upstream_tcp_fastopen(serv->tcpfd, &msg);
 
 	  if (errno == 0)
 	    data_sent = 1;
-	  else if (errno == ETIMEDOUT || errno == EHOSTUNREACH || errno == EINPROGRESS || errno == ECONNREFUSED)
+	  else if (errno == ETIMEDOUT || errno == EHOSTUNREACH || errno == EINPROGRESS || errno == ECONNREFUSED ||
+                   (daemon->dns_tcp_send_timeout && (errno == EAGAIN || errno == EWOULDBLOCK)))
 	    fatal = 1;
 #endif
 	  
--- a/src/option.c
+++ b/src/option.c
@@ -201,6 +201,7 @@
 #define LOPT_LEASEQUERY    389
 #define LOPT_SPLIT_RELAY   390
 #define LOPT_LOG_MALLOC    391
+#define LOPT_DNS_TCP_TIMEOUT 392
 
 #ifdef HAVE_GETOPT_LONG
 static const struct option opts[] =  
@@ -398,6 +399,7 @@
     { "quiet-tftp", 0, 0, LOPT_QUIET_TFTP },
     { "port-limit", 1, 0, LOPT_RANDPORT_LIM },
     { "fast-dns-retry", 2, 0, LOPT_FAST_RETRY },
+    { "dns-tcp-timeout-ms", 1, 0, LOPT_DNS_TCP_TIMEOUT },
     { "use-stale-cache", 2, 0 , LOPT_STALE_CACHE },
     { "no-ident", 0, 0, LOPT_NO_IDENT },
     { "max-tcp-connections", 1, 0, LOPT_MAX_PROCS },
@@ -485,6 +487,7 @@
   { LOPT_MAXCTTL, ARG_ONE, "<integer>", gettext_noop("Specify time-to-live ceiling for cache."), NULL },
   { LOPT_MINCTTL, ARG_ONE, "<integer>", gettext_noop("Specify time-to-live floor for cache."), NULL },
   { LOPT_FAST_RETRY, ARG_ONE, "<milliseconds>", gettext_noop("Retry DNS queries after this many milliseconds."), NULL},
+  { LOPT_DNS_TCP_TIMEOUT, ARG_ONE, "<send ms>,<receive ms>", gettext_noop("Bound upstream TCP DNS waits before trying another server."), NULL },
   { 'u', ARG_ONE, "<username>", gettext_noop("Change to this user after startup. (defaults to %s)."), CHUSER }, 
   { 'U', ARG_DUP, "set:<tag>,<class>", gettext_noop("Map DHCP vendor class to tag."), NULL },
   { 'v', 0, NULL, gettext_noop("Display dnsmasq version and copyright information."), NULL },
@@ -3572,6 +3575,20 @@
 	}
       break;
 
+    case LOPT_DNS_TCP_TIMEOUT:
+      {
+        u32 send_timeout, receive_timeout;
+        comma = split(arg);
+        if (!comma || !strtoul_check(arg, &send_timeout) ||
+            !strtoul_check(comma, &receive_timeout) ||
+            send_timeout < 50 || receive_timeout < 50 ||
+            send_timeout > INT_MAX || receive_timeout > INT_MAX)
+          ret_err(gen_err);
+        daemon->dns_tcp_send_timeout = send_timeout;
+        daemon->dns_tcp_receive_timeout = receive_timeout;
+      }
+      break;
+
     case LOPT_CACHE_RR: /* --cache-rr */
     case LOPT_FILTER_RR: /* --filter-rr */
     case LOPT_FILTER_A: /* --filter-A */
