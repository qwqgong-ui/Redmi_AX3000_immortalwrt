 		if (unlikely(irq >= nss_ctx->irq_count)) {
@@ -186,7 +221,7 @@
 
 		wt_stats->irq_stats[irq] = stats_notify->stats[i];
 	}
-	spin_unlock_bh(&nss_ctx->nss_top->stats_lock);
+	spin_unlock_bh(&nss_top_main.stats_lock);
 }
 
