Subject: [PATCH] ath11k: track IRQ resource stages and configure before core startup

Rollback only successfully requested IRQ actions and initialized
tasklets/NAPI. Keep managed stop state separate from temporary masks.
Complete IRQ configuration before QMI can dispatch FW-ready work.

--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -222,7 +222,7 @@
 	for (i = 0; i < ab->hw_params.ce_count; i++) {
 		struct ath11k_ce_pipe *ce_pipe = &ab->ce.ce_pipe[i];
 
-		if (ath11k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
+		if (!ce_pipe->tasklet_initialized)
 			continue;
 
 		tasklet_kill(&ce_pipe->intr_tq);
@@ -233,7 +233,7 @@
 {
 	int i;
 
-	for (i = 0; i < irq_grp->num_irq; i++)
+	for (i = 0; i < irq_grp->num_irq_requested; i++)
 		disable_irq_nosync(irq_grp->ab->irq_num[irq_grp->irqs[i]]);
 }
 
@@ -244,7 +244,10 @@
 	for (i = 0; i < ATH11K_EXT_IRQ_GRP_NUM_MAX; i++) {
