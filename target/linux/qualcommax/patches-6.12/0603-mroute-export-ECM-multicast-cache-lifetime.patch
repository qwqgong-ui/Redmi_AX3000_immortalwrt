+static void ipmr_offload_mfc_notify(struct net *net, u32 table,
+				  struct mfc_cache *c, enum fib_event_type event)
+{
+	ipmr_mfc_event_offload_callback_t cb;
+	struct mr_table *mrt;
+	u32 indices[MAXVIFS];
+	__be32 group = c->mfc_mcastgrp, origin = c->mfc_origin;
+	int count = -ENOENT;
+
+	if (!net_eq(net, &init_net) || table != RT_TABLE_DEFAULT)
+		return;
+	rcu_read_lock();
+	cb = rcu_dereference(ipmr_offload_cb);
+	if (!cb)
+		goto out;
+	if (event != FIB_EVENT_ENTRY_DEL) {
+		spin_lock_bh(&mrt_lock);
+		mrt = __ipmr_get_table(net, table);
+		if (mrt) {
+			c = ipmr_offload_cache_find(mrt, origin, group);
+			if (!IS_ERR(c))
+				count = ipmr_offload_ifindexes(mrt, c, indices, NULL);
+		}
+		spin_unlock_bh(&mrt_lock);
+	}
+	/* The legacy UPDATE ABI cannot describe a parent or TTL change. First
+	 * invalidate the previous rule on replacement, then publish the new set.
+	 */
+	if (event == FIB_EVENT_ENTRY_REPLACE || count <= 0)
+		cb(group, origin, 0, NULL, IPMR_MFC_EVENT_DELETE);
+	if (count > 0)
+		cb(group, origin, count, indices, IPMR_MFC_EVENT_UPDATE);
+out:
+	rcu_read_unlock();
+}
