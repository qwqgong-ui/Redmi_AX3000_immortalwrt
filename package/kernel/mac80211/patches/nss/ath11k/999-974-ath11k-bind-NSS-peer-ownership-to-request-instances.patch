+static void ath11k_nss_peer_state_put(struct ath11k_nss_peer_state *state)
+{
+	if (!refcount_dec_and_test(&state->refs))
+		return;
+	WARN_ON_ONCE(state->memory);
+	kfree(state);
+}
+
+static void ath11k_nss_peer_state_retire(struct ath11k_base *ab,
+				       struct ath11k_nss_peer_state *state,
+				       bool quarantine)
+{
+	struct ath11k_peer *peer = state->peer;
+
+	lockdep_assert_held(&ab->base_lock);
+	nss_wifili_forget_msg(state->create_cookie);
+	nss_wifili_forget_msg(state->delete_cookie);
+	if (peer && peer->nss.state == state) {
+		peer->nss.state = NULL;
+		peer->nss.vaddr = NULL;
+		peer->nss.paddr = 0;
+		kfree(peer->nss.nss_stats);
+		peer->nss.nss_stats = NULL;
+	}
+	state->peer = NULL;
+	list_del_init(&state->list);
+	if (quarantine)
+		nss_wifili_peer_memory_quarantine(state->memory);
+	else
+		nss_wifili_peer_memory_free(state->memory);
+	state->memory = NULL;
+	ath11k_nss_peer_state_put(state);
+}
+
+static void ath11k_nss_peer_response(void *context, struct nss_wifili_msg *msg)
+{
+	struct ath11k_base *ab = context;
+	struct ath11k_nss_peer_state *state;
+	u64 instance = msg->cm.app_data;
+	int result;
+
+	if (!ab || !instance || instance > U32_MAX ||
+	    msg->cm.response == NSS_CMN_RESPONSE_NOTIFY ||
+	    msg->cm.interface != ab->nss.if_num)
+		return;
+	spin_lock_bh(&ab->base_lock);
+	if (!ab->nss.peers_initialized)
+		goto out;
+	list_for_each_entry(state, &ab->nss.peers, list) {
+		if (state->instance != instance)
 			continue;
+		result = msg->cm.response == NSS_CMN_RESPONSE_ACK ? 0 : -EREMOTEIO;
+		/* The driver request ID already binds an immutable command. Some
+		 * ACKs carry only a header; validate identity when a body is present.
+		 */
+		if (msg->cm.len &&
+		    (msg->cm.len < sizeof(msg->msg.peermsg) ||
+		     msg->msg.peermsg.peer_id != state->peer_id ||
+		     msg->msg.peermsg.vdev_id != state->vdev_id ||
+		     !ether_addr_equal(msg->msg.peermsg.peer_mac_addr, state->addr)))
+			result = -EPROTO;
+		if (msg->cm.type == NSS_WIFILI_PEER_CREATE_MSG && !state->create_done) {
+			state->create_result = result;
+			state->create_done = true;
+			complete_all(&state->created);
+		} else if (msg->cm.type == NSS_WIFILI_PEER_DELETE_MSG &&
+			   state->delete_submitted) {
+			state->delete_result = result;
+			complete_all(&state->deleted);
+			if (!result)
+				ath11k_nss_peer_state_retire(ab, state, false);
+		}
+		break;
+	}
+out:
+	spin_unlock_bh(&ab->base_lock);
+}
+
+static int ath11k_nss_peer_submit_delete(struct ath11k_base *ab,
+				       struct ath11k_nss_peer_state *state)
+{
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+
+	lockdep_assert_held(&ab->base_lock);
+	if (ab->nss.quiescing)
+		return -ESHUTDOWN;
+	if (state->delete_submitted)
+		return 0;
+	msg = kzalloc(sizeof(*msg), GFP_ATOMIC);
+	if (!msg)
+		return -ENOMEM;
+	msg->msg.peermsg.peer_id = state->peer_id;
+	msg->msg.peermsg.vdev_id = state->vdev_id;
+	ether_addr_copy(msg->msg.peermsg.peer_mac_addr, state->addr);
+	nss_cmn_msg_init(&msg->cm, ab->nss.if_num, NSS_WIFILI_PEER_DELETE_MSG,
+			 sizeof(msg->msg.peermsg), ath11k_nss_peer_response,
+			 (void *)(uintptr_t)state->instance);
+	state->delete_submitted = true;
+	state->delete_result = -EINPROGRESS;
+	status = nss_wifili_tx_msg_tracked(ab->nss.ctx, msg, &state->delete_cookie);
+	kfree(msg);
+	if (status != NSS_TX_SUCCESS) {
+		state->delete_submitted = false;
+		state->delete_result = -EIO;
+		return -EIO;
+	}
+	return 0;
+}
+
+void ath11k_nss_peer_detach(struct ath11k *ar, struct ath11k_peer *peer)
+{
+	struct ath11k_nss_peer_state *state = peer->nss.state;
+
+	lockdep_assert_held(&ar->ab->base_lock);
+	if (state) {
+		/* A spontaneous WMI unmap must not erase firmware-owned DMA or
+		 * the independent completion that a process-context waiter uses.
+		 */
+		state->peer = NULL;
+		peer->nss.state = NULL;
+		peer->nss.vaddr = NULL;
+		peer->nss.paddr = 0;
+		ath11k_nss_peer_submit_delete(ar->ab, state);
+	}
+	kfree(peer->nss.nss_stats);
+	peer->nss.nss_stats = NULL;
+}
+
+int ath11k_nss_peer_wait_created(struct ath11k *ar, u32 vdev_id, const u8 *addr)
+{
+	struct ath11k_nss_peer_state *state;
+	struct ath11k_peer *peer;
+	int result;
+
+	if (!ar->ab->nss.enabled)
+		return 0;
+	spin_lock_bh(&ar->ab->base_lock);
+	peer = ath11k_peer_find(ar, vdev_id, addr);
+	if (!peer) {
+		result = -ENOENT;
+		goto unlock;
+	}
+	if (peer->nss.create_result) {
+		result = peer->nss.create_result;
+		goto unlock;
+	}
+	state = peer->nss.state;
+	if (!state) {
+		result = -ESHUTDOWN;
+		goto unlock;
+	}
+	refcount_inc(&state->refs);
+	spin_unlock_bh(&ar->ab->base_lock);
+	if (!wait_for_completion_timeout(&state->created,
+					msecs_to_jiffies(ATH11K_NSS_MSG_TIMEOUT_MS)))
+		result = -ETIMEDOUT;
+	else
+		result = READ_ONCE(state->create_result);
+	ath11k_nss_peer_state_put(state);
+	return result;
+unlock:
+	spin_unlock_bh(&ar->ab->base_lock);
+	return result;
+}
 
