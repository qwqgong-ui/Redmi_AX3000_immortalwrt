From: Redmi AX3000 NSS integration
Subject: [PATCH] ath11k: report the data TX rate and PPDU retries

Station dump on the relay showed "tx retries: 0" at -76 dBm, and the TX
bitrate could fall back to a legacy rate. QSDK 358 traces both to the HTT
PPDU stats path: management and non-QoS PPDUs (TID 16/17) also update
txrate, and nothing feeds a retry count. ath11k sets rates[0].idx = -1 on
host completions, so mac80211 never counts retries, and the NSS per-peer
retries counter reads zero on this firmware.

Take the TID from the completion-common TLV when no BA status follows and
skip rate and duration updates for TID 16 and above, as QSDK 358 does.
Count retries the way QSDK's offload driver (host-cmn dp_mon.c) does:
every MPDU tried but not delivered in a PPDU is retried. A delayed BA only
reports success with its BAR, so it is skipped. The firmware sends these
TLVs in both NSS and host mode, so one counter serves both. The NSS
station path reports the larger of this counter and the old NSS + mac80211
sum, so nothing is counted twice.

The QSDK 358 RSSI change (channel noise floor plus bandwidth offset) is
left out because it depends on firmware NF calibration nobody verified here.

--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -615,6 +615,7 @@
 	struct rate_info last_txrate;
 	u64 rx_duration;
 	u64 tx_duration;
+	u32 ppdu_tx_retries;
 	u8 rssi_comb;
 	struct ewma_avg_rssi avg_rssi;
 	s8 rssi_beacon;
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2126,9 +2126,11 @@
 	if (usr_stats->rate_stats_updated)
 		return;
 
-	if (usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_COMMON))
+	if (usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_COMMON)) {
 		is_ampdu =
 			HTT_USR_CMPLTN_IS_AMPDU(usr_stats->cmpltn_cmn.flags);
+		tid = usr_stats->cmpltn_cmn.tid_num;
+	}
 
 	if (usr_stats->tlv_flags &
 	    BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_ACK_BA_STATUS)) {
@@ -2139,6 +2141,12 @@
 				usr_stats->ack_ba.info);
 	}
 
+	/* Management and non-QoS data go out at basic rates and would
+	 * replace the data rate reported to station dump.
+	 */
+	if (tid >= HTT_PPDU_STATS_NON_QOS_TID)
+		return;
+
 	if (common->fes_duration_us)
 		tx_duration = common->fes_duration_us;
 
@@ -2236,6 +2244,15 @@
 	arsta->tx_duration += tx_duration;
 	memcpy(&arsta->last_txrate, &arsta->txrate, sizeof(struct rate_info));
 
+	/* Every MPDU the PPDU did not deliver is retried, as in QSDK's
+	 * offload accounting. A delayed BA reports success only with its BAR.
+	 */
+	if ((usr_stats->tlv_flags & BIT(HTT_PPDU_STATS_TAG_USR_COMPLTN_COMMON)) &&
+	    !usr_stats->delay_ba &&
+	    usr_stats->cmpltn_cmn.mpdu_tried > usr_stats->cmpltn_cmn.mpdu_success)
+		arsta->ppdu_tx_retries += usr_stats->cmpltn_cmn.mpdu_tried -
+					  usr_stats->cmpltn_cmn.mpdu_success;
+
 	/* PPDU stats reported for mgmt packet doesn't have valid tx bytes.
 	 * So skip peer stats update for mgmt packets.
 	 */
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -10354,6 +10354,11 @@
 
 	sinfo->signal_avg = ewma_avg_rssi_read(&arsta->avg_rssi);
 
+	if (arsta->ppdu_tx_retries) {
+		sinfo->tx_retries = arsta->ppdu_tx_retries;
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_RETRIES);
+	}
+
 	if (!db2dbm)
 		sinfo->signal_avg += ATH11K_DEFAULT_NOISE_FLOOR;
 
--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -4927,8 +4927,10 @@
 		peer->nss.nss_stats->tx_failed;
 	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_FAILED);
 
-	sinfo->tx_retries = stainfo->deflink.status_stats.retry_count +
-		peer->nss.nss_stats->tx_retries;
+	/* Firmware PPDU completions cover NSS and host frames alike. */
+	sinfo->tx_retries = max_t(u32, ath11k_sta_to_arsta(sta)->ppdu_tx_retries,
+				  stainfo->deflink.status_stats.retry_count +
+				  peer->nss.nss_stats->tx_retries);
 	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_RETRIES);
 
 	sinfo->rx_packets = stainfo->deflink.rx_stats.packets +
