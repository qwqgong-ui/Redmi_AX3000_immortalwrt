Subject: [PATCH] nss: validate and acknowledge worker statistics control

--- a/nss_control.h
+++ b/nss_control.h
@@ -5,6 +5,7 @@
 enum nss_control_family {
 	NSS_CONTROL_DYNAMIC,
 	NSS_CONTROL_WIFI_VDEV,
+	NSS_CONTROL_PROJECT,
 	NSS_CONTROL_FAMILY_MAX,
 };
 
--- a/exports/nss_project.h
+++ b/exports/nss_project.h
@@ -37,6 +37,18 @@
   */
 #define NSS_PROJECT_IRQS_PER_MESSAGE 32
 
+/* UBI32 has 12 contexts and a 128-entry IRQ number space. The MP12.2
+ * PROJECT ACK reports these bounds; active callbacks occupy fewer slots.
+ */
+#define NSS_PROJECT_MAX_WORKER_THREADS 12
+#define NSS_PROJECT_MAX_IRQS 128
+
+static inline bool nss_project_wt_counts_valid(uint32_t threads, uint32_t irqs)
+{
+	return threads && threads <= NSS_PROJECT_MAX_WORKER_THREADS &&
+	       irqs && irqs <= NSS_PROJECT_MAX_IRQS;
+}
+
 /**
  *  Maximum possible value of priority after classification
  *  at an ingress interface.
--- a/nss_project.c
+++ b/nss_project.c
@@ -22,8 +22,23 @@
  *	NSS project APIs.
  */
 #include "nss_tx_rx_common.h"
+#include "nss_control.h"
 
 static int nss_project_wt_stats_enable;
+static int nss_project_wt_state[NSS_CORE_MAX];
+static DEFINE_MUTEX(nss_project_wt_mutex);
+static int nss_project_zero;
+static int nss_project_one = 1;
+
+struct nss_project_wt_request {
+	struct completion complete;
+	bool enable;
+	int result;
+	uint32_t threads;
+	uint32_t irqs;
+};
+
+#define NSS_PROJECT_WT_TIMEOUT 1000
 static uint8_t nss_project_pri_mq_map[NSS_PROJECT_PRI_MQ_MAP_MAX_SIZE] = {0, 1, 2, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3};
 module_param_array(nss_project_pri_mq_map, byte, NULL, 0);
 MODULE_PARM_DESC(nss_project_pri_mq_map, "Priority to multi-queue mapping");
@@ -55,14 +70,17 @@
 	struct nss_worker_thread_stats *wt_stats;
 	int i;
 
